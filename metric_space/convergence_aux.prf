    (/ CONST-DECL "[[numfield, nznum] -> numfield]" |number_fields| NIL)
    (|nznum| NONEMPTY-TYPE-EQ-DECL NIL |number_fields| NIL)
    (> CONST-DECL "[[real, real] -> bool]" |reals| NIL))
   SHOSTAK)))

