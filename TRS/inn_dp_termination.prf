     "[E: set[rewrite_rule[variable, symbol, arity]] -> [[[dep_pair[variable, symbol, arity](E), Sub[variable, symbol, arity]], [dep_pair[variable, symbol, arity](E), Sub[variable, symbol, arity]]] -> bool]]"
     |inn_dp_termination| NIL)
    (|noetherian?| CONST-DECL "[PRED[[T, T]] -> bool]" |noetherian| NIL))
   NIL)))

