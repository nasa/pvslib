    (|length| CONST-DECL "[r2v -> nat]" |r2v_def| NIL)
    (|deriv| DEF-DECL "[f: (derivable?) -> {ff: r2v | length(ff) = length(f)}]"
     |r2v_analysis| NIL)
    (|restrict| CONST-DECL "[[T -> R] -> [S -> R]]" |restrict| NIL)
    (|r2v_n| TYPE-EQ-DECL NIL |r2v_def| NIL)
    (|listn_0| NAME-JUDGEMENT "listn[real](0)" |vector_arithmetic| |matrices|))
   SHOSTAK)))

