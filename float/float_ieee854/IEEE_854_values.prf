    (|mod_of_mod| FORMULA-DECL NIL |mod| NIL)
    (|expt_x0| FORMULA-DECL NIL |exponentiation| NIL)
    (|posrat_times_posrat_is_posrat| APPLICATION-JUDGEMENT "posrat" |rationals|
     NIL)
