ieee754_arrays
[ (importing ieee754_format_parameters)
  b    : ieee754_radix,
  p    : ieee754_precision(b),
  emax : ieee754_maxExp(b,p) ]
: theory begin

  importing ieee754_semantics[b,p,emax] AS sem_th

  importing structures@abstract_array[datum] as fparray_th

  ieee754_array: type = fparray_th.aarray
  fparray(n: nat): type = fparray_th.flarray(n)

  finite_array?(a: ieee754_array): bool
  = ∀(i: below(len(a))): finite?(at(a,i))

  importing structures@real_array_props

  % projection
  proj_array(a: (finite_array?)): rarray(len(a))
  = makeaa(len(a), λ(i: below(len(a))): proj(at(a,i)))

  % TODO should we  move this definition to an ulp-array focused theory?
  ulp_array(a: real_array): nonneg_real
  = let ulp_array: real_array =  makeaa(len(a), λ(i: below(len(a))): ulp(at(a,i)))
    in max(ulp_array)

end ieee754_arrays
