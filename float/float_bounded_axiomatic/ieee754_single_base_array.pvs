ieee754_single_base_array: theory
begin

  IMPORTING ieee754_single_base
  IMPORTING ieee754_arrays[ieee754_single_radix, ieee754_single_precision, ieee754_single_maxExp]

  % Type definition with single base instantiated
  array32 : TYPE = ieee754_arrays.ieee754_array
  fparray32(n:nat) : TYPE = ieee754_arrays.fparray(n)

  %
  % Operations
  %

  importing ieee754_arrays_add[ieee754_single_radix, ieee754_single_precision, ieee754_single_maxExp]
  %
  adda_single(n:nat): [[fparray32(n),fparray32(n)] -> fparray32(n)] = arrays_add_ieee754(n)

  importing ieee754_arrays_sub[ieee754_single_radix, ieee754_single_precision, ieee754_single_maxExp]
  %
  suba_single(n:nat): [[fparray32(n),fparray32(n)] -> fparray32(n)] = arrays_sub_ieee754(n)

  importing ieee754_arrays_dot[ieee754_single_radix, ieee754_single_precision, ieee754_single_maxExp]
  %
  dot_single(n:nat): [[fparray32(n),fparray32(n)] -> binary32] = arrays_dot_ieee754(n)

  importing ieee754_arrays_dot_fma[ieee754_single_radix, ieee754_single_precision, ieee754_single_maxExp]
  %
  dotfma_single(n:nat): [[fparray32(n),fparray32(n)] -> binary32] = arrays_dot_ieee754_fma(n)

  % need finite and proj
  finite_array?_single: MACRO [ array32 -> bool ] = finite_array?
  SAtoRA(x: (finite_array?_single)) : MACRO rarray(len(x)) = proj_array(x)

  ulp_sp_array(a: real_array): macro nonneg_real = ulp_array(a)

end ieee754_single_base_array
