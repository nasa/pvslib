aerr_ulp_arrays_abs
[ (IMPORTING ieee754_format_parameters)
  b    : ieee754_radix,
  p    : ieee754_precision(b),
  emax : ieee754_maxExp(b,p) ]
: THEORY BEGIN

  IMPORTING ieee754_arrays_abs[b,p,emax] AS abs_th
  IMPORTING aerr_ulp_abs[b,p,emax]

  aerr_ulp_arrays_abs(n: nat)(r: rarray(n), e1: nnreal): nnreal =
    max(makeaa(n, LAMBDA(i: below(n)): aerr_ulp_abs(at(r, i), e1)))

  array_abs(n: nat)(r: rarray(n)): rarray(n) =
    makeaa(n, LAMBDA(i: below(n)): abs(at(r, i)))

  IMPORTING aerr_ulp_arrays_unary_broadcast[b,p,emax, abs_ieee754, abs, aerr_ulp_abs, array_abs]

  aerr_ulp_arrays_abs_correct: THEOREM
    FORALL(n: nat, f: fparray(n), r: rarray(n), e1: nnreal):
      finite_array?(f) AND
      l_inf_norm(proj_array(f) - r) <= e1 AND
      finite_array?(ieee754_arrays_abs(n)(f))
      IMPLIES l_inf_norm(proj_array(ieee754_arrays_abs(n)(f)) - array_abs(n)(r)) <=
              aerr_ulp_arrays_abs(n)(r, e1)

END aerr_ulp_arrays_abs
