ieee754_arrays_broadcast
[ (importing ieee754_format_parameters,ieee754_semantics)
  b    : ieee754_radix,
  p    : ieee754_precision(b),
  emax : ieee754_maxExp(b,p),
  biOp   : [datum[b,p,emax],datum[b,p,emax]->datum[b,p,emax]]  
]
: THEORY
BEGIN

  IMPORTING ieee754_arrays[b,p,emax]

  % If you want explicit types, uncomment and adjust:
  % fpT: TYPE = fp(b,p,emax)   % or fpreal(b,p,emax), whatever your libs export

  % Array ⊙ Array (pointwise)
  arrays_op_ieee754(n: nat)(A, B: fparray(n)): fparray(n) =
    makeaa(n, LAMBDA (i: below(n)): biOp(at(A, i), at(B, i)))

  % Scalar ⊙ Array (left broadcast)
  left_broadcast(n: nat)(x : datum, B: fparray(n)): fparray(n) =
    makeaa(n, LAMBDA (i: below(n)): biOp(x, at(B, i)))

  % Array ⊙ Scalar (right broadcast)
  right_broadcast(n: nat)(A: fparray(n), y: datum): fparray(n) =
    makeaa(n, LAMBDA (i: below(n)): biOp(at(A, i), y))

END ieee754_arrays_broadcast
