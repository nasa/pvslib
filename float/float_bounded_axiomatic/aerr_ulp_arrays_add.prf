    (|ieee754_precision| NONEMPTY-TYPE-EQ-DECL NIL |ieee754_format_parameters|
     NIL)
    (|p| FORMAL-CONST-DECL "ieee754_precision(b)" |aerr_ulp_arrays_add| NIL)
    (|nat| NONEMPTY-TYPE-EQ-DECL NIL |naturalnumbers| NIL)
    (|ieee754_maxExp| NONEMPTY-TYPE-EQ-DECL NIL |ieee754_format_parameters|
     NIL)
    (|emax| FORMAL-CONST-DECL "ieee754_maxExp(b, p)" |aerr_ulp_arrays_add| NIL)
    (|datum| NONEMPTY-TYPE-DECL NIL |ieee754_data| NIL)
    (|add_ieee754| CONST-DECL "[datum, datum -> datum]" |ieee754_add| NIL)
    (|numfield| NONEMPTY-TYPE-EQ-DECL NIL |number_fields| NIL)
    (|restrict| CONST-DECL "R" |restrict| NIL)
    (+ CONST-DECL "[numfield, numfield -> numfield]" |number_fields| NIL)
    (|nnreal| TYPE-EQ-DECL NIL |real_types| NIL)
    (|aerr_ulp_add| CONST-DECL "nnreal" |aerr_ulp_add| NIL)
    (|below| TYPE-EQ-DECL NIL |nat_types| NIL)
    (|aarray| TYPE-EQ-DECL NIL |abstract_array| |structures|)
    (|rarray| TYPE-EQ-DECL NIL |real_array| |structures|)
    (|real_array| TYPE-EQ-DECL NIL |real_array| |structures|)
    (+ CONST-DECL "rarray(length(a))" |real_array| |structures|))
   SHOSTAK)))

