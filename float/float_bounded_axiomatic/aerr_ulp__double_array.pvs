aerr_ulp__double_array: theory
begin

  importing aerr_ulp__double

  importing aerr_ulp_arrays_add[ieee754_double_radix,ieee754_double_precision,ieee754_double_maxExp]
  %
  aerr_ulp_dpa_add(n: nat)(r1:rarray(n),e1:nnreal,r2:rarray(n),e2:nnreal)
  : nnreal
  = aerr_ulp_arrays_add(n)(r1,e1,r2,e2)
  
  importing aerr_ulp_arrays_sub[ieee754_double_radix,ieee754_double_precision,ieee754_double_maxExp]
  %
  aerr_ulp_dpa_sub(n: nat)(r1:rarray(n),e1:nnreal,r2:rarray(n),e2:nnreal)
  : nnreal
  = aerr_ulp_arrays_sub(n)(r1,e1,r2,e2)

  importing aerr_ulp_arrays_div[ieee754_double_radix,ieee754_double_precision,ieee754_double_maxExp]
  %
  aerr_ulp_dpa_div(n: nat)(r1:rarray(n),e1:nnreal,r2:rarray(n),e2:nnreal | FORALL (i: below(n)): (0 < at(r2,i) - e2 OR at(r2,i) + e2 < 0))
  : nnreal
  = aerr_ulp_arrays_div(n)(r1,e1,r2,e2)

  importing aerr_ulp_arrays_dot[ieee754_double_radix,ieee754_double_precision,ieee754_double_maxExp]
  %
  aerr_ulp_dpa_dot(n: nat)(r1:rarray(n),e1:nnreal,r2:rarray(n),e2:nnreal)
  : nnreal
  = aerr_ulp_arrays_dot(n)(r1,e1,r2,e2)
  
  importing aerr_ulp_arrays_dot_fma[ieee754_double_radix,ieee754_double_precision,ieee754_double_maxExp]
  %
  aerr_ulp_dpa_dot_fma(n: nat)(r1:rarray(n),e1:nnreal,r2:rarray(n),e2:nnreal)
  : nnreal
  = aerr_ulp_arrays_dot_fma(n)(r1,e1,r2,e2)
  

end aerr_ulp__double_array
