aerr_ulp_arrays_atan
[ (IMPORTING ieee754_format_parameters)
  b    : ieee754_radix,
  p    : ieee754_precision(b),
  emax : ieee754_maxExp(b,p) ]
: THEORY BEGIN

  IMPORTING ieee754_arrays_atan[b,p,emax] AS atan_th
  IMPORTING aerr_ulp_atan[b,p,emax]

  aerr_ulp_arrays_atan(n: nat)(r: rarray(n), e1: nnreal): nnreal =
    max(makeaa(n, LAMBDA(i: below(n)): aerr_ulp_atan(at(r, i), e1)))

  array_atan(n: nat)(r: rarray(n)): rarray(n) =
    makeaa(n, LAMBDA(i: below(n)): atan(at(r, i)))

  IMPORTING aerr_ulp_arrays_unary_broadcast[b,p,emax, atan_ieee754, atan, aerr_ulp_atan, array_atan]

  aerr_ulp_arrays_atan_correct: THEOREM
    FORALL(n: nat, f: fparray(n), r: rarray(n), e1: nnreal):
      finite_array?(f) AND
      l_inf_norm(proj_array(f) - r) <= e1 AND
      finite_array?(ieee754_arrays_atan(n)(f))
      IMPLIES l_inf_norm(proj_array(ieee754_arrays_atan(n)(f)) - array_atan(n)(r)) <=
              aerr_ulp_arrays_atan(n)(r, e1)

END aerr_ulp_arrays_atan
