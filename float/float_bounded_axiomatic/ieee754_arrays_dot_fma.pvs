ieee754_arrays_dot_fma  % [ parameters ]
[ (IMPORTING ieee754_format_parameters)
  b    : ieee754_radix,
  p    : ieee754_precision(b),
  emax : ieee754_maxExp(b,p) ]
: theory begin

  % Array and IEEE-754 scalar dot product using fused multiply-add
  importing ieee754_arrays[b,p,emax]
  importing ieee754_fma[b,p,emax]
  % provides fma_ieee754
  % pZero is the zero constant from ieee754 semanticsewg FMA:
  % Accumulates sum_{k=i}^{n-1} (A[k] * B[k]) with a single rounding per step.
  
  dot_from_fma(n: nat, A, B: fparray(n), i: below(n)) : recursive datum =
    if i + 1 < n then
      fma_ieee754(at(A, i), at(B, i), dot_from_fma(n, A, B, i + 1))
    else
      fma_ieee754(at(A, i), at(B, i), pZero)
    endif
  measure n - i

  % finite property
  dot_from_fma_finite: LEMMA
  FORALL(n:nat, A,B :fparray(n), i:below(n)):
  (i + 1 < n  AND
  finite?(dot_from_fma(n, A, B, i)))
  IMPLIES
  finite?(dot_from_fma(n, A, B, i+1))


  arrays_dot_ieee754_fma(n: nat)(A, B: fparray(n)) : datum =
    if n = 0 then pZero else dot_from_fma(n, A, B, 0) endif


  END ieee754_arrays_dot_fma
