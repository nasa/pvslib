aerr_ulp_arrays_sub
[ (IMPORTING ieee754_format_parameters)
  b    : ieee754_radix,
  p    : ieee754_precision(b),
  emax : ieee754_maxExp(b,p) ]
: theory begin

  importing ieee754_arrays_sub[b,p,emax] AS sub_th
  importing aerr_ulp_sub[b,p,emax]

  aerr_ulp_arrays_sub(n: nat)(r1:rarray(n),e1:nnreal,r2:rarray(n),e2:nnreal) : nnreal
  = max(makeaa(n, λ(i:below(n)): aerr_ulp_sub(at(r1,i),e1,at(r2,i),e2)))

  importing aerr_ulp_arrays_broadcast[b,p,emax, sub_ieee754, -, aerr_ulp_sub, LAMBDA(n:nat): LAMBDA(r1,r2: rarray(n)): r1 - r2] AS broadcast_sub_th

  aerr_ulp_arrays_sub_correct
  : theorem forall(n: nat, f1,f2: fparray(n), r1,r2: rarray(n), e1,e2: nnreal)
    : finite_array?(f1) ∧ finite_array?(f2) ∧
      l_inf_norm(proj_array(f1) - r1) <= e1 ∧
      l_inf_norm(proj_array(f2) - r2) <= e2 ∧
      finite_array?(arrays_sub_ieee754(n)(f1,f2))
      IMPLIES l_inf_norm(proj_array(arrays_sub_ieee754(n)(f1,f2)) - (r1 - r2)) <= aerr_ulp_arrays_sub(n)(r1,e1,r2,e2)


end aerr_ulp_arrays_sub
