ieee754_arrays_div
[ (importing ieee754_format_parameters)
  b    : ieee754_radix,
  p    : ieee754_precision(b),
  emax : ieee754_maxExp(b,p) ]
: theory begin

  importing ieee754_arrays[b,p,emax]
  importing ieee754_div[b,p,emax]

  arrays_div_ieee754(n: nat)(A,B: fparray(n)): fparray(n)
  = makeaa(n, λ(i: below(n)): div_ieee754(at(A,i), at(B,i)))

end ieee754_arrays_div
