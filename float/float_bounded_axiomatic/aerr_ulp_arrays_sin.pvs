aerr_ulp_arrays_sin
[ (IMPORTING ieee754_format_parameters)
  b    : ieee754_radix,
  p    : ieee754_precision(b),
  emax : ieee754_maxExp(b,p) ]
: THEORY BEGIN

  IMPORTING ieee754_arrays_sin[b,p,emax] AS sin_th
  IMPORTING aerr_ulp_sin[b,p,emax]

  aerr_ulp_arrays_sin(n: nat)(r: rarray(n), e1: nnreal): nnreal =
    max(makeaa(n, LAMBDA(i: below(n)): aerr_ulp_sin(at(r, i), e1)))

  array_sin(n: nat)(r: rarray(n)): rarray(n) =
    makeaa(n, LAMBDA(i: below(n)): sin(at(r, i)))

  IMPORTING aerr_ulp_arrays_unary_broadcast[b,p,emax, sin_ieee754, sin, aerr_ulp_sin, array_sin]

  aerr_ulp_arrays_sin_correct: THEOREM
    FORALL(n: nat, f: fparray(n), r: rarray(n), e1: nnreal):
      finite_array?(f) AND
      l_inf_norm(proj_array(f) - r) <= e1 AND
      finite_array?(ieee754_arrays_sin(n)(f))
      IMPLIES l_inf_norm(proj_array(ieee754_arrays_sin(n)(f)) - array_sin(n)(r)) <=
              aerr_ulp_arrays_sin(n)(r, e1)

END aerr_ulp_arrays_sin
