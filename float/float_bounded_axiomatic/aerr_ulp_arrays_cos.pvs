aerr_ulp_arrays_cos
[ (IMPORTING ieee754_format_parameters)
  b    : ieee754_radix,
  p    : ieee754_precision(b),
  emax : ieee754_maxExp(b,p) ]
: THEORY BEGIN

  IMPORTING ieee754_arrays_cos[b,p,emax] AS cos_th
  IMPORTING aerr_ulp_cos[b,p,emax]

  aerr_ulp_arrays_cos(n: nat)(r: rarray(n), e1: nnreal): nnreal =
    max(makeaa(n, LAMBDA(i: below(n)): aerr_ulp_cos(at(r, i), e1)))

  array_cos(n: nat)(r: rarray(n)): rarray(n) =
    makeaa(n, LAMBDA(i: below(n)): cos(at(r, i)))

  IMPORTING aerr_ulp_arrays_unary_broadcast[b,p,emax, cos_ieee754, cos, aerr_ulp_cos, array_cos]

  aerr_ulp_arrays_cos_correct: THEOREM
    FORALL(n: nat, f: fparray(n), r: rarray(n), e1: nnreal):
      finite_array?(f) AND
      l_inf_norm(proj_array(f) - r) <= e1 AND
      finite_array?(ieee754_arrays_cos(n)(f))
      IMPLIES l_inf_norm(proj_array(ieee754_arrays_cos(n)(f)) - array_cos(n)(r)) <=
              aerr_ulp_arrays_cos(n)(r, e1)

END aerr_ulp_arrays_cos
