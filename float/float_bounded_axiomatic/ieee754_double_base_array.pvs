ieee754_double_base_array: theory
begin

  IMPORTING ieee754_double_base
  IMPORTING ieee754_arrays[ieee754_double_radix, ieee754_double_precision, ieee754_double_maxExp]

  % Type definition with double base instantiated
  array64 : TYPE =  ieee754_arrays.ieee754_array
  fparray64(n:nat) : TYPE = ieee754_arrays.fparray(n)

  %
  % Operations
  %

  importing ieee754_arrays_add[ieee754_double_base.ieee754_double_radix, ieee754_double_base.ieee754_double_precision,  ieee754_double_base.ieee754_double_maxExp]
  %
  adda_double(n:nat): [[fparray64(n),fparray64(n)] -> fparray64(n)] = arrays_add_ieee754(n)
  
  importing ieee754_arrays_sub[ieee754_double_base.ieee754_double_radix, ieee754_double_base.ieee754_double_precision,  ieee754_double_base.ieee754_double_maxExp]
  %
  suba_double(n:nat): [[fparray64(n),fparray64(n)] -> fparray64(n)] = arrays_sub_ieee754(n)
  
  importing ieee754_arrays_dot[ieee754_double_base.ieee754_double_radix, ieee754_double_base.ieee754_double_precision,  ieee754_double_base.ieee754_double_maxExp]
  %
  dot_double(n:nat): [[fparray64(n),fparray64(n)] -> binary64] = arrays_dot_ieee754(n)
  
  importing ieee754_arrays_dot_fma[ieee754_double_base.ieee754_double_radix, ieee754_double_base.ieee754_double_precision,  ieee754_double_base.ieee754_double_maxExp]
  %
  dotfma_double(n:nat): [[fparray64(n),fparray64(n)] ->binary64] = arrays_dot_ieee754_fma(n)

  % need finite and proj
  finite_array?_double: MACRO [ array64 -> bool ] = finite_array?
  DAtoRA(x: (finite_array?_double)) : MACRO  rarray(len(x))  = proj_array(x)

  ulp_dp_array(a: real_array): macro nonneg_real = ulp_array(a)

end ieee754_double_base_array
