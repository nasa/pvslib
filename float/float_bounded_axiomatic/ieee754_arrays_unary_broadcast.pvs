ieee754_arrays_unary_broadcast 
[ (importing ieee754_format_parameters, ieee754_semantics)
  b    : ieee754_radix,
  p    : ieee754_precision(b),
  emax : ieee754_maxExp(b,p),
  unOp : [datum[b,p,emax] -> datum[b,p,emax]]
]
: THEORY
BEGIN

  IMPORTING ieee754_arrays[b,p,emax]

  % Apply unary operation to each element of the array
  arrays_unary_op_ieee754(n: nat)(A: fparray(n)): fparray(n) =
    makeaa(n, LAMBDA (i: below(n)): unOp(at(A, i)))


  END ieee754_arrays_unary_broadcast
