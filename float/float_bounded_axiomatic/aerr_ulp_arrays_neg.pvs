aerr_ulp_arrays_neg
[ (IMPORTING ieee754_format_parameters)
  b    : ieee754_radix,
  p    : ieee754_precision(b),
  emax : ieee754_maxExp(b,p) ]
: THEORY BEGIN

  IMPORTING ieee754_arrays_neg[b,p,emax] AS neg_th
  IMPORTING aerr_ulp_neg[b,p,emax]

  aerr_ulp_arrays_neg(n: nat)(r: rarray(n), e1: nnreal): nnreal =
    max(makeaa(n, LAMBDA(i: below(n)): aerr_ulp_neg(at(r, i), e1)))

  array_neg(n: nat)(r: rarray(n)): rarray(n) =
    makeaa(n, LAMBDA(i: below(n)): -(at(r, i)))

  IMPORTING aerr_ulp_arrays_unary_broadcast[b,p,emax, neg_ieee754, neg, aerr_ulp_neg, array_neg]

  aerr_ulp_arrays_neg_correct: THEOREM
    FORALL(n: nat, f: fparray(n), r: rarray(n), e1: nnreal):
      finite_array?(f) AND
      l_inf_norm(proj_array(f) - r) <= e1 AND
      finite_array?(ieee754_arrays_neg(n)(f))
      IMPLIES l_inf_norm(proj_array(ieee754_arrays_neg(n)(f)) - array_neg(n)(r)) <=
              aerr_ulp_arrays_neg(n)(r, e1)

END aerr_ulp_arrays_neg
