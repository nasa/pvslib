aerr_ulp_arrays_exp
[ (IMPORTING ieee754_format_parameters)
  b    : ieee754_radix,
  p    : ieee754_precision(b),
  emax : ieee754_maxExp(b,p) ]
: THEORY BEGIN

  IMPORTING ieee754_arrays_exp[b,p,emax] AS exp_th
  IMPORTING aerr_ulp_exp[b,p,emax]

  aerr_ulp_arrays_exp(n: nat)(r: rarray(n), e1: nnreal): nnreal =
    max(makeaa(n, LAMBDA(i: below(n)): aerr_ulp_exp(at(r, i), e1)))

  array_exp(n: nat)(r: rarray(n)): rarray(n) =
    makeaa(n, LAMBDA(i: below(n)): exp(at(r, i)))

  IMPORTING aerr_ulp_arrays_unary_broadcast[b,p,emax, exp_ieee754, exp, aerr_ulp_exp, array_exp]

  aerr_ulp_arrays_exp_correct: THEOREM
    FORALL(n: nat, f: fparray(n), r: rarray(n), e1: nnreal):
      finite_array?(f) AND
      l_inf_norm(proj_array(f) - r) <= e1 AND
      finite_array?(ieee754_arrays_exp(n)(f))
      IMPLIES l_inf_norm(proj_array(ieee754_arrays_exp(n)(f)) - array_exp(n)(r)) <=
              aerr_ulp_arrays_exp(n)(r, e1)

END aerr_ulp_arrays_exp
