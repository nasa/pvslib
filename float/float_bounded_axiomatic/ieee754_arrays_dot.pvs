ieee754_arrays_dot
[ (IMPORTING ieee754_format_parameters)
  b    : ieee754_radix,
  p    : ieee754_precision(b),
  emax : ieee754_maxExp(b,p) ]
: theory begin

  % Array and IEEE-754 scalar dot product support
  importing ieee754_arrays[b,p,emax]
  importing ieee754_add[b,p,emax]  % provides add_ieee754
  importing ieee754_mul[b,p,emax]  % provides mul_ieee754
  % If your environment names the zero differently, adjust the reference below.
  % Some libraries export zero_ieee754 or fp_zero from the add/mul module or a base module.

  % Dot from 
  dot_from(n: nat, A, B: fparray(n), i: below(n)) : recursive datum =
    IF i + 1 < n THEN
      add_ieee754(
        mul_ieee754(at(A, i), at(B, i)),
        dot_from(n, A, B, i + 1)
      )
    ELSE
      mul_ieee754(at(A, i), at(B, i))
    ENDIF
  MEASURE n - i

  % finite property
  dot_from_finite: LEMMA
  FORALL(n:nat, A,B :fparray(n), i:below(n)):
  (i + 1 < n  AND
  finite?(dot_from(n, A, B, i)))
  IMPLIES
  finite?(dot_from(n, A, B, i+1))

  dot_from_finite_i: LEMMA
  FORALL(n:nat, A,B :fparray(n), i:below(n)):
  finite?(dot_from(n, A, B, i))
  IMPLIES
  finite?(mul_ieee754(at(A, i), at(B, i)))

  dot_from_finite_ith: LEMMA
  FORALL(n:nat, A,B :fparray(n), i:below(n)):
  finite?(dot_from(n, A, B, i))
  IMPLIES
  FORALL(j:below(n) | i <= j):
  finite?(mul_ieee754(at(A, j), at(B, j)))


  % Full dot product
  arrays_dot_ieee754(n: nat)(A, B: fparray(n)) : datum =
    IF n = 0 THEN pZero ELSE dot_from(n, A, B, 0) ENDIF

  dot_finite_ith: LEMMA
  FORALL(n:nat, A,B :fparray(n)):
    finite?(arrays_dot_ieee754(n)(A, B))
    IMPLIES
    FORALL(i:below(n)):
    finite?(mul_ieee754(at(A, i), at(B, i)))
    


  
end ieee754_arrays_dot
