aerr_ulp__single: THEORY
BEGIN

  r1, r2, r3: VAR real
  e1, e2, e3: VAR nnreal

  IMPORTING ieee754_single

  IMPORTING aerr_ulp_abs[ieee754_single_radix,ieee754_single_precision,ieee754_single_maxExp] as aerr_ulp_sp_abs_th
  aerr_ulp_sp_abs(r1,e1): nnreal = aerr_ulp_abs(r1,e1)

  IMPORTING aerr_ulp_neg[ieee754_single_radix,ieee754_single_precision,ieee754_single_maxExp] as aerr_ulp_sp_neg_th
  aerr_ulp_sp_neg(r1,e1): nnreal = aerr_ulp_neg(r1,e1)

  IMPORTING aerr_ulp_add[ieee754_single_radix,ieee754_single_precision,ieee754_single_maxExp] as aerr_ulp_sp_add_th
  aerr_ulp_sp_add(r1,e1,r2,e2): nnreal = aerr_ulp_add(r1,e1,r2,e2)

  IMPORTING aerr_ulp_sub[ieee754_single_radix,ieee754_single_precision,ieee754_single_maxExp] as aerr_ulp_sp_sub_th
  aerr_ulp_sp_sub(r1,e1,r2,e2): nnreal = aerr_ulp_sub(r1,e1,r2,e2)

  IMPORTING aerr_ulp_div[ieee754_single_radix,ieee754_single_precision,ieee754_single_maxExp] as aerr_ulp_sp_div_th
  aerr_ulp_sp_div(r1:real,e1:nnreal,r2:real,e2:nnreal|(0<r2-e2 OR e2+r2<0)): nnreal
  = aerr_ulp_div(r1,e1,r2,e2)

  IMPORTING aerr_ulp_mul[ieee754_single_radix,ieee754_single_precision,ieee754_single_maxExp] as aerr_ulp_sp_mul_th
  aerr_ulp_sp_mul(r1,e1,r2,e2): nnreal = aerr_ulp_mul(r1,e1,r2,e2)

  IMPORTING aerr_ulp_fma[ieee754_single_radix,ieee754_single_precision,ieee754_single_maxExp] as aerr_ulp_dp_fma_th
  aerr_ulp_dp_fma(r1,e1,r2,e2,r3,e3): nnreal = aerr_ulp_fma(r1,e1,r2,e2,r3,e3)

  IMPORTING aerr_ulp_sqt[ieee754_single_radix,ieee754_single_precision,ieee754_single_maxExp] as aerr_ulp_sp_sqt_th
  aerr_ulp_sp_sqt(r1:nnreal,e1|e1+r1>=0): nnreal = aerr_ulp_sqt(r1,e1)

  IMPORTING aerr_ulp_cos[ieee754_single_radix,ieee754_single_precision,ieee754_single_maxExp] as aerr_ulp_sp_cos_th
  aerr_ulp_sp_cos(r1,e1): nnreal = aerr_ulp_cos(r1,e1)

  IMPORTING aerr_ulp_sin[ieee754_single_radix,ieee754_single_precision,ieee754_single_maxExp] as aerr_ulp_sp_sin_th
  aerr_ulp_sp_sin(r1,e1): nnreal = aerr_ulp_sin(r1,e1)

  IMPORTING aerr_ulp_exp[ieee754_single_radix,ieee754_single_precision,ieee754_single_maxExp] as aerr_ulp_sp_exp_th
  aerr_ulp_sp_exp(r1,e1): nnreal = aerr_ulp_exp(r1,e1)

  IMPORTING aerr_ulp_ln[ieee754_single_radix,ieee754_single_precision,ieee754_single_maxExp] as aerr_ulp_sp_ln_th
  aerr_ulp_sp_ln(r1: posreal,e1| e1 < r1): nnreal = aerr_ulp_ln(r1,e1)

  IMPORTING aerr_ulp_atan[ieee754_single_radix,ieee754_single_precision,ieee754_single_maxExp] as aerr_ulp_sp_atan_th
  aerr_ulp_sp_atan(r1,e1): nnreal = aerr_ulp_atan(r1,e1)

  IMPORTING aerr_ulp_floor[ieee754_single_radix,ieee754_single_precision,ieee754_single_maxExp] as aerr_ulp_sp_floor_th
  aerr_ulp_sp_floor(r1,e1): nnreal = aerr_ulp_floor(r1,e1)

END aerr_ulp__single
