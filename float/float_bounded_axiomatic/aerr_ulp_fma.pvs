aerr_ulp_fma 
[ (IMPORTING ieee754_format_parameters)
  b    : ieee754_radix,
  p    : ieee754_precision(b),
  emax : ieee754_maxExp(b,p) ]
: THEORY BEGIN
%%% check bound please 
  IMPORTING ieee754_fma[b,p,emax] AS fma_th

  % Error bound (nnreal) for a single-rounding FMA: round( (r1* r2) + r3 ).
  % Matches the pattern used in aerr_ulp_add and aerr_ulp_mul.
  aerr_ulp_fma(r1: real, e1: nnreal,
               r2: real, e2: nnreal,
               r3: real, e3: nnreal) : nnreal
  = abs(r1)*e2 + abs(r2)*e1 + e1*e2 + e3
    + ulp( abs(r1*r2 + r3)
           + abs(r1)*e2 + abs(r2)*e1 + e1*e2 + e3 ) / 2

  % Correctness axiom: if the inputs are finite and each proj(fi) is within ei of ri,
  % and the fused result is finite, then the proj of the fused result is within
  % the bound above of the ideal real expression r1*r2 + r3.
  aerr_ulp_fma_correct
  : AXIOM
    FORALL(f1,f2,f3: (finite?),
           r1,r2,r3: real,
           e1,e2,e3: nnreal)
    : abs(proj(f1) - r1) <= e1 AND
      abs(proj(f2) - r2) <= e2 AND
      abs(proj(f3) - r3) <= e3 AND
      finite?(fma_ieee754(f1,f2,f3))
      IMPLIES
      abs(proj(fma_ieee754(f1,f2,f3)) - (r1*r2 + r3))
        <= aerr_ulp_fma(r1,e1,r2,e2,r3,e3)

END aerr_ulp_fma
