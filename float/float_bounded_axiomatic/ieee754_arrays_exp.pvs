ieee754_arrays_exp
[ (IMPORTING ieee754_format_parameters)
  b    : ieee754_radix,
  p    : ieee754_precision(b),
  emax : ieee754_maxExp(b,p) ]
: THEORY BEGIN

  IMPORTING ieee754_exp[b,p,emax]
  IMPORTING ieee754_arrays[b,p,emax]
  IMPORTING ieee754_arrays_unary_broadcast[b,p,emax, exp_ieee754]

  ieee754_arrays_exp(n: nat)(f: fparray(n)): fparray(n) =
    arrays_unary_op_ieee754(n)(f)

END ieee754_arrays_exp
