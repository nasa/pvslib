ieee754_arrays_ternary_broadcast
[ (importing ieee754_format_parameters, ieee754_semantics)
  b    : ieee754_radix,
  p    : ieee754_precision(b),
  emax : ieee754_maxExp(b,p),
  triOp : [datum[b,p,emax], datum[b,p,emax], datum[b,p,emax] -> datum[b,p,emax]]
]
: THEORY
BEGIN

  IMPORTING ieee754_arrays[b,p,emax]

  % Array ⊙ Array ⊙ Array (pointwise ternary op)
  arrays_ternary_op_ieee754(n: nat)(A, B, C: fparray(n)): fparray(n) =
    makeaa(n, LAMBDA (i: below(n)): triOp(at(A, i), at(B, i), at(C, i)))

  % Scalar ⊙ Array ⊙ Array (left broadcast)
  left_broadcast_ternary(n: nat)(x: datum[b,p,emax], B, C: fparray(n)): fparray(n) =
    makeaa(n, LAMBDA (i: below(n)): triOp(x, at(B, i), at(C, i)))

  % Array ⊙ Scalar ⊙ Array (middle broadcast)
  middle_broadcast_ternary(n: nat)(A: fparray(n), y: datum[b,p,emax], C: fparray(n)): fparray(n) =
    makeaa(n, LAMBDA (i: below(n)): triOp(at(A, i), y, at(C, i)))

  % Array ⊙ Array ⊙ Scalar (right broadcast)
  right_broadcast_ternary(n: nat)(A, B: fparray(n), z: datum[b,p,emax]): fparray(n) =
    makeaa(n, LAMBDA (i: below(n)): triOp(at(A, i), at(B, i), z))

  % Scalar ⊙ Scalar ⊙ Array
  ssa_left_broadcast_ternary(n: nat)(x, y: datum[b,p,emax], C: fparray(n)): fparray(n) =
    makeaa(n, LAMBDA (i: below(n)): triOp(x, y, at(C, i)))

  % Scalar ⊙ Array ⊙ Scalar
  sas_broadcast_ternary(n: nat)(x: datum[b,p,emax], B: fparray(n), z: datum[b,p,emax]): fparray(n) =
    makeaa(n, LAMBDA (i: below(n)): triOp(x, at(B, i), z))

  % Array ⊙ Scalar ⊙ Scalar
  ass_right_broadcast_ternary(n: nat)(A: fparray(n), y, z: datum[b,p,emax]): fparray(n) =
    makeaa(n, LAMBDA (i: below(n)): triOp(at(A, i), y, z))

END ieee754_arrays_ternary_broadcast
