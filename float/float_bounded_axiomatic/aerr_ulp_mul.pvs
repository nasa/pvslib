aerr_ulp_mul
[ (IMPORTING ieee754_format_parameters)
  b    : ieee754_radix,
  p    : ieee754_precision(b),
  emax : ieee754_maxExp(b,p) ]
: THEORY BEGIN

  IMPORTING ieee754_mul[b,p,emax] AS mul_th

  aerr_ulp_mul(r1:real,e1:nnreal,r2:real,e2:nnreal) : nnreal
  = abs(r1)*e2+abs(r2)*e1+e1*e2
    + ulp(abs(r1)*abs(r2) + abs(r1)*e2 + e1*abs(r2) + e1*e2)/2

  aerr_ulp_mul_correct
  : AXIOM FORALL(f1,f2: (finite?), r1,r2: real, e1,e2: nnreal)
    : abs(proj(f1) - r1) <= e1 AND
      abs(proj(f2) - r2) <= e2 AND
      finite?(mul_ieee754(f1,f2))
      IMPLIES abs(proj(mul_ieee754(f1,f2)) - (r1*r2)) <= aerr_ulp_mul(r1,e1,r2,e2)

  aerr_ulp_mul_p2l(n: nat,e: nonneg_real): nonneg_real = exponentiation.^(2,n) * e

  aerr_ulp_mul_p2r(n: nat,e: nonneg_real): nonneg_real = e * exponentiation.^(2,n)

  aerr_ulp_mul_correct__pow2l
  : axiom
   FORALL(e1: nonneg_real,
   	  r1: real,
	  f1: (finite?),
	  n1: nat):
    abs(proj(f1)-r1) <= e1 and
    finite?(mul_ieee754(round(exponentiation.^(2,n1)),f1))
    IMPLIES abs(proj(mul_ieee754(round(exponentiation.^(2,n1)),f1))-(exponentiation.^(2,n1)*r1)) <= aerr_ulp_mul_p2l(n1,e1)

  aerr_ulp_mul_correct__pow2r
  : axiom
   FORALL(e1: nonneg_real,
   	  r1: real,
	  f1: (finite?),
	  n1: nat):
    abs(proj(f1)-r1) <= e1 and
    finite?(mul_ieee754(f1,round(exponentiation.^(2,n1)))) 
    IMPLIES abs(proj(mul_ieee754(f1,round(exponentiation.^(2,n1))))-(r1*exponentiation.^(2,n1))) <= aerr_ulp_mul_p2r(n1,e1)

END aerr_ulp_mul
