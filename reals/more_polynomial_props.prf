     |exponentiation| NIL)
    (- CONST-DECL "[[numfield, numfield] -> numfield]" |number_fields| NIL)
    (> CONST-DECL "[[real, real] -> bool]" |reals| NIL)
    (|poly_deriv| CONST-DECL "[sequence[real] -> [nat -> real]]" |polynomials|
     NIL)
    (|root_degree| DEF-DECL
     "[d: [sequence[real], nat] -> [y: real -> {m: nat | m <= d`2 AND (d`1(d`2) /= 0 IMPLIES ((EXISTS (b: [nat -> real]): (FORALL (x: real): polynomial(d`1, d`2)(x) = (x - y) ^ m * polynomial(b, d`2 - m)(x)) AND polynomial(b, d`2 - m)(y) /= 0 AND b(d`2 - m) /= 0) AND (polynomial(d`1, d`2)(y) = 0 IMPLIES m > 0) AND ((d`2 > 0 AND m > 0) IMPLIES EXISTS (q: [nat -> real]): (FORALL (x: real): polynomial(poly_deriv(d`1), d`2 - 1)(x) = (x - y) ^ (m - 1) * polynomial(q, d`2 - m)(x)) AND polynomial(q, d`2 - m)(y) /= 0)))}]]"
     |more_polynomial_props| NIL))
   SHOSTAK)))

