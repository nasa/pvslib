    (|segment_2d| TYPE-EQ-DECL NIL |segments_2d| NIL)
    (= CONST-DECL "[[T, T] -> boolean]" |equalities| NIL)
    (|reverse_segment| CONST-DECL "[segment_2d -> segment_2d]" |segments_2d|
     NIL))
   SHOSTAK)))

