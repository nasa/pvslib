    (|emptyset| CONST-DECL "set" |sets| NIL)
    (|extensionality_postulate| FORMULA-DECL NIL |functions| NIL)
    (|connected_def| FORMULA-DECL NIL |connected_def| NIL))
   SHOSTAK)))

