peg[AST:TYPE] : THEORY
BEGIN

  IMPORTING peg_def[AST],
            structures@more_list_props

  push_scope(rule:Rule)(state:PegState) :
    {next_state : PegState | length(next_state`scopes) = length(state`scopes)+1}  =
    state WITH [ `scopes := cons(mk_scope(rule,current_pos(state)),state`scopes) ]

  pop_scope(state:PegState | length(state`scopes) > 0) :
    {next_state : PegState | length(next_state`scopes) = length(state`scopes)-1} =
    state WITH [ `scopes := cdr(state`scopes) ]

  add_item(item:Item)(state:PegState | success?(state`status)) : PegState =
    IF null?(state`scaffold) AND ast_item?(item) THEN
      LET asts = snoc(get_asts(state`status),get_ast(item)) IN
      state WITH [ `status := Success(asts) ]
    ELSIF null?(state`scaffold) THEN
      state
    ELSE
      LET new_tier  = car(state`scaffold) WITH [
                        items := add(item,car(state`scaffold)`items)
		      ] IN
      state WITH [ `scaffold := cons(new_tier,cdr(state`scaffold)) ]
    ENDIF

  length_cdr_tiers : LEMMA
    FORALL (l:list[ASTTier] | cons?(l)): length(cdr(l)) = length(l)-1

  add_item_eq : LEMMA
    FORALL (item:Item,state:PegState | success?(state`status)):
      add_item(item)(state)`last_token = state`last_token AND
      add_item(item)(state)`scopes = state`scopes AND
      length(add_item(item)(state)`scaffold) = length(state`scaffold)

  add_item_last_token : LEMMA
    FORALL (item:Item,state:PegState | success?(state`status)):
      add_item(item)(state)`last_token = state`last_token

  add_item_scopes : LEMMA
    FORALL (item:Item,state:PegState | success?(state`status)):
      add_item(item)(state)`scopes = state`scopes

  add_item_scaffold : LEMMA
    FORALL (item:Item,state:PegState | success?(state`status)):
      length(add_item(item)(state)`scaffold) = length(state`scaffold)

  open_wrk_level(state:PegState) : {next_state : PegState | length(next_state`scaffold) > 0} =
    LET new_tier = new_tier(state) IN
    state WITH [ `scaffold := cons(new_tier,state`scaffold) ]

  close_wrk_level(state:PegState | length(state`scaffold) > 0) : PegState =
    state WITH [ `scaffold := cdr(state`scaffold) ]

  depth_scopes(scopes:list[Scope],pos:nat) : RECURSIVE {n: nat | n <= length(scopes)} =
    IF null?(scopes) THEN 0
    ELSE LET scope = car(scopes) IN
      IF scope`pos`nxt_pos = pos THEN
        1+depth_scopes(cdr(scopes),pos)
      ELSIF scope`pos`nxt_pos > pos THEN
        depth_scopes(cdr(scopes),pos)
      ELSE
        0
      ENDIF
    ENDIF
    MEASURE scopes BY <<

  full_scope_rules(scopes:list[Scope]) : finite_set[Rule] =
    {rule : Rule | EXISTS (i:below(length(scopes))) : rule = nth(scopes,i)`rule}

  depth_scope_rules(scopes:list[Scope],pos:nat) : finite_set[Rule] =
    {rule:Rule | EXISTS (i:below(length(scopes))) :
                   nth(scopes,i)`rule = rule AND
		   nth(scopes,i)`pos`nxt_pos = pos}

  depth_scope_rules_union : LEMMA
    FORALL (scopes:(cons?[Scope]),pos:nat) :
      depth_scope_rules(scopes,pos) =
      union(depth_scope_rules((:car(scopes):),pos),
            depth_scope_rules(cdr(scopes),pos))

  depth_scope_rules_singleton : LEMMA
    FORALL (scope:Scope):
      card(depth_scope_rules((: scope :),scope`pos`nxt_pos)) = 1

  member_scope_rules?(scopes:list[Scope])(rule:Rule,pos:nat) :bool =
    EXISTS(i:below(length(scopes))):
      nth(scopes,i)`rule = rule AND
      nth(scopes,i)`pos`nxt_pos = pos

  depth_scope_rules_disjoint : LEMMA
     FORALL (scope:Scope,scopes:list[Scope]):
     NOT member_scope_rules?(scopes)(scope`rule,scope`pos`nxt_pos) IMPLIES
     disjoint?(depth_scope_rules((: scope :),scope`pos`nxt_pos),
               depth_scope_rules(scopes,scope`pos`nxt_pos))

  depth_scopes_j : RECURSIVE JUDGEMENT
    depth_scopes(scopes:(sorted_scopes?),pos:nat) HAS_TYPE
      {n : nat | n = card(depth_scope_rules(scopes,pos))}

  depth_scopes(state:PegState) : {n: nat | n <= length(state`scopes) } =
    IF null?(state`scopes) THEN 0
    ELSE LET scope = car(state`scopes) IN
      1+depth_scopes(cdr(state`scopes),scope`pos`nxt_pos)
    ENDIF

  depth_scopes_eq : LEMMA
    FORALL (state1,state2:PegState) :
      state1`scopes = state2`scopes IMPLIES
      depth_scopes(state1) = depth_scopes(state2)

  valid_scopes?(peg:PEG)(state:PegState) : bool =
    % Position of current scope is less or equal than pos
    current_scope(state)`pos`nxt_pos <= current_pos(state)`nxt_pos AND
    % Scopes are sorted
    sorted_scopes?(state`scopes) AND
    % All scope rules are in peg
    FORALL (i:below(length(state`scopes))):
      some?(peg_find_rule(peg)(nth(state`scopes,i)`rule))

  valid_scopes_eq : LEMMA
    FORALL (peg:PEG,state1,state2:PegState) :
      current_pos(state1)`nxt_pos <= current_pos(state2)`nxt_pos AND
      state1`scopes = state2`scopes AND
      valid_scopes?(peg)(state1) IMPLIES
      valid_scopes?(peg)(state2)

  valid_pegstate?(peg:PEG,str:string)(state:PegState) : bool =
    % Current position is valid
    valid_pos?(length(str))(current_pos(state)) AND
    % Scopes are valid
    valid_scopes?(peg)(state)

  valid_next_pegstate?(state:PegState)(next_state:PegState) : MACRO bool =
      current_pos(next_state)`nxt_pos >= current_pos(state)`nxt_pos AND
      length(next_state`scaffold) >= length(state`scaffold) AND
      depth_scopes(next_state) >= depth_scopes(state)

  % Validity of a state only depends on its last token and its scopes
  valid_pegstate_eq : LEMMA
    FORALL (peg:PEG,str:string,state1,state2:PegState):
      state1`last_token = state2`last_token AND
      state1`scopes = state2`scopes IMPLIES
      (valid_pegstate?(peg,str)(state1) IFF valid_pegstate?(peg,str)(state2))

  % Postcondition of peg_parse: the position never moves back and, on success,
  % the scope stack and the number of working levels are unchanged
  parse_next?(state:PegState)(next_state:PegState) : bool =
    current_pos(next_state)`nxt_pos >= current_pos(state)`nxt_pos AND
    (success?(next_state`status) IMPLIES
       next_state`scopes = state`scopes AND
       length(next_state`scaffold) = length(state`scaffold))

  % Number of scopes at the current position
  current_depth(state:PegState) : nat =
    depth_scopes(state`scopes,current_pos(state)`nxt_pos)

  depth_scopes_pegstate : JUDGEMENT
    depth_scopes(state:PegState | sorted_scopes?(state`scopes)) HAS_TYPE
      {n : upto(length(state`scopes)) |
           n = IF null?(state`scopes) THEN 0
	       ELSE card(depth_scope_rules(state`scopes,car(state`scopes)`pos`nxt_pos))
	       ENDIF}

  in_sorted_scopes(scopes:(sorted_scopes?))
                  (rule:Rule,pos:Position |
                   cons?(scopes) IMPLIES pos`nxt_pos >= car(scopes)`pos`nxt_pos)
    : RECURSIVE { b : bool | b = member_scope_rules?(scopes)(rule,pos`nxt_pos) } =
    cons?(scopes) AND
    LET scope = car(scopes) IN
      pos`nxt_pos = scope`pos`nxt_pos AND  % This take advantange that scopes are sorted
      (rule = scope`rule OR in_sorted_scopes(cdr(scopes))(rule,pos))
    MEASURE length(scopes)

  % In a valid state, all scopes are at or before the current position
  scopes_le_current : LEMMA
    FORALL (peg:PEG,state:PegState):
      valid_scopes?(peg)(state) IMPLIES
      FORALL (k:below(length(state`scopes))):
        nth(state`scopes,k)`pos`nxt_pos <= current_pos(state)`nxt_pos

  % A scope at or after all the scopes of a sorted list, and different from all of
  % them, can be added on top
  sorted_cons_scope : LEMMA
    FORALL (scope:Scope,scopes:(sorted_scopes?)):
      (FORALL (k:below(length(scopes))):
         nth(scopes,k)`pos`nxt_pos <= scope`pos`nxt_pos AND
         NOT same_scope?(scope,nth(scopes,k))) IMPLIES
      sorted_scopes?(cons(scope,scopes))

  % Opening a scope for a rule of the PEG that is not open at the current position
  % keeps the state valid
  push_scope_valid : LEMMA
    FORALL (peg:PEG,str:string,rule:Rule,state:(valid_pegstate?(peg,str))):
      some?(peg_find_rule(peg)(rule)) AND
      NOT member_scope_rules?(state`scopes)(rule,current_pos(state)`nxt_pos) IMPLIES
      valid_pegstate?(peg,str)(push_scope(rule)(state))

  set_fail_status(state:PegState) : PegState =
    state WITH [ `status := Failure(state`failed_items) ]

  in_failed_items(label:ReportingLabel,scope:Scope)(failed_items:list[FailedItem]) :
    RECURSIVE bool =
    cons?(failed_items) AND
    LET failed_item = car(failed_items) IN
      (label = failed_item`expected AND scope = failed_item`location`scope) OR
      in_failed_items(label,scope)(cdr(failed_items))
    MEASURE failed_items BY <<

  failed_loc(state:PegState|cons?(state`failed_items)) : Location =
    car(state`failed_items)`location

  loc_gt(loc1,loc2:Location) : bool =
    loc1`start_pos`nxt_pos > loc2`start_pos`nxt_pos OR
    (loc1`start_pos`nxt_pos = loc2`start_pos`nxt_pos AND
     loc1`end_pos`nxt_pos > loc2`end_pos`nxt_pos)

  loc_eq(loc1,loc2:Location) : bool =
    loc1`start_pos`nxt_pos = loc2`start_pos`nxt_pos AND
    loc1`end_pos`nxt_pos = loc2`end_pos`nxt_pos

  peg_failed_item(label:ReportingLabel,opt_loc:Maybe[Location])(state:PegState) : PegState =
    LET loc   = IF none?(opt_loc) THEN current_loc(state)
	        ELSE val(opt_loc)
	        ENDIF,
        gt    = cons?(state`failed_items) IMPLIES loc_gt(loc,failed_loc(state)),
	ge    = (gt OR loc_eq(loc,failed_loc(state))) IN
    IF null?(state`failed_items) OR
       (ge AND NOT in_failed_items(label,loc`scope)(state`failed_items)) THEN
      LET failed_item = mk_failed_item(label,loc) IN
      IF null?(state`failed_items) OR gt THEN
        set_fail_status(state WITH [ `failed_items := (: failed_item :) ])
      ELSE
        set_fail_status(state WITH [
	  `failed_items := snoc(state`failed_items,failed_item)
	])
      ENDIF
    ELSE
      set_fail_status(state)
    ENDIF

  peg_failed_item_j : JUDGEMENT
    FORALL(peg:PEG,str:string,label:ReportingLabel,opt_loc:Maybe[Location],state:(valid_pegstate?(peg,str))):
      peg_failed_item(label,opt_loc)(state) HAS_TYPE
      {next_state:(valid_pegstate?(peg,str)) | valid_next_pegstate?(state)(next_state)}

  % Build a new item and add it to the end of AST deck
  build_item(opt_ast:Maybe[AST])(state:PegState | success?(state`status) AND
						  length(state`scaffold) > 0)
    : PegState =
    IF none?(opt_ast) THEN
      close_wrk_level(state)
    ELSE
      LET items = car(state`scaffold)`items,
          (start_pos,end_pos) =
            IF length(items) = 0 THEN
	      (current_pos(state),current_pos(state))
	    ELSE
	      LET last = length(items) - 1 IN 
	      (get_loc(items(0))`start_pos,get_loc(items(last))`end_pos)
	    ENDIF,
          item = ASTItem(val(opt_ast),mk_loc(current_scope(state),start_pos,end_pos)) IN
      add_item(item)(close_wrk_level(state))
    ENDIF

  build_item_eq : LEMMA
    FORALL (opt_ast:Maybe[AST],state:PegState | success?(state`status) AND length(state`scaffold) > 0):
      build_item(opt_ast)(state)`last_token = state`last_token AND
      build_item(opt_ast)(state)`scopes = state`scopes AND
      length(build_item(opt_ast)(state)`scaffold) = length(state`scaffold)-1

  peg_abort(msg:string,opt_loc:Maybe[Location])(state:PegState) : PegState =
    LET loc = IF none?(opt_loc) THEN current_loc(state)
	      ELSE val(opt_loc)
	      ENDIF IN
    state WITH [ `status := Aborted(msg,loc) ]

  % Failure results keep the state valid and do not move the position
  set_fail_status_next : LEMMA
    FORALL (peg:PEG,str:string,state:PegState,s:(valid_pegstate?(peg,str))):
      current_pos(s)`nxt_pos >= current_pos(state)`nxt_pos IMPLIES
      valid_pegstate?(peg,str)(set_fail_status(s)) AND
      parse_next?(state)(set_fail_status(s))

  peg_abort_next : LEMMA
    FORALL (peg:PEG,str:string,state:PegState,s:(valid_pegstate?(peg,str)),
            msg:string,opt_loc:Maybe[Location]):
      current_pos(s)`nxt_pos >= current_pos(state)`nxt_pos IMPLIES
      valid_pegstate?(peg,str)(peg_abort(msg,opt_loc)(s)) AND
      parse_next?(state)(peg_abort(msg,opt_loc)(s))

  peg_failed_item_next : LEMMA
    FORALL (peg:PEG,str:string,state:PegState,s:(valid_pegstate?(peg,str)),
            label:ReportingLabel,opt_loc:Maybe[Location]):
      current_pos(s)`nxt_pos >= current_pos(state)`nxt_pos IMPLIES
      valid_pegstate?(peg,str)(peg_failed_item(label,opt_loc)(s)) AND
      parse_next?(state)(peg_failed_item(label,opt_loc)(s))

  % After a successful parse from push_scope(rule)(state), pop_scope restores the scopes
  pop_push_scope : LEMMA
    FORALL (rule:Rule,state,s2:PegState):
      parse_next?(push_scope(rule)(state))(s2) AND success?(s2`status) IMPLIES
      length(s2`scopes) > 0 AND
      pop_scope(s2)`scopes = state`scopes AND
      length(pop_scope(s2)`scaffold) = length(state`scaffold) AND
      current_pos(pop_scope(s2))`nxt_pos >= current_pos(state)`nxt_pos

  % parse_next? composes through a successful intermediate state
  parse_next_trans : LEMMA
    FORALL (s1,s2,s3:PegState):
      parse_next?(s1)(s2) AND success?(s2`status) AND parse_next?(s2)(s3) IMPLIES
      parse_next?(s1)(s3)


  IMPORTING orders@orders_nat,
            orders@lex2_generic

  peg_parse(peg:PEG,pegex:PEGex,str:string,lookup:bool)
           (state:(valid_pegstate?(peg,str)) | success?(state`status))
    : RECURSIVE { next_state : (valid_pegstate?(peg,str)) | parse_next?(state)(next_state) } =
    % status is always Success at the beginning of the recursion
    CASES pegex OF
      PegEmpty : state,
      PegAST(e,astf) :
        IF lookup THEN
	  peg_parse(peg,e,str,lookup)(state)
	ELSE
          LET state1 = peg_parse(peg,e,str,lookup)(open_wrk_level(state)) IN
	  IF success?(state1`status) THEN
	    LET ast_out = astf(state1) IN
	    IF exit?(ast_out) THEN
              peg_abort(get_msg(ast_out),get_opt_loc(ast_out))(state1)
	    ELSIF fail?(ast_out) THEN
	      LET label = get_label(ast_out) IN
              IF reporting_label?(label) THEN
                peg_failed_item(label,get_opt_loc(ast_out))(state1)
	      ELSE
	        set_fail_status(state1)
	      ENDIF
	    ELSE
	      build_item(get_opt_ast(ast_out))(state1)
	    ENDIF
	  ELSE
	    state1
	  ENDIF
	ENDIF,
      PegTerminal(rgx,label,build) :
        LET mpos    = match_pos(rgx,str,current_pos(state)),
	    end_pos = mpos`pos,
	    loc     = mk_loc(current_scope(state),current_pos(state),end_pos) IN
	  % Fail also if no char is consumed
	  IF NOT success(mpos) OR end_pos`nxt_pos <= current_pos(state)`nxt_pos THEN
	    IF lookup OR NOT reporting_label?(label) THEN
	       set_fail_status(state)
	    ELSE
               peg_failed_item(label,loc)(state)
	    ENDIF
	  ELSE
	    LET token      = gen_strings.substr(str,current_pos(state)`nxt_pos,end_pos`nxt_pos),
	        item       = TokenItem(label,token,loc),
	        next_state = state WITH [ `last_token  := item ] IN
	    IF lookup OR NOT build THEN
	      next_state
	    ELSE
	      add_item(item)(next_state)
            ENDIF
	  ENDIF,
      PegNonTerminal(rule) :
        LET opt_rule = peg_find_rule(peg)(rule) IN
	IF none?(opt_rule) THEN
	  peg_abort("Undefined rule ("+rule+")",None)(state)
	ELSIF in_sorted_scopes(state`scopes)(rule,current_pos(state)) OR
	      current_depth(state) >= length(peg) THEN
	  peg_abort("Possible left recursion ("+rule+")",None)(state)
	ELSE
	  LET state1 = push_scope(rule)(state),
	      state2 = peg_parse(peg,val(opt_rule),str,lookup)(state1) IN
	    IF success?(state2`status) THEN
	      pop_scope(state2)
	    ELSE
	      state2
	    ENDIF
	ENDIF,
      PegSeq(e1,e2) :
        LET state1 = peg_parse(peg,e1,str,lookup)(state) IN
	IF aborted?(state1`status) OR failure?(state1`status) THEN
	  state1
	ELSE
	  peg_parse(peg,e2,str,lookup)(state1)
	ENDIF,
      PegChoice(e1,e2) :
        LET state1 = peg_parse(peg,e1,str,lookup)(state) IN
        IF aborted?(state1`status) OR success?(state1`status) THEN
	  state1
	ELSE
	  LET state2 = state WITH [
	    `failed_items := state1`failed_items
	  ] IN
	  peg_parse(peg,e2,str,lookup)(state2)
	ENDIF,
      PegStar(e) :
        LET state1 = peg_parse(peg,e,str,lookup)(state) IN
	IF aborted?(state1`status) THEN
	  state1
	ELSIF failure?(state1`status) THEN
	  state WITH [
	    `failed_items := state1`failed_items
	  ]
	ELSIF current_pos(state)`nxt_pos = current_pos(state1)`nxt_pos THEN
	  peg_abort("Possible infinite loop",None)(state1)
	ELSE
	  peg_parse(peg,PegStar(e),str,lookup)(state1)
	ENDIF,
      PegNot(e,label) :
        LET state1 = peg_parse(peg,e,str,TRUE)(state) IN
	IF aborted?(state1`status) THEN
	  state1
	ELSIF failure?(state1`status) THEN
	  state
	ELSIF reporting_label?(label) THEN
	  LET loc = mk_loc(current_scope(state),current_pos(state),current_pos(state1)) IN
	  peg_failed_item(label,loc)(state)
	ELSE
	  set_fail_status(state)
	ENDIF
    ENDCASES
  % The measure decreases on every recursive call: the input is consumed, or the
  % position is the same and a new scope is open at the current position, or the
  % position and the scopes are the same and the expression is smaller
  MEASURE ((length(str)-current_pos(state)`nxt_pos)::nat,
           ((IF current_depth(state) <= length(peg) THEN length(peg)-current_depth(state)
             ELSE 0 ENDIF)::nat,
            pegex)) BY lt_lex2(lt_nat,lt_lex2(lt_nat,<<))

  peg_parse(peg:PEG,pegex:PEGex,str:string) : PegState =
    peg_parse(peg,pegex,str,FALSE)(init_state)

  parse(peg:PEG,str:string) : PegStatus =
    peg_parse(peg,StartRule,str)`status

END peg
