(attachments
  |pvsio_random_generator|

  (defattach |generateInstance| ((the-type :decl-type))
    "generates a new instance"
    (let ((target-type the-type)
	  (size (pvsio_get_gvar_by_name "pvsio_random_generator_parameters.DOMAIN_SIZE_LIMIT"))
	  (dtsize (pvsio_get_gvar_by_name "pvsio_random_generator_parameters.ADT_SIZE_LIMIT")))
      (eval(pvs2cl(generate-instance target-type size dtsize))))))