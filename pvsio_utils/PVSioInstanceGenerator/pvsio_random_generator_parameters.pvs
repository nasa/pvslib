pvsio_random_generator_parameters: THEORY
BEGIN

  DOMAIN_SIZE_LIMIT : Global[nat,100]
  ADT_SIZE_LIMIT    : Global[nat,10]

  setDomainSizeLimit(limit: nat): void = set(DOMAIN_SIZE_LIMIT,limit)
  getDomainSizeLimit: nat = val(DOMAIN_SIZE_LIMIT)

  setADTSizeLimit(limit: nat): void = set(ADT_SIZE_LIMIT,limit)
  getADTSizeLimit: nat = val(ADT_SIZE_LIMIT) 

END pvsio_random_generator_parameters
