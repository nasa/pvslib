     "[pred[[T, T]] -> bool]" |directed_orders| |orders|)
    (|sq_le| CONST-DECL "[[Cont, Cont] -> bool]" |Cont| NIL)
    (|directed_complete_partial_order?| CONST-DECL "[pred[[T, T]] -> bool]"
     |directed_orders| |orders|)
    (SS CONST-DECL "[Stm[V] -> Cont[V]]" |sos| NIL)
    (SS DEF-DECL "[Stm[V] -> Cont[V]]" |direct| NIL)
    (|fullset_is_clopen| NAME-JUDGEMENT "clopen[Cont[V], scott_open_sets]"
     |direct_sos| NIL)
    (|partial_order_antisymmetric| FORMULA-DECL NIL |partial_order_props|
     |orders|)
    (|antisymmetric?| CONST-DECL "[PRED[[T, T]] -> bool]" |relations| NIL)
    (|partial_order?| CONST-DECL "[pred[[T, T]] -> bool]" |orders| NIL)
    (|direct_le_sos| FORMULA-DECL NIL |direct_sos| NIL))
   SHOSTAK)))

