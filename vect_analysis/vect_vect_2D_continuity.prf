     "(strict_total_order?[real])" |real_props| NIL)
    (|continuous_vvr?| CONST-DECL "[[[Vect2, Nz_vect2] -> real] -> bool]"
     |vect_vect_2D_continuity| NIL)
    (|real_minus_real_is_real| APPLICATION-JUDGEMENT "real" |reals| NIL))
   SHOSTAK)))

