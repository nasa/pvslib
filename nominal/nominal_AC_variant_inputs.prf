    (|lst2set_is_finite| FORMULA-DECL NIL |list_aux_equational_reasoning| NIL)
    (|inst_step| DEF-DECL
     "[[finite_set[variable], fresh_context, unif_prb, unif_prb, sub] -> [fresh_context, unif_prb, sub, bool]]"
     |nominal_AC_inst_step| NIL)
    (|null?| ADT-RECOGNIZER-DECL "[list -> boolean]" |list_adt| NIL)
    (|null| ADT-CONSTRUCTOR-DECL "(null?)" |list_adt| NIL)
    (|solve_ac_ren| FORMULA-DECL NIL |aux_nominal_AC_unification| NIL)
    (|vars| DEF-DECL "[list[list[variable]] -> finite_set[variable]]"
     |nominal_AC_term_properties| NIL)
    (|sec_proj| DEF-DECL "[list[[T1, T2]] -> list[T2]]"
     |list_aux_equational_reasoning2parameters| NIL)
    (|every| ADT-DEF-DECL "[PRED[T] -> [list -> boolean]]" |list_adt| NIL)
    (|finset2list| DEF-DECL "[finite_set[T] -> list[T]]"
     |list_aux_equational_reasoning| NIL)
    (|choose_eq_nice_input| FORMULA-DECL NIL |nominal_AC_ac_step| NIL)
    (NOT CONST-DECL "[bool -> bool]" |booleans| NIL)
    (|var_inputs?| CONST-DECL
     "[[nice_input, nice_input, finite_set[variable]] -> bool]"
     |nominal_AC_variant_inputs| NIL)
