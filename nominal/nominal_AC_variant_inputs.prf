    (|subset_is_partial_order| NAME-JUDGEMENT "(partial_order?[set[T]])"
     |sets_lemmas| NIL)
    (|member| DEF-DECL "[[T, list[T]] -> bool]" |list_props| NIL)
    (|apply_ac| CONST-DECL "[nice_input -> list[nice_input]]"
     |nominal_AC_ac_step| NIL)
    (|choose_eq| DEF-DECL "[unif_prb -> [unif_pair, unif_prb]]"
     |nominal_AC_ac_step| NIL))
   NIL)))

