real_array: theory
begin

  importing abstract_array[real]
  %
  % aarray[real] forms in fact a vector space
  %

  real_array: type = aarray[real]
  rarray(n: nat): type = flarray(n)

  ;+(a: real_array, b: rarray(len(a)))
  : rarray(len(a))
  = makeaa(len(a), λ(i: below(len(a))): at(a,i) + at(b,i))

  ;-(a: real_array, b: rarray(len(a)))
  : rarray(len(a))
  = makeaa(len(a), λ(i: below(len(a))): at(a,i) - at(b,i))

  ;/(a: real_array, k: nonzero_real)
  : rarray(len(a))
  = makeaa(len(a), λ(i: below(len(a))): at(a,i)/k)

  abs(a: real_array)
  : rarray(len(a))
  = makeaa(len(a), λ(i: below(len(a))): abs(at(a,i)))

  max_from(a: real_array, i: below(len(a))): recursive real
  = if i+1 < len(a) then max(at(a,i), max_from(a,i+1))
    else at(a,i) endif
    measure len(a)-i

  max(a: real_array): real = IF len(a)=0 THEN 0 ELSE max_from(a,0) ENDIF

  l_inf_norm(a: real_array): real
  = max(abs(a))

  leq_real_array(a,b: real_array): bool
  = ∀(i: below(min(len(a),len(b)))): at(a,i) <= at(b,i)

  ;<=(a,b: real_array)
  : macro bool
  = leq_real_array(a,b)

  leq_real_array_scalar(a: real_array, k: real): bool
  = ∀(i: below(len(a))): at(a,i) <= k

  ;<=(a: real_array, k: real): macro bool
  = leq_real_array_scalar(a, k)

  leq_real_scalar_array(k: real, a: real_array): bool
  = ∀(i: below(len(a))): k <= at(a,i)

  ;<=(k: real, a: real_array): macro bool
  = leq_real_scalar_array(k, a)

  % -----------------------------------------------------------------------------
  % Real reference dot (scalar) using rarray(n) and at(.,.)
  % -----------------------------------------------------------------------------
  rdot_from(n: nat, r1: rarray(n), r2: rarray(n), i: below(n)) : recursive real =
    if i + 1 < n then
      at(r1, i) * at(r2, i) + rdot_from(n, r1, r2, i + 1)
    else
      at(r1, i) * at(r2, i)
    endif
  measure n - i

  rdot(n: nat)(r1: rarray(n), r2: rarray(n)) : real =
    if n = 0 then 0 else rdot_from(n, r1, r2, 0) endif

end real_array
