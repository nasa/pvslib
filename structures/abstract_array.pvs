abstract_array[T: type]: theory
begin

  aarray: type = finseq[T]

  len(a: aarray): macro nat
  = length(a)

  % % ;@@(a: aarray, i: below(len(a)))
  % ;^(a: aarray, i: below(len(a)))
  % : macro T
  % = a`seq(i)

  at(a: aarray, i: below(len(a)))
  : macro T
  = a`seq(i)

  makeaa(len: nat, def: [below(len)->T])
  : macro aarray
  = (# length := len, seq := def #)

  % fixed length array
  flarray(n: nat): type = {a: aarray | len(a) = n}

end abstract_array
