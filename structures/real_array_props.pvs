real_array_props  % [ parameters ]
		: THEORY

  BEGIN

  IMPORTING real_array

% Absolute value index property
 abs_def: LEMMA
  FORALL(a: real_array, i: below(len(a))):
  at(abs(a),i) = abs(at(a,i))

% Max properties
 ra_max_from_bound: LEMMA
   FORALL(a: real_array, i:below(len(a))):
    FORALL(j: upfrom(i) | j < len(a)):
    max_from(a,i) >= at(a,j)

  ra_max_bound: LEMMA
   FORALL(a: real_array, i:below(len(a))):
    max(a) >= at(a,i)

 ra_max_from_eq: LEMMA
   FORALL(a: real_array,i:below(len(a))):
    EXISTS(j: upfrom(i) | j < len(a)):
     max_from(a,i) = at(a,j)

 ra_max_eq: LEMMA
   FORALL(a: real_array):
   len(a) = 0 OR
    (EXISTS(i:below(len(a))):
     max(a) = at(a,i))

% Infinity norm properties

 inf_norm_bound: LEMMA
  FORALL(a: real_array, i:below(len(a))):
   l_inf_norm(a) >= abs(at(a,i))

 inf_norm_eq: LEMMA
  FORALL(a: real_array):
   len(a) = 0 OR
   EXISTS(i:below(len(a))):
   l_inf_norm(a) = abs(at(a,i))
  

  End real_array_props
