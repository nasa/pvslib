     "[d: [set[T], set[T]] -> [[coset(d`1, d`2), coset(d`1, d`2)] -> set[T]]]"
     |cosets_def| NIL)
    (|lc_gen| CONST-DECL "[d: [set[T], set[T]] -> [left_coset(d`1, d`2) -> T]]"
     |cosets_def| NIL)
    (|product| CONST-DECL
     "[d: [set[T], set[T]] -> [[coset[T, +](d`1, d`2), coset[T, +](d`1, d`2)] -> set[T]]]"
     |product_coset_def| NIL)
    (|lproduct| CONST-DECL
     "[d: [set[T], set[T]] -> [[left_coset[T, +](d`1, d`2), left_coset[T, +](d`1, d`2)] -> set[T]]]"
     |product_coset_def| NIL)
    NIL NIL NIL NIL
    (|R_epimorphism?| CONST-DECL
     "[d: [set[T1], set[T2]] -> [[(d`1) -> (d`2)] -> bool]]"
     |ring_homomorphisms_def| NIL)
    (|R_isomorphism?| CONST-DECL
     "[d: [set[T1], set[T2]] -> [[(d`1) -> (d`2)] -> bool]]"
     |ring_homomorphisms_def| NIL)
    (|coset| TYPE-EQ-DECL NIL |cosets_def| NIL)
    (|coset?| CONST-DECL "[[set[T], set[T]] -> [set[T] -> bool]]" |cosets_def|
     NIL)
    (/ CONST-DECL "[[set[T], set[T]] -> setof[set[T]]]" |cosets_def| NIL)
    (|setof| TYPE-EQ-DECL NIL |defined_types| NIL)
    (IFF CONST-DECL "[[bool, bool] -> bool]" |booleans| NIL)
    (|subset?| CONST-DECL "[[set, set] -> bool]" |sets| NIL) NIL
    (|extend| CONST-DECL "[[S -> R] -> [T -> R]]" |extend| NIL)
    (FALSE CONST-DECL "bool" |booleans| NIL) NIL
    (AND CONST-DECL "[[bool, bool] -> bool]" |booleans| NIL) NIL NIL NIL
    (|ideal?| CONST-DECL "[[set[T], (ring?)] -> bool]" |ring_ideal_def| NIL)
    (|ideal| TYPE-EQ-DECL NIL |ring_ideal_def| NIL)
    (|restrict| CONST-DECL "[[T -> R] -> [S -> R]]" |restrict| NIL)
    (|image| CONST-DECL "[[D -> R] -> [set[D] -> set[R]]]" |function_image|
     NIL))
   NIL)))

