    (* CONST-DECL "[[numfield, numfield] -> numfield]" |number_fields| NIL)
    (|opp_absconvergent| FORMULA-DECL NIL |absconv_series| NIL)
    (- CONST-DECL "[[T -> real] -> [T -> real]]" |real_fun_ops| |reals|)
    (|minus_real_is_real| APPLICATION-JUDGEMENT "real" |reals| NIL)
    (- CONST-DECL "[numfield -> numfield]" |number_fields| NIL)
    (|trichotomy| FORMULA-DECL NIL |real_axioms| NIL)
    (NOT CONST-DECL "[bool -> bool]" |booleans| NIL)
    (|sigma_nnreal| APPLICATION-JUDGEMENT "nnreal" |sigma_nat| |reals|)
    (|nnreal_times_nnreal_is_nnreal| APPLICATION-JUDGEMENT "nnreal"
     |real_types| NIL)
    (|real_le_is_total_order| NAME-JUDGEMENT "(total_order?[real])"
     |real_props| NIL)
    (|real_lt_is_strict_total_order| NAME-JUDGEMENT
     "(strict_total_order?[real])" |real_props| NIL)
    (|sigma_scal| FORMULA-DECL NIL |sigma| |reals|)
    (OR CONST-DECL "[[bool, bool] -> bool]" |booleans| NIL)
    (<= CONST-DECL "[[real, real] -> bool]" |reals| NIL)
    (|T_high| TYPE-EQ-DECL NIL |sigma| |reals|)
    (|T_low| TYPE-EQ-DECL NIL |sigma| |reals|)
    (|abs_mult| FORMULA-DECL NIL |real_props| NIL)
    (|subrange| TYPE-EQ-DECL NIL |integers| NIL)
    (|nonzero_abs_is_pos| APPLICATION-JUDGEMENT "{y: posreal | y >= x}"
     |real_defs| NIL)
    (|sigma_eq| FORMULA-DECL NIL |sigma| |reals|)
    (|series| CONST-DECL "[sequence[real] -> sequence[real]]" |series| NIL)
    (|convergent_scal| FORMULA-DECL NIL |convergence_ops| |analysis|))
   SHOSTAK)))

