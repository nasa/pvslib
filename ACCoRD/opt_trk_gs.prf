     |real_props| NIL)
    (|sq| CONST-DECL "[real -> nonneg_real]" |sq| |reals|)
    (- CONST-DECL "[[numfield, numfield] -> numfield]" |number_fields| NIL)
    (|numfield| NONEMPTY-TYPE-EQ-DECL NIL |number_fields| NIL)
    (|opt_trk_gs_dot| CONST-DECL
     "[d: [Nz_vect2, Vect2, Vect2, real] -> {nvo: (optimal?(d`2, Vdir(d`1, d`2 - d`3))) | d`1 * (nvo - d`3) = d`4}]"
     |opt_trk_gs| NIL)
    (* CONST-DECL "[[Vector, Vector] -> real]" |vectors_2D| |vectors|)
    (- CONST-DECL "[[Vector, Vector] -> Vector]" |vectors_2D| |vectors|)
    (|Theta_D| CONST-DECL
     "[[s: Vect2, {nzv: Nz_vect2 | Delta(s, nzv) >= 0}, Sign] -> real]"
     |horizontal| NIL)
    (|Sign| TYPE-EQ-DECL NIL |sign| |reals|)
    (= CONST-DECL "[[T, T] -> boolean]" |equalities| NIL)
    (OR CONST-DECL "[[bool, bool] -> bool]" |booleans| NIL)
    (|nzint| NONEMPTY-TYPE-EQ-DECL NIL |integers| NIL)
    (|int| NONEMPTY-TYPE-EQ-DECL NIL |integers| NIL)
    (|integer_pred| CONST-DECL "[rational -> boolean]" |integers| NIL)
    (|rational| NONEMPTY-TYPE-FROM-DECL NIL |rationals| NIL)
    (|rational_pred| CONST-DECL "[real -> boolean]" |rationals| NIL)
    (|Delta| CONST-DECL "[[Vect2, Vect2] -> real]" |horizontal| NIL)
    (D FORMAL-CONST-DECL "posreal" |opt_trk_gs| NIL)
    (+ CONST-DECL "[[Vector, Vector] -> Vector]" |vectors_2D| |vectors|)
    (|posreal| NONEMPTY-TYPE-EQ-DECL NIL |real_types| NIL)
    (> CONST-DECL "[[real, real] -> bool]" |reals| NIL)
    (|nonneg_real| NONEMPTY-TYPE-EQ-DECL NIL |real_types| NIL)
    (>= CONST-DECL "[[real, real] -> bool]" |reals| NIL)
    (* CONST-DECL "[[real, Vector] -> Vector]" |vectors_2D| |vectors|)
    (|real_pred| CONST-DECL "[number_field -> boolean]" |reals| NIL)
    (|number_field| NONEMPTY-TYPE-FROM-DECL NIL |number_fields| NIL)
    (|number_field_pred| CONST-DECL "[number -> boolean]" |number_fields| NIL)
    (|number| NONEMPTY-TYPE-DECL NIL |numbers| NIL)
    (|Vdir| CONST-DECL "[[Nz_vect2, Vect2] -> Nz_vect2]" |definitions| NIL)
    (|optimal?| CONST-DECL "[[Vect2, Nz_vect2] -> [Vect2 -> bool]]"
     |definitions| NIL)
    (|Nz_vect2| TYPE-EQ-DECL NIL |vectors_2D| |vectors|)
    (|zero| CONST-DECL "Vector" |vectors_2D| |vectors|)
    (/= CONST-DECL "[[T, T] -> boolean]" |notequal| NIL)
    (|Vector| TYPE-EQ-DECL NIL |vectors_2D| |vectors|)
    (|Vect2| TYPE-EQ-DECL NIL |vectors_2D_def| |vectors|)
    (|real| NONEMPTY-TYPE-FROM-DECL NIL |reals| NIL)
    (NOT CONST-DECL "[bool -> bool]" |booleans| NIL)
    (|bool| NONEMPTY-TYPE-EQ-DECL NIL |booleans| NIL)
    (|boolean| NONEMPTY-TYPE-DECL NIL |booleans| NIL))
   NIL)))

