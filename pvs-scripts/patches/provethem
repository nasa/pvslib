sub check_arg_lib {
  my ($arg_name,$lib,$die_on_error) = @_;
  my $error_msg;
  if (! -d $lib) {
    $error_msg = "Library $lib, appearing in option $arg_name,".
      " not found in the current folder\n";
  } elsif (! grep { $lib eq $_ } @all_libraries) {
    $error_msg = "Library $lib, appearing in option $arg_name,".
      " not found in $file\n";
  }

  if ($error_msg){
    print "Error (provethem): " if $die_on_error;
    print "*** Warning (provethem): " unless $die_on_error;
    print $error_msg;
    exit 1 if $die_on_error;
  }
}

sub iterate_command_libs($){
  my $go = shift;
  print "Executing shell command \"$execute\" on each library\n" if $verbose;

  my $return_value=0;
  my $processed_libs=0;
  my $summary;
  my @libraries;

  open(INFILE,"$file");
  while (<INFILE>) {
    my $line = $_;
    $line =~ s/\#.*$//;
    $line = trim($line);
    next if !$line || $line =~ m/^ *-.*$/;
    if ($line) {
      my @list = split /:/,$line;
      my $lib = trim($list[0]);
      my $opts = trim($list[1] // '');
      if ($lib) {
	$go = "ok" if $from eq $lib;
	last if $before eq $lib;

	if (($go || grep { "$_" eq $lib } @dolist) &&
	    !(grep { "$_" eq $lib } @butlist)) {
	  $processed_libs += 1;
	  my $pathlib;
	  my $baselib;
	  if (-d $lib) {
	    $pathlib = $lib;
	    $baselib = "";
	  } elsif (-f $lib) {
	    my $typelib;
	    ($baselib,$pathlib,$typelib) = fileparse($lib,qr{\..*});
	    $baselib .= $typelib;
	  } else {
	    die "Error (provethem): $lib is neither a file nor a directory\n";
	  }
	  my $command = $execute;
	  $command =~ s/\%DIR\%/$pathlib/g;
	  $command =~ s/\%FILE\%/$baselib/g;

	  if ($command) {
	      print "Executing shell \"$command\"\n" if $verbose;
	      my $beginln = sprintf "%-".$column_width."s",$lib;
	      $beginln .= "$act... ";
	      print $beginln;
	      my $fail_msg;
	      my $warn_msg;
	      my $fail;
	      my $proveout;
	      if (! -d $lib) {
		$fail = 1;
		$fail_msg = "Library not found";
		$proveout="Library $lib not found\n";

		print OUTFILE "$proveout\n" if $out;
	      } else {
		$proveout=`$command`;

		if ($? == -1) {
		  $fail = 127;
		} elsif ($? & 127) {
		  $fail = ($? & 127);
		} else {
		  $fail = ($? >> 8);
		}

		print OUTFILE "$proveout\n" if $out;

		my @warnings = ($proveout =~ m/(Warning.*[:]? .*)/g);
		if (@warnings) {
		  $warn_msg = join("\n*** ",@warnings);
		}

		my @errors = ($proveout =~ m/(Error.*[:]? .*)/g);
		if (@errors) {
		  $fail_msg = join("\n*** ",@errors);
		}
	      }

	      my $status;

	      if ($fail > 0) {
		$status = "FAIL";
		my $custom_status=$ret_val_labels{$fail};
		$status=$custom_status if $custom_status;
		print "[";
		if ($color) {
		  print DARK RED $status;
		} else {
		  print $status;
		}
		$fail_msg .= " (return value: $fail)" if $verbose;
		if ($fail_msg) {
		  print "]\n*** $fail_msg\n";
		  $summary .= "$beginln\[$status: $fail_msg]\n";
		} else {
		  print "]\n";
		  $summary .= "$beginln\[$status]\n";
		}
		# Update my return value
		$return_value=$fail if ($fail > $return_value);
	      }

	      if ($fail == 0) {
		$status = $ret_val_labels{0};
		$status = "OK" if ! $status;
		print "[";
		$beginln.= "[";
		if ($color) {
		  print DARK GREEN $status;
		} else {
		  print $status;
		}
		my $endln = "]\n";
		print $endln;
		print "\n$proveout\n" if $proveout && !$no_printout;
		$summary .= "$beginln$status$endln";
	      }
	      # Only print warnings if the proveout is not printed
	      # since warnings are already there.
	      print "*** $warn_msg\n" if $warn_msg && $no_printout;
	      last if !$force && ($fail > 1) && !$ret_val_labels{$fail};
	  }
	}
	push(@libraries,$lib);
	$go = "ok" if $after eq $lib;
	last if $to eq $lib;
      }
    }
  }

  my $mssg = "\n";
  $mssg .= "*** Number of libraries: $processed_libs\n";
  print $mssg;
  $summary .= $mssg;

  close(INFILE);

  print OUTFILE $summary if $out;

  return($return_value);
}

my @current_wspaths;

sub check_dependencies {
  my ($depdir,$deplib) = @_;
  my $depfile = "$depdir/$deplib.dep";
  my $localws;
  my $localbase;

  if (-f $depfile) {
    open (DEPFILE,"$depfile");
    while (<DEPFILE>) {
      my $line = $_;
      $line =~ s/#.*//;
      $line = trim($line);
      next if !$line;

      die "Error (provethem): File $depfile appears to be corrupted ",
	  "(line ",${\*DEPFILE}->input_line_number,")\n" if ($line =~ tr/://) != 1;

      my @list = split ":",$line;
      my $wspath = trim($list[0]);
      if ($wspath =~ /^(?:\[([^\]]+)\])?([^\/]+)(?:\/(.+))?$/) {
	my $collection  = $1 // '';   # optional [name]
	my $base = $2;         # required base
	my $path = $3 // '';   # optional /path

	next if !$collection && !$path; # These are local dependencies

	if (!$localws) {
	  $localws = $wspath;
	  $localbase = $base;
	  push @current_wspaths, $localws;
	} elsif ($localbase eq $base) {
	  print "*** Warning (provethem): Library $path is either missing or out of order. It should appear before $deplib in $file\n"
	      if !grep { $_ eq $wspath } @current_wspaths;
	}
      }
    }
    close (DEPFILE);
  } elsif ( $checkdep ) {
    print "*** Warning (provethem): File $depfile not found\n";
  }
}

# ad-hoc version of iterate_command_libs to apply proveit on each library in the scope
sub iterate_proveit_libs($) {
  my $go = shift;
  $execute="$PROVEIT --dependencies %OVEROPTS% %OPTS% %DIR%";

  $ret_val_labels{'142'}="MISS";
  $ret_val_labels{'15'}="FAIL - terminated";

  $no_printout="t";

  #

  print "Executing shell command \"$execute\" on each library\n" if $verbose || $dryrun;

  #<
  my $totalformulas = 0;
  my $totalproofs = 0;
  #>

  my $return_value=0;
  my $processed_libs = 0;
  my $summary;

  open(INFILE,"$file");
  while (<INFILE>) {
    my $line = $_;
    $line =~ s/\#.*$//;
    $line = trim($line);
    next if !$line;
    next if $line =~ m/^-.*$/;

    my @list = split /:/,$line;
    my $lib = trim($list[0]);
    my $opts = trim($list[1] // '');

    if (!$lib) {
      $over_opts = $opts." ".$over_opts;
      next;
    }

    $go = "ok" if $from eq $lib;
    last if $before eq $lib;

    if (($go || grep { "$_" eq $lib } @dolist) &&
	!(grep { "$_" eq $lib } @butlist)) {
      $processed_libs += 1;
      my $pathlib;
      my $baselib;
      if (-d $lib) {
	$pathlib = $lib;
	$baselib = "";
      } elsif (-f $lib) {
	my $typelib;
	($baselib,$pathlib,$typelib) = fileparse($lib,qr{\..*});
	$baselib .= $typelib;
      } else {
	die "Error (provethem): $lib is neither a file nor a directory\n";
      }
      my $command = $execute;
      $command =~ s/\%DIR\%/$pathlib/g;
      $command =~ s/\%FILE\%/$baselib/g;
      $command =~ s/\%OVEROPTS\%/$over_opts/g;
      $command =~ s/\%OPTS\%/$opts/g;

      print "About to run: $command\n" if $verbose || $dryrun;
      next if $dryrun;

      my $beginln = sprintf "%-".$column_width."s",$lib;
      $beginln .= "$act... ";
      print $beginln;
      my $fail_msg;
      my $warn_msg;
      my $fail;
      my $proveout;
      my $current_formulas;
      my $current_attempted;
      my $current_proofs;

      $proveout=`$command`;

      if ($? == -1) {
	$fail = 127;
      } elsif ($? & 127) {
	$fail = ($? & 127);
      } else {
	$fail = ($? >> 8);
      }

      print OUTFILE "$proveout" if $out;

      my @warnings = ($proveout =~ m/(Warning.*[:]? .*)/g);
      if (@warnings) {
	#<
	for my $warning ( @warnings ) {
	  next if ($warning =~ m/Missed \d+ formula/);
	  $warn_msg .= "*** ".$warning."\n";
	}
	#>
      }

      my @errors = ($proveout =~ m/(Error.*[:]? .*)/g);
      $fail_msg = join("\n*** ",@errors) if @errors;

      #<
      if($proveout =~ m/Grand Totals: (\d+) proofs, (\d+) attempted, (\d+) succeeded/){
	$current_formulas = $1;
	$current_attempted = $2;
	$current_proofs = $3;

	$totalformulas += $current_formulas;
	$totalproofs += $current_proofs;
      } else {
	$current_formulas = -1;
      }
      #>

      my $status;

      if ($fail > 0) {
	$status = "FAIL";
	my $custom_status=$ret_val_labels{$fail};
	$status=$custom_status if $custom_status;
	print "[";
	if ($color) {
	  print DARK RED $status;
	} else {
	  print $status;
	}
	#<
	my $status_message = "";
	if ( $current_formulas >= 0 ) {
	  my $miss   = $current_formulas-$current_attempted;
	  my $unsucc = $current_formulas-$current_proofs;
	  my $comma  = "";
	  my $msguna = "";
	  if ($miss) {
	    $comma = ", ";
	    $msguna = "$miss unattempted";
	  }
	  my $msguns = "$comma$unsucc unsuccessful" if $unsucc;
	  $status_message = ": $msguna$msguns / $current_formulas formulas";
	}
	#>
	$fail_msg .= " (return value: $fail)" if $verbose;
	if ($fail_msg) {
	  #<
	  print "$status_message]\n*** $fail_msg\n";
	  my $one_line_fail_msg = $fail_msg;
	  $one_line_fail_msg =~ s/\R/ /g;
	  $summary .= "$beginln\[$status$status_message - $one_line_fail_msg]\n";
	  #>
	} else {
	  #<
	  print "$status_message]\n";
	  $summary .= "$beginln\[$status$status_message]\n";
	  #>
	}
	# Update my return value
	$return_value=$fail if ($fail > $return_value);
      }

      if ($fail == 0) {
	$status = $ret_val_labels{0};
	$status = "OK" if ! $status;
	print "[";
	$beginln.= "[";
	if ($color) {
	  print DARK GREEN $status;
	} else {
	  print $status;
	}
	#<
	my $endln = "]\n";
	$endln = ": $current_proofs proofs".$endln if $current_proofs;
	#>
	print $endln;
	print "\n$proveout\n" if $proveout && !$no_printout;
	$summary .= "$beginln$status$endln";
      }
      # Only print warnings if the proveout is not printed
      # since warnings are already there.
      print "*** $warn_msg\n" if $warn_msg && $no_printout;
      check_dependencies($dir,$lib) if $checkdep;
      last if !$force && ($fail > 1) && !$ret_val_labels{$fail};
    }
    $go = "ok" if $after eq $lib;
    last if $to eq $lib;
  }
  close(INFILE);

  my $mssg = "\n";
  #<
  if (!$cleanall && !$clean && !$typecheckonly) {
    my $missed = $totalformulas-$totalproofs;
    $mssg .= "*** Grand Totals: $totalproofs proofs / $totalformulas formulas. Missed: $missed formulas\n";
  }
  $mssg .= "*** Number of libraries: $processed_libs\n";
  print $mssg;
  $summary .= $mssg;
  #>

  print OUTFILE $summary if $out;
  return($return_value);
}

#
# Main
#

check_arg_lib("--from",$from,1) if $from;
check_arg_lib("--to",$to,1) if $to;
check_arg_lib("--before",$before,1) if $before;
check_arg_lib("--after",$after,1) if $after;

foreach (@dolist) {
  $_ =~ s/\/$//;
  my $dolib = $_;
  check_arg_lib("--do",$dolib,1);
}

foreach (@butlist) {
  $_ =~ s/\/$//;
  my $butlib = $_;
  check_arg_lib("--but",$butlib,0);
}

die "Error (provethem): $file is a directory\n" if -d $file;

if (!$out && !$cleanall && !$clean && !$execute && !$dryrun) {
  my ($base,$path,$type) = fileparse($file,qr{\..*});
  $out  = "$path$base";

  my $dol = join('_',@dolist);
  $dol =~ s/\//-/g;
  $out .= "-$dol" if $dol;

  my $butl = join('_',@butlist);
  $butl =~ s/\//-/;
  $out .= "-but_$butl" if $butl;

  $out .= "-from_$from" if $from;
  $out .= "-to_$to" if $to;
  $out .= "-after_$after" if $after;
  $out .= "-before_$before" if $before;
  $out .= ".grandtotals";
  $out .= "-tc" if $typecheckonly;
}

if ($out) {
  open (OUTFILE,">$out") or print "*** Warnining: cannot create output file $out\n";
}

print "Processing $file";
if ($out) {
    print ". Writing output into $out\n";
} else {
    print "\n"
}

if (! $act ) {
  if ($clean || $cleanall) {
    $act = "Cleaning";
  } elsif ($typecheckonly) {
    $act = "Typing";
  } elsif ($execute) {
    $act = "Processing";
  } else {
    $act = "Proving";
  }
}

# Set global options
$over_opts .= " --clean-only" if !$cleanall && $clean;
$over_opts .= " --clean-all" if $cleanall;
$over_opts .= " --typecheck-only" if $typecheckonly;
$over_opts .= " --dir \"$dir\"" if $dir;
$over_opts .= " --top \"$top\"" if $top;

my $go = "ok" if !($from || $after || @dolist);
my $return_value=0;

if(!$execute) {
  # If no command has been given, the command to iterate is
  # assumend to be proveit
  $return_value=iterate_proveit_libs($go);
} else {
  $return_value=iterate_command_libs($go);
}

if ($out) {
  close(OUTFILE);
}

exit($return_value);
