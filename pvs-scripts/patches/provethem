sub normalize_dir {
  my ($path) = @_;
  return $path =~ /\/$/ ? $path : "$path/";
}

sub resolve_script_dir {
  my $path = shift;
  if ($path !~ /\//) {
    my $candidate = `command -v "$path" 2>/dev/null`;
    chomp $candidate;
    $path = $candidate if $candidate ne "";
  }
  my $resolved = abs_path($path);
  return defined $resolved ? dirname($resolved) : undef;
}

my $PVSPATH = $ENV{PVSPATH};
if (defined $PVSPATH && -d $PVSPATH) {
  my $resolved = abs_path($PVSPATH);
  $PVSPATH = defined $resolved ? normalize_dir($resolved) : normalize_dir($PVSPATH);
} else {
  my $script_dir = resolve_script_dir($0);
  die "Error (provethem): The PVS installation could not be located from $0\n"
    unless defined $script_dir;
  $PVSPATH = normalize_dir($script_dir);
}

