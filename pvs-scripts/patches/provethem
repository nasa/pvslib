sub generate_all_libraries($) {
  my $file = shift;
  if ($generateinput) {
    print "Input file $file not found. It will be generated!\n";

    opendir(current_directory, ".");
    my @libdirs = readdir(current_directory);
    closedir(current_directory);

    my $depdir = $dir2 || $SUMMARIES;
    my $topname = $top2 || $TOP;

    if (! -d $depdir) {
	die "About to run: mkdir $depdir" if $dryrun2;
	make_path($depdir) or die "Error (provethem): Failed to create $depdir\n";
    }

    my $depopt = " --typecheck-only --dependencies --generate-top --dir $depdir --top $topname";

    my %lib_deps;
    my @all_libraries=();
    my $over_opts='';
    $over_opts .= "--pvs-option '".join("' --pvs-options '",@pvs_opts)."'" if @pvs_opts;
    $over_opts .= "--".join(" --",@proveit_opts) if @proveit_opts;
    foreach my $libdir (@libdirs) {
      # skip . and ..
      next if($libdir =~ /^\.$/);
      next if($libdir =~ /^\.\.$/);

      if (-d $libdir) {
	my @files_in_subdir = glob("$libdir/*.pvs");

	# Only take into considerations folders that have at least one pvs file
	if ( scalar @files_in_subdir > 0) {
	  # look into the dep file to check dependencies
	  my $depfile = "$depdir/$libdir.dep";
	  my $topfile = "$libdir/$topname.pvs";
	  if (! -f $topfile && ! $force2) {
	      print "File $topfile not found. It could be generated, but it takes time\n";
	      print "Do you want to continue? [y/n] n\b";
	      my $answer = <STDIN>;
	      chomp $answer;
	      exit 0 unless $answer =~ /^[yY]/;
	  } elsif (! -f $depfile && ! $force2) {
	      print "No dependency file $depfile found. It could be generated, but it may take time\n";
	      print "Do you want to continue? [y/n] n\b";
	      my $answer = <STDIN>;
	      chomp $answer;
	      exit 0 unless $answer =~ /^[yY]/;
	  }
	  my $depcomm = "$PROVEIT $depopt $over_opts $libdir";
	  print "About to run: $depcomm\n" if $verbose2 || $dryrun2;
	  exit 0 if $dryrun2;
	  my $depout = `$depcomm`;
	  if (-f $depfile) {
	    push(@all_libraries,$libdir);
	    my $localws;
	    my $localbase;
	    open (DEPFILE,"$depfile");
	    while (<DEPFILE>) {
	      my $line = $_;
	      $line =~ s/#.*//;
	      $line = trim($line);
	      next if !$line;

	      die "Error (provethem): File $depfile appears to be corrupted ",
		  "(line ",${\*DEPFILE}->input_line_number,")\n" if ($line =~ tr/://) != 1;

	      my @list = split ":",$line;
	      my $wspath = trim($list[0]);
	      if ($wspath =~ /^(?:\[([^\]]+)\])?([^\/]+)(?:\/(.+))?$/) {
		my $collection  = $1 // '';   # optional [name]
		my $base = $2;         # required base
		my $path = $3 // '';   # optional /path

		next if !$collection && !$path; # These are local dependencies
		if (!$localws) {
		  $localws = $wspath;
		  $localbase = $base;
		} elsif ($localbase eq $base) {
		  push(@{$lib_deps{$libdir}}, $path);
		}
	      }
	    }
	    close (DEPFILE);
	  } else {
	      die "${depout}Error (provethem): File $depfile could not be generated\n"
	  }
	}
      }
    }

    # Order the arrays of libraries according to its its dependencies.
    my $lib_cmp = sub($$) {
      my $a = $_[0];
      my $b = $_[1];
      my $result=0;
      if (exists $lib_deps{$a} && grep { $b eq $_ } @{$lib_deps{$a}}){
	$result=1;
      } elsif (exists $lib_deps{$b} && grep { $a eq $_ } @{$lib_deps{$b}}){
	$result=-1;
      }
      return $result;
    };
    @all_libraries = sort {$lib_cmp->($a,$b)} @all_libraries;

    # Finally, print the list into the all-libraries file.
    my $datestring = localtime();
    open (all_libraries_file,">$file") or die "Error (provethem): File $file cannot be written\n";
    print all_libraries_file "# This file was generated automatically by provethem on $datestring\n";
    print all_libraries_file "--top $top2 " if $top2;
    print all_libraries_file "--dir $dir2 " if $dir2;
    print all_libraries_file "\n" if $top2 || $dir2;
    print all_libraries_file ": $over_opts\n" if $over_opts;
    print all_libraries_file join("\n",@all_libraries), "\n";
    close(all_libraries_file);
    print "File $file generated\n" if $verbose2;
  } else {
    die "Error (provethem): File $file not found. Use --generate-input to generate it\n";
  }
}

