sub readVersion() {
  $VERSION = `$PROVEIT --version`;
  $VERSION =~ s/^(.*)[\r\n]*$/$1/;
}

sub trim($) {
  my $string = shift;
  $string =~ s/^\s+//;
  $string =~ s/\s+$//;
  return $string;
}

sub usage() {
  readVersion();

  print <<EOF;
NAME
   provethem -- run proveit on a collection of libraries

SYNOPSYS
   $usageln

   File <input-file> is a list of libraries to be processed by proveit. If <input-file>
is not provided, the file name \"all-libraries\" is assumed. Lines in <input-file> have either
the form <provethem-options> or <lib> [: <proveit-options>], where <provethem-options> is
a preset list of provethem options, <lib> is a directory library in the working path, and
<proveit-options> is a preset list of proveit options for library <lib>. When <lib> is empty,
<proveit-options> apply to all libraries thenceforth.  Output file can be
specified using the option --out.  Otherwise, a default name having the form
<input-file><postfix>.grandtotals is used. The <postfix> depends on the options
--do,--but,--from,--to,--after,--before given to the script. Summaries for each <lib> are
saved in the directory \"summaries\", unless the option --dir is provided.

OPTIONS
   Options are processed in the order they appear. Options marked [+] can be
   used multiple times and are cumulative.

The following options filter the set of libraries to process
   --after=<dir>           prove all libraries after <dir>, exclusive
   --before=<dir>          prove all libraries before <dir>, exclusive
[*]--but=<dir1>,..,<dirn>  do not process libraries <dir1>,..,<dirn>
[*]--do=<dir1>,..,<dirn>   process libraries <dir1>,..,<dirn>
   --from=<dir>            prove all libraries from <dir>, inclusive
   --to=<dir>              prove all libraries to <dir>, inclusive

The following options control the behavior of provethem
   --action-name <name>    use <name> to summarize  <command> action
   -C|--clean-only         remove .pvscontext and binary files in the pvsbin folder, and quit
   --clean-all             remove .pvscontext, orphaned-proofs.prf, and all files in pvsbin, and quit
   --color                 use colors (default behavior)
   --no-color		   don't use colors
   -d|--dir <dir>          use <dir> as default directory for generated files
   --dry-run               print commands wihtout executing them
   --no-dry-run            disable dry run
   --execute <command>     execute Unix <command> on all libraries, interpolating \%DIR\% and \%FILE\%
   -f|--force              force provethem to go even if there is a proveit error
   -o|--out <file>         save output to <file>
   -q|--quiet              be silent
[*]--ret-val-label <val>=<label> use <label> to print the return value <val> of <command>
   -T|--typecheck-only     typecheck but do not prove the libraries
   --top <name>            use <name>.pvs instead of \"top.pvs\" as top theory
   -v|--verbose            print summary information for all theories

The following options can only be used in the command line interface, i.e., they cannot be preset
as provethem options in <input-file>.
   --generate-input        generate <input-file> if it doesn't exist
   -h|--help               print this message
[+]--proveit-option <opt>  pass <opt> to proveit, where <opt> doesn't have a leading '-',
[+]--pvs-option <opt>      pass <opt> to PVS, where <opt> doesn't have a leading '-',
   --version               print version information and exit

VERSION
   $VERSION
EOF
  exit;
}

my $provethem_opts;

sub push_arg {
  my ($opt_name, $opt_value) = @_;
  if (length($opt_name) == 1) {
    $provethem_opts .= "-$opt_name ";
  } else {
    $provethem_opts .= "--$opt_name ";
  }
  $provethem_opts .= "$opt_value " if $opt_value;
}

sub push_bool_arg {
  my ($opt_name, $opt_value) = @_;
  if (length($opt_name) == 1) {
    $provethem_opts .= "-$opt_name ";
  } elsif ($opt_value) {
    $provethem_opts .= "--$opt_name ";
  } else {
    $provethem_opts .= "--no-$opt_name ";
  }
}

