normalize_dir() {
  case "$1" in
    */) printf '%s\n' "$1" ;;
    *) printf '%s/\n' "$1" ;;
  esac
}

resolve_script_dir() {
  local target=$1
  case "$target" in
    */*) ;;
    *) target=`command -v "$target"` || return 1 ;;
  esac
  while [ -h "$target" ]
  do
    link=`readlink "$target"` || return 1
    case "$link" in
      /*) target=$link ;;
      *) target=`dirname "$target"`/$link ;;
    esac
  done
  CDPATH= cd -- "`dirname "$target"`" 2>/dev/null && pwd -P
}

if [ -n "$PVSPATH" -a -d "$PVSPATH" ]
then PVSPATH=`normalize_dir "$PVSPATH"`
else
  PVSPATH=`resolve_script_dir "$0"` || {
    echo "Unable to determine the PVS installation directory"
    exit 1
  }
  PVSPATH=`normalize_dir "$PVSPATH"`
fi

#-------------------------------------------------
# Nothing below this line should need modification
#

readVersion() {
    if [ ! -x "$PVSPATH/pvs" ] || ! VERSION=$("$PVSPATH/pvs" -raw -E '(format t "~&~%PROVEITVERSION ~a~%~%" *prooflite-version*)(bye)' 2> /dev/null | grep PROVEITVERSION | sed 's/^.*PROVEITVERSION \(.*\)$/\1/g') ; then
	printf "PVS could not be located. Please double check PVS installation.\n"
	exit 1;
    fi
}

if [ ! -x "$PVSPATH/pvs" ]; then
    printf "Error (proveit): PVS could not be located relative to %s\n" "$0"
    exit 1;
fi

