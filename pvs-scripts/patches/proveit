reset_vars() {
    PVSCONTEXT=
    ARG=
    OUTBASE=
    OUTDIR=   # Absolute path
    OUTFILE=  # Absolute path
    LOGFILE=  # Absolute path
    OUTPUTNAMES=
    DEPENDENCIES=
