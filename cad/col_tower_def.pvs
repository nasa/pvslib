col_tower_def: THEORY
%----------------------------------------------------------------------------
% The tower of Collins projections, executable.
%
% fam turns a list of polynomials back into a family (each as its
% coefficient list in its main variable); pdown(G) = fam(fsplit(projn(G)))
% is the family one level down: the projection split into mpoly_gcd_def's
% basis (meant to be squarefree and pairwise coprime; that is neither proved
% nor checked) when the product check confirms that every member is c times
% a product of basis members (mpoly_cert_def); correctness
% needs only that factorization.  ctw(F, k) = [P_1, ..., P_k] with P_k = F and
% P_(j-1) = pdown(P_j); pbot(F, k) = P_0, the family of the outermost variable.
% col_tower proves that ctw(F, k) is a CAD over every connected base cell on
% which P_0 is sign-invariant.
%----------------------------------------------------------------------------
BEGIN
  IMPORTING cad_projn_def, towern_def, mpoly_cert_def

  F, G: VAR list[list[mpoly]]
  U: VAR list[mpoly]
  k: VAR nat

  fam(U): list[list[mpoly]] = map(as_list)(U)
  pdown(G): list[list[mpoly]] = fam(fsplit(projn(G)))

  %% the tower of projections and its bottom
  %% (k = 1 is its own case so that evaluation does not compute pdown(F) only to drop it)
  ctw(F, k): RECURSIVE Tower =
    IF k = 0 THEN null[list[list[mpoly]]] ELSIF k = 1 THEN (: F :)
    ELSE append(ctw(pdown(F), k - 1), (: F :)) ENDIF
  MEASURE k
  pbot(F, k): RECURSIVE list[list[mpoly]] = IF k = 0 THEN F ELSE pbot(pdown(F), k - 1) ENDIF
  MEASURE k

END col_tower_def
