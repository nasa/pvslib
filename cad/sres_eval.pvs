sres_eval: THEORY
%----------------------------------------------------------------------------
% subres' principal subresultant coefficients and subres2's subresultant
% coefficients, evaluated at a point, are the determinants of sres_rows and
% sres_gcd.
%
% At a valuation ys of the parameters, the entries of sresm(f, g, j) are the
% real coefficients of f and g (sylvester's coef_at_earr), laid out as
% sylj(earr(f, ys), dg(f), earr(g, ys), dg(g), j) on the square part
% (sresm_corner), so meval(psc(f, g, j))(ys) is that determinant (psc_ev);
% the matrix of sresc(f, g, j, k) is the same with its last column at degree
% k (sresm2_corner), so meval(sresc(f, g, j, k))(ys) is sres_gcd's sresv
% (sresc_ev).  With sres_thm and sres_gcd this makes the projection's psc
% signs at a point decide the common divisors of the fibre polynomials.
%----------------------------------------------------------------------------
BEGIN
  IMPORTING sres_gcd, subres2

  f, g: VAR list[mpoly]
  ys: VAR list[real]
  j, k, a, b: VAR nat

  sresm_corner: LEMMA 2 * j <= dg(f) + dg(g) AND b < dg(f) + dg(g) - 2 * j IMPLIES
    ev(sresm(f, g, j), ys)(a, b) = sylj(earr(f, ys), dg(f), earr(g, ys), dg(g), j)(a, b)

  psc_ev: THEOREM 2 * j <= dg(f) + dg(g) IMPLIES
    meval(psc(f, g, j))(ys) = rdet(dg(f) + dg(g) - 2 * j, sylj(earr(f, ys), dg(f), earr(g, ys), dg(g), j))

  sresm2_corner: LEMMA 0 < j AND 2 * j < dg(f) + dg(g) AND k <= j AND b < dg(f) + dg(g) - 2 * j IMPLIES
    ev(sresm2(f, g, j, k), ys)(a, b) =
      setcol(sylj(earr(f, ys), dg(f), earr(g, ys), dg(g), j), dg(f) + dg(g) - 2 * j - 1,
             scol(earr(f, ys), dg(f), earr(g, ys), dg(g), j, k))(a, b)

  sresc_ev: THEOREM 0 < j AND 2 * j < dg(f) + dg(g) AND k <= j IMPLIES
    meval(sresc(f, g, j, k))(ys) = sresv(earr(f, ys), dg(f), earr(g, ys), dg(g), j)(k)
END sres_eval
