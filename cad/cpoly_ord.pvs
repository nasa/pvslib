cpoly_ord: THEORY
%----------------------------------------------------------------------------
% The order of a root (its multiplicity).
%
% ordp?(P, y, m): P = (z - y)^m Q with Q a polynomial and Q(y) /= 0.
%   ord_ex      a polynomial of exact degree n has such an m <= n (with a
%               cofactor of degree n - m and the same leading coefficient)
%   ord_unique  m is unique (pw_cancel: powers of a linear factor cancel)
%   ord_mul     orders add under products
%   ord_dvd     a divisor has order at most that of the polynomial
%   ord_der     the derivative of a polynomial of order m + 1 at y has order m
%               at y (cpoly_der's cder_pow)
%   ord(P, y)   the order as a function, for P of exact degree (ord_def)
%----------------------------------------------------------------------------
BEGIN
  IMPORTING cpoly_der

  P, Q, H, W, D, A, B: VAR [complex -> complex]
  n, m, k, n0, n1: VAR nat
  y, z, c, d: VAR complex

  ordp?(P, y, m): bool = EXISTS Q, n: cpol?(Q, n) AND Q(y) /= real_(0) AND FORALL z: P(z) = cpw(y, m)(z) * Q(z)

  cpw_add: LEMMA cpw(y, m + k)(z) = cpw(y, m)(z) * cpw(y, k)(z)
  cpw_cpol: LEMMA cpol?(cpw(y, m), m)
  cpw_at: LEMMA cpw(y, m + 1)(y) = real_(0)
  cpw_off: LEMMA z /= y IMPLIES cpw(y, m)(z) /= real_(0)

  ord_ex: LEMMA FORALL n: FORALL P, c: clead?(P, n, c) IMPLIES
    EXISTS m, Q: m <= n AND clead?(Q, n - m, c) AND Q(y) /= real_(0) AND FORALL z: P(z) = cpw(y, m)(z) * Q(z)

  pw_cancel: LEMMA FORALL m: cpol?(A, n0) AND cpol?(B, n1) AND (FORALL z: cpw(y, m)(z) * A(z) = cpw(y, m)(z) * B(z))
    IMPLIES FORALL z: A(z) = B(z)
  ord_le: LEMMA ordp?(P, y, m) AND ordp?(P, y, k) IMPLIES k <= m
  ord_unique: LEMMA ordp?(P, y, m) AND ordp?(P, y, k) IMPLIES m = k
  ord_mul: LEMMA ordp?(P, y, m) AND ordp?(Q, y, k) IMPLIES ordp?(cmul(P, Q), y, m + k)
  ord_ext: LEMMA ordp?(P, y, m) AND (FORALL z: Q(z) = P(z)) IMPLIES ordp?(Q, y, m)
  ord_zero: LEMMA cpol?(P, n) AND P(y) /= real_(0) IMPLIES ordp?(P, y, 0)
  ord_root: LEMMA ordp?(P, y, m) IMPLIES (P(y) = real_(0) IFF m > 0)

  ord_dvd: LEMMA ordp?(P, y, m) AND clead?(P, n1, d) AND clead?(H, n, c) AND cpol?(W, n0)
    AND (FORALL z: P(z) = H(z) * W(z))
    IMPLIES EXISTS k: k <= m AND ordp?(H, y, k)

  ord_der: LEMMA ordp?(P, y, m + 1) AND cder?(P, D) IMPLIES ordp?(D, y, m)

  %% the order as a function
  ord(P, y): nat = epsilon! (m: nat): ordp?(P, y, m)
  ord_def: LEMMA clead?(P, n, c) IMPLIES ordp?(P, y, ord(P, y))
  ord_eq: LEMMA ordp?(P, y, m) IMPLIES ord(P, y) = m
END cpoly_ord
