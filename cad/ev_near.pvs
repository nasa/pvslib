ev_near: THEORY
%----------------------------------------------------------------------------
% "Eventually near p1 in C" and "for every small eps": bookkeeping for the
% finitely many conditions of the local Collins argument.
%
% ev?(C, p1, P): P holds at the points of C within some d of p1.  Closed
% under weakening (ev_mono), conjunction (ev_and) and bounded universal
% quantification over nat (ev_all, by induction on the bound), so finitely
% many members, roots and coefficients are handled by quantifying over their
% positions.  ev_ball: the points near p1 are eventually near; ev_cont: the
% value of an mpoly is eventually close to its value at p1 (mpar's
% mev_mcont).
% sm?(Q): Q holds for every eps up to some positive bound; closed the same
% way (sm_and, sm_all), with sm_le (eps <= r) and sm_ex (some eps).
%----------------------------------------------------------------------------
BEGIN
  IMPORTING cad_conn

  C: VAR [list[real] -> bool]
  p, p1: VAR list[real]
  P, Q: VAR [list[real] -> bool]
  PP: VAR [nat -> [list[real] -> bool]]
  n, i: VAR nat
  u: VAR mpoly
  e, r: VAR posreal

  ev?(C, p1, P): bool = EXISTS (d: posreal): FORALL p: C(p) AND near?(p, p1, d) IMPLIES P(p)

  ev_mono: LEMMA ev?(C, p1, P) AND (FORALL p: C(p) AND P(p) IMPLIES Q(p)) IMPLIES ev?(C, p1, Q)
  ev_and: LEMMA ev?(C, p1, P) AND ev?(C, p1, Q) IMPLIES ev?(C, p1, LAMBDA p: P(p) AND Q(p))
  ev_all: LEMMA FORALL n: (FORALL i: i < n IMPLIES ev?(C, p1, PP(i))) IMPLIES
    ev?(C, p1, LAMBDA p: FORALL i: i < n IMPLIES PP(i)(p))
  ev_ball: LEMMA ev?(C, p1, LAMBDA p: near?(p, p1, e))
  ev_cont: LEMMA ev?(C, p1, LAMBDA p: abs(meval(u)(p) - meval(u)(p1)) < e)

  %% ---- for every small eps -------------------------------------------------------------------
  Q1, Q2: VAR [posreal -> bool]
  QQ: VAR [nat -> [posreal -> bool]]
  sm?(Q1): bool = EXISTS (e0: posreal): FORALL e: e <= e0 IMPLIES Q1(e)

  sm_and: LEMMA sm?(Q1) AND sm?(Q2) IMPLIES sm?(LAMBDA e: Q1(e) AND Q2(e))
  sm_all: LEMMA FORALL n: (FORALL i: i < n IMPLIES sm?(QQ(i))) IMPLIES
    sm?(LAMBDA e: FORALL i: i < n IMPLIES QQ(i)(e))
  sm_le: LEMMA sm?(LAMBDA e: e <= r)
  sm_ex: LEMMA sm?(Q1) IMPLIES EXISTS e: Q1(e)
END ev_near
