sector_rep: THEORY
%----------------------------------------------------------------------------
% Polynomial functions and the product of a family: the
% intermediate value theorem for a polynomial in the top variable (ivt_pf),
% its sign constant where it has no root (same_sign), and prodl(F), the
% product of a family, zero exactly where some member is (prodl_zero).
%----------------------------------------------------------------------------
BEGIN
  IMPORTING mpoly_prod, sign_vec

  l, g, f: VAR list[mpoly]
  F: VAR list[list[mpoly]]
  xs, ys: VAR list[real]
  x, a, b, c, z: VAR real

  %% the intermediate value theorem for a polynomial in the top variable
  ivt_pf: LEMMA a < b AND ((pf(l, ys)(a) < 0 AND pf(l, ys)(b) > 0) OR
                           (pf(l, ys)(a) > 0 AND pf(l, ys)(b) < 0))
    IMPLIES EXISTS c: a < c AND c < b AND pf(l, ys)(c) = 0
  same_sign: LEMMA a <= x AND x <= b AND a <= c AND c <= b AND
    (FORALL z: a <= z AND z <= b IMPLIES pf(l, ys)(z) /= 0)
    IMPLIES sign3(pf(l, ys)(x)) = sign3(pf(l, ys)(c))

  %% the product of a family
  prodl(F): RECURSIVE list[mpoly] =
    IF null?(F) THEN (: mconst(1) :) ELSE lmul(car(F), prodl(cdr(F))) ENDIF
  MEASURE length(F)
  prodl_null: LEMMA prodl(null[list[mpoly]]) = (: mconst(1) :)
  prodl_cons: LEMMA prodl(cons(l, F)) = lmul(l, prodl(F))
  prodl_eval_null: LEMMA meval(mpol(prodl(null[list[mpoly]])))(xs) = 1
  prodl_eval_cons: LEMMA meval(mpol(prodl(cons(l, F))))(xs) =
    meval(mpol(l))(xs) * meval(mpol(prodl(F)))(xs)
  mem_cons: LEMMA member(f, cons(l, F)) IFF (f = l OR member(f, F))
  prodl_zero: LEMMA FORALL F: meval(mpol(prodl(F)))(xs) = 0 IFF
    (EXISTS f: member(f, F) AND meval(mpol(f))(xs) = 0)
END sector_rep
