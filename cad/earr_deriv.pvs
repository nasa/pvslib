earr_deriv: THEORY
%----------------------------------------------------------------------------
% The formal derivative of a coefficient list, as a real coefficient
% array.
%
% The second element of a Sturm sequence is the derivative of the first, and
% Sturm@sturm asks for that as an equality of coefficient arrays, not only of
% the polynomials they denote.  lderiv is the derivative of a list of mpoly
% coefficients in the main variable (mpoly_univ's deriv_list applied to the tail
% of the list) and earr_deriv says the array it denotes at a valuation is
% exactly NASALib's poly_deriv of the array of the original list.  The two
% degree facts are what the first steps of the sequence need: the derivative
% is one shorter, and its leading coefficient is nonzero whenever the leading
% coefficient of the polynomial is and the polynomial is not constant.
%----------------------------------------------------------------------------
BEGIN
  IMPORTING prem_arr

  l: VAR list[mpoly]
  ys: VAR list[real]
  i, k: VAR nat
  x: VAR real

  lderiv(l): list[mpoly] = IF null?(l) THEN null[mpoly] ELSE deriv_list(cdr(l), 1) ENDIF

  nth_cdr_earr: LEMMA cons?(l) AND i + 1 < length(l) IMPLIES nth(cdr(l), i) = nth(l, i + 1)
  lderiv_length: LEMMA length(lderiv(l)) = IF null?(l) THEN 0 ELSE length(l) - 1 ENDIF
  earr_deriv_at: LEMMA earr(lderiv(l), ys)(i) = poly_deriv(earr(l, ys))(i)
  earr_deriv: THEOREM earr(lderiv(l), ys) = poly_deriv(earr(l, ys))
  dg_lderiv: LEMMA length(l) >= 2 IMPLIES dg(lderiv(l)) = dg(l) - 1
  earr_deriv_lead: LEMMA length(l) >= 2 AND meval(llast(l))(ys) /= 0 IMPLIES
    earr(lderiv(l), ys)(dg(lderiv(l))) /= 0
END earr_deriv
