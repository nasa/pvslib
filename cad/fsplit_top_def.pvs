fsplit_top_def: THEORY
%----------------------------------------------------------------------------
% The input family over a checked basis, executable.
%
% For a family F (members are coefficient lists in the main variable),
% ubs(F) lists its members as polynomials.  When every u in ubs(F) passes
% mpoly_cert_def's check over B = basis(ubs(F)) (u = c * product of b^e over
% B), the sign of u at a point is sign(c) times the product of the signs of
% the b^e there: sce(B)(u) is that cofactor sign with the exponents, and
% smap(L) turns the basis' sign vector into F's.  spsi(L, Psi) is the matrix
% Psi read through smap(L).  fsplit_top proves that the sentence over F and
% Psi means the same as the one over fam(B) and spsi(L, Psi) (sem_split).
%----------------------------------------------------------------------------
BEGIN
  IMPORTING col_tower_def

  F: VAR list[list[mpoly]]
  B: VAR list[mpoly]
  u: VAR mpoly
  e: VAR nat
  E: VAR list[nat]
  s: VAR Sign3
  v: VAR list[Sign3]
  L: VAR list[[Sign3, list[nat]]]
  Psi: VAR [list[Sign3] -> bool]

  ubs(F): list[mpoly] = map(LAMBDA (f: list[mpoly]): mpol(f))(F)

  %% the sign of s^e, and of the product of the v_i^(E_i)
  spw(s, e): RECURSIVE Sign3 = IF e = 0 THEN 1 ELSE s * spw(s, e - 1) ENDIF
  MEASURE e
  sprd(v, E): RECURSIVE Sign3 =
    IF null?(v) OR null?(E) THEN 1 ELSE spw(car(v), car(E)) * sprd(cdr(v), cdr(E)) ENDIF
  MEASURE length(v)

  %% u's cofactor sign and exponents over B; F's sign vector from the basis' one
  sce(B)(u): [Sign3, list[nat]] = (sign3(ccof(u, B, exps(u, B))), exps(u, B))
  smap(L)(v): list[Sign3] = map(LAMBDA (ce: [Sign3, list[nat]]): ce`1 * sprd(v, ce`2))(L)
  spsi(L, Psi): [list[Sign3] -> bool] = LAMBDA (v: list[Sign3]): Psi(smap(L)(v))
END fsplit_top_def
