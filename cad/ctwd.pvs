ctwd: THEORY
%----------------------------------------------------------------------------
% The derivative-closed Collins tower is a CAD.
%
%   pstower_cad  col_tower's ptower_cad for a chain in which each family
%                CONTAINS the projection of the next (schain?): sign-
%                invariance on the stack cells passes from a family to the
%                projection it contains (sinv_sub)
%   ctwd_cad     ctwd(F, k, d) is a CAD over every connected set on which the
%                projection of its lowest family is sign-invariant
%   ctwd_dcl     its lowest d families are closed under the derivative
%                (dclx?, ctwd_def's executable check)
%----------------------------------------------------------------------------
BEGIN
  IMPORTING ctwd_def, col_tower, qe2_def, qe_thom, map_member[list[mpoly], list[list[mpoly]]],
            structures@list2set_props

  g, h: VAR list[mpoly]
  G, H, F: VAR list[list[mpoly]]
  L: VAR list[list[list[mpoly]]]
  TW: VAR Tower
  C: VAR [list[real] -> bool]
  p, q: VAR list[real]
  k, d, j, n: VAR nat

  %% ---- the derivative closure ---------------------------------------------------------------
  dch_self: LEMMA member(g, dch(g))
  dch_lder: LEMMA FORALL (n: nat): FORALL g, h: length(g) <= n AND member(h, dch(g)) AND length(h) >= 2
    IMPLIES member(lderiv(h), dch(g))
  dflat_mem: LEMMA FORALL L: member(h, dflat(L)) IFF EXISTS (l: list[list[mpoly]]): member(l, L) AND member(h, l)
  dclf_sup: LEMMA member(g, G) IMPLIES member(g, dclf(G))
  dclf_dcl: LEMMA dcl?(dclf(G))
  pr: VAR [list[mpoly] -> bool]
  every_intro_l: LEMMA FORALL G: (FORALL g: member(g, G) IMPLIES pr(g)) IMPLIES every(pr)(G)
  dclf_dclx: LEMMA dclx?(dclf(G))

  %% ---- chains whose families contain the projection of the next -----------------------------
  schain?(TW): RECURSIVE bool =
    IF null?(TW) OR null?(cdr(TW)) THEN TRUE
    ELSE (FORALL g: member(g, pdown(car(cdr(TW)))) IMPLIES member(g, car(TW))) AND schain?(cdr(TW))
    ENDIF
  MEASURE length(TW)

  svec_memsign: LEMMA FORALL G: member(g, G) AND svec(G, p) = svec(G, q)
    IMPLIES sign3(meval(mpol(g))(p)) = sign3(meval(mpol(g))(q))
  svec_allsign: LEMMA FORALL H: (FORALL g: member(g, H) IMPLIES sign3(meval(mpol(g))(p)) = sign3(meval(mpol(g))(q)))
    IMPLIES svec(H, p) = svec(H, q)
  sinv_sub: LEMMA (FORALL g: member(g, H) IMPLIES member(g, G)) AND sinv?(G, C) IMPLIES sinv?(H, C)

  pstower_cad: THEOREM FORALL TW: FORALL C: schain?(TW) AND conn?(C)
    AND (cons?(TW) IMPLIES sinv?(pdown(car(TW)), C)) IMPLIES cad_over?(TW, C)

  %% ---- the tower ------------------------------------------------------------------------------
  T1, T2: VAR Tower
  dnf_sup: LEMMA member(g, pdown(F)) IMPLIES member(g, dnf(F, k, d))
  schain_app: LEMMA FORALL TW: schain?(TW) AND (cons?(TW) IMPLIES FORALL g: member(g, pdown(G)) IMPLIES member(g, tlast(TW)))
    IMPLIES schain?(append(TW, (: G :)))
  every_app_l: LEMMA FORALL T1: every(dclx?)(append(T1, T2)) IFF (every(dclx?)(T1) AND every(dclx?)(T2))
  ttake_app: LEMMA FORALL T1: FORALL j: j <= length(T1) IMPLIES ttake(append(T1, T2), j) = ttake(T1, j)
  ttake_full: LEMMA FORALL T1: ttake(T1, length(T1)) = T1
  ctwd_len: LEMMA FORALL k: FORALL F: length(ctwd(F, k, d)) = k
  ctwd_tlast: LEMMA FORALL k: FORALL F: k >= 1 IMPLIES tlast(ctwd(F, k, d)) = F
  ctwd_schain: LEMMA FORALL k: FORALL F: schain?(ctwd(F, k, d))
  ctwd_cad: THEOREM conn?(C) AND (k >= 1 IMPLIES sinv?(pdown(car(ctwd(F, k, d))), C))
    IMPLIES cad_over?(ctwd(F, k, d), C)

  ctwd_dclall: LEMMA FORALL j: FORALL G: j <= d AND dclx?(G) IMPLIES every(dclx?)(ctwd(G, j, d))
  ctwd_dcl: LEMMA FORALL k: FORALL F: d < k IMPLIES every(dclx?)(ttake(ctwd(F, k, d), d))

  %% the executable check dclx? is dcl? (qe_thom)
  every_mem_l: LEMMA FORALL G: every(pr)(G) AND member(g, G) IMPLIES pr(g)
  dclx_dcl: LEMMA dclx?(G) IMPLIES dcl?(G)
  every_dclx: LEMMA FORALL TW: every(dclx?)(TW) IMPLIES every(dcl?)(TW)
END ctwd
