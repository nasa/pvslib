alg_zero: THEORY
%----------------------------------------------------------------------------
% Deciding whether a rational polynomial q vanishes at an algebraic number
% a = (p, [lb, ub]).
%
% A common root of p and q in [lb, ub] is a root of p there, hence value(a);
% and x is a common root iff p(x)^2 + q(x)^2 = 0. So q(value(a)) = 0 iff the
% sum of squares has a root in [lb, ub], which the Sturm counter decides.
% The sum of squares is built at the integer-array level (isq is
% polynomial_prod with integer typing); its degree is 2 max(deg p, deg q)
% and its leading coefficient is a positive sum of squares of leading
% coefficients, which is what the counter needs.
%----------------------------------------------------------------------------
BEGIN
  IMPORTING poly_gcd

  P, Q: VAR [nat -> int]
  n, m, i, k: VAR nat
  x, z: VAR real
  pl, ql: VAR Polylist
  a: VAR alg
  lb, ub: VAR rat

  %% the square of an integer polynomial of degree n
  isq(P, n)(i): int = sigma(max(i - n, 0), n, LAMBDA k: IF k <= i THEN P(k) * P(i - k) ELSE 0 ENDIF)
  isq_prod: LEMMA isq(P, n)(i) = polynomial_prod(P, n, P, n)(i)
  isq_fun: LEMMA isq(P, n) = polynomial_prod(P, n, P, n)
  isq_top: LEMMA isq(P, n)(2 * n) = P(n) * P(n)
  isq_above: LEMMA i > 2 * n IMPLIES isq(P, n)(i) = 0
  isq_eval: LEMMA polynomial(isq(P, n), 2 * n)(x) = polynomial(P, n)(x) * polynomial(P, n)(x)
  isq_eval_ext: LEMMA k >= 2 * n IMPLIES polynomial(isq(P, n), k)(x) = polynomial(P, n)(x) * polynomial(P, n)(x)

  %% the integer form of a Polylist of any degree still evaluates to a positive multiple
  polylist_deg0: LEMMA deg(pl) = 0 IMPLIES polylist(pl)(x) = nth(pl, 0)
  ipoly_eval_any: LEMMA EXISTS (cp: posrat): polynomial(ipoly(pl), deg(pl))(x) = cp * polylist(pl)(x)
  ipoly_root_any: LEMMA polynomial(ipoly(pl), deg(pl))(x) = 0 IFF polylist(pl)(x) = 0

  %% the sum of the squares of the integer forms of pl and ql
  sos(pl, ql): [nat -> int] = LAMBDA i: isq(ipoly(pl), deg(pl))(i) + isq(ipoly(ql), deg(ql))(i)
  sosdeg(pl, ql): nat = 2 * max(deg(pl), deg(ql))
  sos_lc: LEMMA deg(pl) > 0 IMPLIES sos(pl, ql)(sosdeg(pl, ql)) > 0
  sos_eval: LEMMA polynomial(sos(pl, ql), sosdeg(pl, ql))(x) =
    polynomial(ipoly(pl), deg(pl))(x) * polynomial(ipoly(pl), deg(pl))(x) +
    polynomial(ipoly(ql), deg(ql))(x) * polynomial(ipoly(ql), deg(ql))(x)
  sos_root: LEMMA polynomial(sos(pl, ql), sosdeg(pl, ql))(x) = 0 IFF polylist(pl)(x) = 0 AND polylist(ql)(x) = 0

  %% the decision.  The common roots of p and q are the roots of their gcd
  %% (poly_gcd), so q vanishes at value(a) iff the gcd has a root in
  %% [lb, ub]: Euclid on the two polynomials, where the sum of squares builds
  %% a Sturm chain of twice the larger degree (0.31 s per test on one
  %% three-variable benchmark).  The sum of squares stays as the fallback if Euclid runs out
  %% of fuel.
  zero_sos(a: Alg, ql): bool = nroots_a(sos(a`p, ql), sosdeg(a`p, ql), a`lb, a`ub) >= 1
  zero_sos_def: THEOREM alg?(a) IMPLIES (zero_sos(a, ql) IFF polylist(ql)(value(a)) = 0)
  zero_at(a: Alg, ql): bool =
    LET r = pgcd(length(a`p) + length(ql) + 2, a`p, ql) IN
    IF NOT r`ok THEN zero_sos(a, ql)
    ELSIF deg(r`g) = 0 THEN nth(r`g, 0) = 0
    ELSE nroots(r`g, a`lb, a`ub) >= 1
    ENDIF
  zero_at_def: THEOREM alg?(a) IMPLIES (zero_at(a, ql) IFF polylist(ql)(value(a)) = 0)
END alg_zero
