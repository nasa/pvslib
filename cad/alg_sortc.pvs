alg_sortc: THEORY
%----------------------------------------------------------------------------
% alg_sortc_def's comparison is right.
%
%   refc_a     refc bisects as refine does; refc_value keeps the value
%   com_root   two algebraic numbers are equal iff their polynomials have a
%              common root in the common part of the intervals
%   gcd_eq     a polynomial whose roots are the common roots decides it
%   eqg_def    so the gcd test decides equality (pgcd_root)
%   sepc_def   for different values, sepc says which is smaller
%   cmpc_def   cmpc(fuel, c, d) = sign3(value(c`a) - value(d`a))
%   sepall_vals  separating neighbours keeps the list of values
%----------------------------------------------------------------------------
BEGIN
  IMPORTING alg_sortc_def

  a, b: VAR Alg
  c, d: VAR CA
  fuel: VAR nat
  pl: VAR Polylist
  lb, ub, lo, hi: VAR rat

  refc_a: LEMMA refc(c)`a = refine(c`a)
  refc_value: LEMMA value(refc(c)`a) = value(c`a)

  com_root: LEMMA lo = max(a`lb, b`lb) AND hi = min(a`ub, b`ub) IMPLIES
    (value(a) = value(b) IFF
     EXISTS (w: real): lo <= w AND w <= hi AND polylist(a`p)(w) = 0 AND polylist(b`p)(w) = 0)
  g: VAR Polylist
  gcd_eq: LEMMA (FORALL (x: real): (polylist(a`p)(x) = 0 AND polylist(b`p)(x) = 0) IFF polylist(g)(x) = 0)
    AND NOT zp?(g) AND lo = max(a`lb, b`lb) AND hi = min(a`ub, b`ub) AND lo <= hi IMPLIES
    (value(a) = value(b) IFF
     IF deg(g) = 0 THEN FALSE ELSIF lo = hi THEN polylist(g)(lo) = 0 ELSE nroots(g, lo, hi) >= 1 ENDIF)
  eqg_def: LEMMA eqg(a, b) IFF value(a) = value(b)

  sepc_def: LEMMA FORALL fuel: FORALL c, d: value(c`a) /= value(d`a) IMPLIES
    (sepc(fuel, c, d) IFF value(c`a) < value(d`a))
  cmpc_def: LEMMA FORALL fuel: FORALL c, d: cmpc(fuel, c, d) = sign3(value(c`a) - value(d`a))

  sepcc_val: LEMMA FORALL fuel: FORALL c, d:
    value(sepcc(fuel, c, d)`sa`a) = value(c`a) AND value(sepcc(fuel, c, d)`sb`a) = value(d`a)
  L: VAR list[CA]
  mapv_cons: LEMMA map(LAMBDA (e: CA): value(e`a))(cons(c, L)) = cons(value(c`a), map(LAMBDA (e: CA): value(e`a))(L))
  len2_alg_sortc: LEMMA cons?(L) AND cons?(cdr(L)) IMPLIES length(cons(c, cdr(cdr(L)))) < length(L)
  sepall_vals: LEMMA FORALL L: map(LAMBDA (e: CA): value(e`a))(sepall(L)) = map(LAMBDA (e: CA): value(e`a))(L)
END alg_sortc
