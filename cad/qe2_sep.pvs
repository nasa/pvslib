qe2_sep: THEORY
%----------------------------------------------------------------------------
% With derivative-closed free families, the signatures of a sector's free
% cells always separate.
%
% fp_tsame: two points with the same signature on fpolys(TW, m) have the
% same sign vector on every free family at its own level (fpolys is the
% free families lifted to the point, one block per level; fpl_same).  So if
% the free part of the tower, ttake(TW, m - 1), has derivative-closed
% families, two free cells whose records' signatures agree are the same cell
% (qe_tsep's tcell_sep, with rec_over and sig_at_rec of qe2_ok), and entries
% with equal signatures have equal keys, hence equal values: sep2? holds
% (ents_sep).
%----------------------------------------------------------------------------
BEGIN
  IMPORTING qe2_ok, qe_tsep

  m: VAR posnat
  i, j: VAR nat
  qb: VAR list[bool]
  F: VAR list[list[mpoly]]
  Psi: VAR [SV -> bool]
  TW: VAR Tower
  C: VAR [list[real] -> bool]
  L: VAR list[ORec]
  A: VAR list[nat]
  p1, p2: VAR list[real]
  e1, e2: VAR QE2
  es2: VAR list[QE2]

  %% ---- lists --------------------------------------------------------------------------------------
  w1, w2, v1, v2: VAR SV
  app_eq: LEMMA FORALL w1, w2: length(w1) = length(w2) AND append(w1, v1) = append(w2, v2)
    IMPLIES w1 = w2 AND v1 = v2
  nth_ttake: LEMMA FORALL TW: FORALL i, j: i < j AND j <= length(TW) IMPLIES nth(ttake(TW, j), i) = nth(TW, i)
  over_ttake: LEMMA FORALL TW: FORALL C, j: cad_over?(TW, C) IMPLIES cad_over?(ttake(TW, j), C)
  pe: VAR [QE2 -> bool]
  every_intro: LEMMA FORALL es2: (FORALL e2: member(e2, es2) IMPLIES pe(e2)) IMPLIES every(pe)(es2)

  %% ---- the signature on the free families -----------------------------------------------------------
  G2: VAR list[list[mpoly]]
  d: VAR nat
  sigv_lift: LEMMA sigv(map(LAMBDA (g: list[mpoly]): liftp(mpol(g), d))(G2), p1) = svec(G2, dropn(d, p1))
  fpl_same: LEMMA FORALL TW: FORALL j: sigv(fpl(TW, m, j), p1) = sigv(fpl(TW, m, j), p2) IMPLIES
    FORALL i: i < length(TW) AND i + j + 1 < m IMPLIES
      svec(nth(TW, i), dropn(m - j - i - 2, p1)) = svec(nth(TW, i), dropn(m - j - i - 2, p2))
  fp_tsame: LEMMA length(TW) >= m - 1 AND sigv(fpolys(TW, m), p1) = sigv(fpolys(TW, m), p2)
    IMPLIES tsame?(ttake(TW, m - 1), p1, p2)

  %% ---- separating entries give a quantifier-free answer -------------------------------------------
  G: VAR list[mpoly]
  w: VAR SV
  cf: VAR [list[nat] -> Fm]
  ff: VAR Fm
  qf_gatoms: LEMMA FORALL G: FORALL w: member(ff, gatoms(G, w)) IMPLIES qf?(ff)
  W: VAR list[SV]
  qf_orlg: LEMMA qf?(f_orl(map(LAMBDA (v: SV): f_andl(gatoms(G, v)))(W)))
  qf_secsig: LEMMA sep2?(es2) IMPLIES qf?(secsig(G, es2, cf))
  qf_secoutE: LEMMA sep2?(es2) IMPLIES qf?(secoutE(G, es2, cf))

  %% ---- the entries separate -------------------------------------------------------------------------
  %% a key's record gives a point of its free cell, where the entry's signature is the signature
  key_pt: LEMMA length(TW) = m - 1 + length(qb) AND cad_over?(TW, C) AND recin?(TW, C, F, L)
    AND (FORALL (r: ORec): member(r, L) IMPLIES wf?(r`rsod)) AND member(A, fkeys(m, L))
    IMPLIES length(A) = m - 1 AND
      EXISTS (pt: list[real]): tcell(ttake(TW, m - 1), C, A)(pt)
        AND sigat(fpolys(TW, m), length(qb), recof(A, m, L)) = sigv(fpolys(TW, m), pt)
  ents_sep: LEMMA length(TW) = m - 1 + length(qb) AND cad_over?(TW, C) AND recin?(TW, C, F, L)
    AND (FORALL (r: ORec): member(r, L) IMPLIES wf?(r`rsod))
    AND every(dcl?)(ttake(TW, m - 1))
    IMPLIES sep2?(ents2(m, qb, Psi, fpolys(TW, m), L))
END qe2_sep
