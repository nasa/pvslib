%----------------------------------------------------------------------------
% Sign-condition branch trees.
%
% A btree[T] is the shape of a computation that is symbolic in the parameters:
% at each node it branches on the sign of a multivariate polynomial in the
% parameters, and each leaf carries a result of type T. Evaluating the tree at
% a valuation of the parameters follows one path; enumerating its leaves with
% their path conditions gives a finite disjunction, which is the
% quantifier-free formula the elimination produces.
%----------------------------------------------------------------------------
btree[T: TYPE]: DATATYPE
BEGIN
  IMPORTING mpoly
  bleaf(bval: T): bleaf?
  bnode(bpol: mpoly, bneg: btree, bzer: btree, bpos: btree): bnode?
END btree
