branch_norm: THEORY
%----------------------------------------------------------------------------
% Determining the degree symbolically.
%
% A polynomial in the eliminated variable x is a list of mpoly coefficients in
% the parameters, lowest degree first; its value at a real point x and a real
% valuation ys of the parameters is meval(mpol(l))(cons(x, ys)). Its degree is
% not determined by the syntax, because the leading coefficient may vanish for
% some ys. snorm branches on the sign of the last coefficient: where it is
% zero the coefficient is dropped and the question repeats, and where it is
% not the degree is settled. So on every branch the leading coefficient is
% known nonzero, which is the hypothesis every step of the Sturm-Tarski
% algorithm needs, and the polynomial is unchanged as a function.
%----------------------------------------------------------------------------
BEGIN
  IMPORTING mpoly_pdiv, branch_tree[list[mpoly]]

  l, l1: VAR list[mpoly]
  ys: VAR list[real]
  x: VAR real
  c: VAR mpoly

  %% the value of a coefficient list at a point and a valuation of the parameters
  pval(l, ys)(x): real = meval(mpol(l))(cons(x, ys))

  snorm(l): RECURSIVE btree[list[mpoly]] =
    IF null?(l) THEN bleaf(null[mpoly])
    ELSE bnode(llast(l), bleaf(l), snorm(lbut(l)), bleaf(l)) ENDIF
  MEASURE length(l)

  snorm_null: LEMMA null?(l) IMPLIES snorm(l) = bleaf(null[mpoly])
  snorm_cons: LEMMA cons?(l) IMPLIES snorm(l) = bnode(llast(l), bleaf(l), snorm(lbut(l)), bleaf(l))

  %% the normalized list is shorter, has the same value, and a nonzero leading coefficient
  snorm_length: LEMMA length(select(snorm(l), ys)) <= length(l)
  snorm_eval: THEOREM pval(select(snorm(l), ys), ys)(x) = pval(l, ys)(x)
  snorm_lc: THEOREM null?(select(snorm(l), ys)) OR meval(llast(select(snorm(l), ys)))(ys) /= 0
END branch_norm
