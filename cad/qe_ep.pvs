qe_ep: THEORY
%----------------------------------------------------------------------------
% qe_ep_def's comparisons are correct.
%
% Under epok?: a rational record names value(b) (ep_rat); an isolated one
% puts value(b) strictly inside (elb, eub) as a root of eq (ep_in), the only
% one there (ep_only), and eq keeps the sign it has at elb exactly on the
% part of [elb, eub] below value(b) (ep_side: no root of eq between, so the
% sign is constant -- same_sign -- and the signs at the two ends differ).
% So ltQ, eqQ, gtQ are x < value(b), x = value(b), x > value(b), and
% quantifier-free; cmpX is the sign condition on x - value(b) (from them, or
% from cmpF when the check fails), and sectX(s) is in?(s, x).
%----------------------------------------------------------------------------
BEGIN
  IMPORTING qe_ep_def, rcf_cells, cad_endgame

  b: VAR Alg
  e: VAR EP
  x, z: VAR real
  ys: VAR list[real]
  r: VAR rat
  t: VAR int
  s: VAR Sect

  linp_sem: LEMMA meval(mpol(linp(r)))(cons(x, ys)) = x - r
  eq_sem: LEMMA meval(mpol(pmc(e`eq)))(cons(x, ys)) = polylist(e`eq)(x)

  ep_rat: LEMMA epok?(b)(e) AND e`ek = 0 IMPLIES value(b) = e`er
  ep_in: LEMMA epok?(b)(e) AND e`ek /= 0 IMPLIES
    e`elb < value(b) AND value(b) < e`eub AND polylist(e`eq)(value(b)) = 0
  ep_only: LEMMA epok?(b)(e) AND e`ek /= 0 AND e`elb <= z AND z <= e`eub AND polylist(e`eq)(z) = 0
    IMPLIES z = value(b)
  ep_ends: LEMMA epok?(b)(e) AND e`ek /= 0 IMPLIES
    polylist(e`eq)(e`elb) /= 0 AND sign3(polylist(e`eq)(e`eub)) /= sign3(polylist(e`eq)(e`elb))
  ep_side: LEMMA epok?(b)(e) AND e`ek /= 0 AND e`elb <= x AND x <= e`eub IMPLIES
    (x < value(b) IFF sign3(polylist(e`eq)(x)) = sign3(polylist(e`eq)(e`elb)))

  ltQ_ok: LEMMA epok?(b)(e) IMPLIES (qfsem(ltQ(e))(cons(x, ys)) IFF x < value(b))
  eqQ_ok: LEMMA epok?(b)(e) IMPLIES (qfsem(eqQ(e))(cons(x, ys)) IFF x = value(b))
  gtQ_ok: LEMMA epok?(b)(e) IMPLIES (qfsem(gtQ(e))(cons(x, ys)) IFF x > value(b))
  qf_ltQ: LEMMA qf?(ltQ(e))
  qf_eqQ: LEMMA qf?(eqQ(e))
  qf_gtQ: LEMMA qf?(gtQ(e))

  cmpX_ok: LEMMA (t = -1 OR t = 0 OR t = 1) IMPLIES (qfsem(cmpX(b, t))(cons(x, ys)) IFF sign3(x - value(b)) = t)
  cmpX_fsem: LEMMA (t = -1 OR t = 0 OR t = 1) IMPLIES (fsem(cmpX(b, t))(cons(x, ys)) IFF sign3(x - value(b)) = t)
  sectX_ok: LEMMA qfsem(sectX(s))(cons(x, ys)) IFF in?(s, x)
END qe_ep
