bform: THEORY
%----------------------------------------------------------------------------
% Boolean formulas over sign atoms.
%
% An atom names a polynomial of the family by its index and asks for a
% sign; the connectives are the usual ones. bfeval is the semantics at a
% point, bfsv the same read off a sign vector: they agree on the sign
% vector of the family at the point (bfsv_svec), which is what the
% cylindrical decision evaluates at the leaves.
%----------------------------------------------------------------------------
BEGIN
  IMPORTING sign_vec

  BF: DATATYPE
  BEGIN
    batom(idx: nat, sg: int): batom?
    bnot(arg: BF): bnot?
    band(a1: BF, a2: BF): band?
    bor(o1: BF, o2: BF): bor?
  END BF

  phi: VAR BF
  F: VAR list[list[mpoly]]
  xs: VAR list[real]
  v: VAR list[Sign3]

  bfeval(phi, F, xs): RECURSIVE bool =
    CASES phi OF
      batom(i, s): i < length(F) AND sign3(meval(mpol(nth(F, i)))(xs)) = s,
      bnot(a): NOT bfeval(a, F, xs),
      band(a, b): bfeval(a, F, xs) AND bfeval(b, F, xs),
      bor(a, b): bfeval(a, F, xs) OR bfeval(b, F, xs)
    ENDCASES
  MEASURE phi BY <<

  bfsv(phi, v): RECURSIVE bool =
    CASES phi OF
      batom(i, s): i < length(v) AND nth(v, i) = s,
      bnot(a): NOT bfsv(a, v),
      band(a, b): bfsv(a, v) AND bfsv(b, v),
      bor(a, b): bfsv(a, v) OR bfsv(b, v)
    ENDCASES
  MEASURE phi BY <<

  bfsv_svec: LEMMA bfsv(phi, svec(F, xs)) IFF bfeval(phi, F, xs)
END bform
