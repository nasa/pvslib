pl_shift: THEORY
%----------------------------------------------------------------------------
% pl_shift_def's Taylor shift is right.
%
%   plh_one / plh_cons   a constant, and Horner's step, for polylist
%   pshift_sem           pshift(pl, m) at t is pl at m + t
%----------------------------------------------------------------------------
BEGIN
  IMPORTING pl_shift_def

  pl: VAR Polylist
  c, m: VAR rat
  x, t: VAR real

  plh_one: LEMMA polylist((: c :))(x) = c
  plh_cons: LEMMA polylist(cons(c, pl))(x) = c + x * polylist(pl)(x)
  pshift_sem: LEMMA FORALL pl: polylist(pshift(pl, m))(t) = polylist(pl)(m + t)
END pl_shift
