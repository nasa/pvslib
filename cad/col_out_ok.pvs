col_out_ok: THEORY
%----------------------------------------------------------------------------
% The Collins run's records are its CAD, from
% cad_out_ok's lemmas on one level (kids_lvl) under the walk's certificate
% okw_o.
%
%   ctree_inw     every record of a certified tree has a well formed sample
%                 in the cell its stack indices name
%   ctree_coverw  over a base cell where the tower is a CAD, every nonempty
%                 cell of the tower has a record
%   cad_outc_ok   when decc_o's certificate holds, every record of cad_outc
%                 lies in its cell of col_run's CAD and carries F's sign
%                 vector there, and every nonempty cell has a record
%----------------------------------------------------------------------------
BEGIN
  IMPORTING col_out, col_run, decc_ok, cad_out_ok

  u: VAR nat
  TW: VAR Tower
  TB: VAR list[CT]
  od: VAR OD
  C: VAR [list[real] -> bool]
  r: VAR CRec
  A: VAR list[nat]
  qs: VAR list[bool]
  F: VAR list[list[mpoly]]
  Psi: VAR [SV -> bool]
  s: VAR Sect
  o: VAR ORec
  q: VAR list[real]

  %% the tree's certificate: okw_o on a long enough table list
  oktw?(u, TW, TB, od): bool = vtb?(TB) AND length(TB) >= length(TW) AND okw_o(u, TW, TB, od)

  ctree_inw: LEMMA FORALL TW: FORALL TB, od, C, r: cons?(TW) AND oktw?(u, TW, TB, od) AND wf?(od)
    AND C(den(od)) AND member(r, ctree(u, TW, TB, od))
    IMPLIES length(r`adr) = length(TW) AND wf?(r`sod) AND tcell(TW, C, r`adr)(den(r`sod))

  ctree_coverw: LEMMA FORALL TW: FORALL TB, od, C, A: cons?(TW) AND oktw?(u, TW, TB, od) AND wf?(od)
    AND C(den(od)) AND cad_over?(TW, C) AND length(A) = length(TW)
    AND (EXISTS q: tcell(TW, C, A)(q))
    IMPLIES EXISTS r: member(r, ctree(u, TW, TB, od)) AND r`adr = A

  %% ---- the run ----------------------------------------------------------------------------------
  cad_outc_mem: LEMMA length(qs) >= 2 IMPLIES
    (member(o, cad_outc(u, qs, F)) IFF
       EXISTS s, r: member(s, csects(length(cdr(qs)), F))
         AND member(r, ctree(u, ctw(F, length(cdr(qs))),
                             tables(u, ctw(F, length(cdr(qs))), odS(s)), odS(s)))
         AND o = (# rsec := s, radr := r`adr, rsod := r`sod, rsv := osv_of(F, r`sod) #))

  %% each sector's tree is certified and starts at the sector's sample
  csector_okt: LEMMA decc_o(u, qs, F, Psi)`ok AND length(qs) >= 2 AND member(s, csects(length(cdr(qs)), F))
    IMPLIES oktw?(u, ctw(F, length(cdr(qs))), tables(u, ctw(F, length(cdr(qs))), odS(s)), odS(s))
      AND scell(s)(den(odS(s)))

  cad_outc_ok: THEOREM decc_o(u, qs, F, Psi)`ok AND length(qs) >= 2 IMPLIES
    LET k = length(cdr(qs)) IN
        (FORALL o: member(o, cad_outc(u, qs, F)) IMPLIES
           member(o`rsec, csects(k, F)) AND length(o`radr) = k
           AND ccell(k, F)(o`rsec, o`radr)(den(o`rsod))
           AND o`rsv = svec(F, den(o`rsod)))
    AND (FORALL s, A: member(s, csects(k, F)) AND length(A) = k
           AND (EXISTS q: ccell(k, F)(s, A)(q))
           IMPLIES EXISTS o: member(o, cad_outc(u, qs, F)) AND o`rsec = s AND o`radr = A)
END col_out_ok
