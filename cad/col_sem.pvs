col_sem: THEORY
%----------------------------------------------------------------------------
% The truth of a formula over a Collins CAD.
%
%   sidx_onto  over a delineable family every stack index taken over one
%              point of C is taken over every other (sec_in)
%   sem_cad    the truth of the inner quantifiers is the same at all points
%              of a base cell over which the tower is a CAD (cad_over?): at
%              each level the stack indices taken are the same, and the cell
%              of each index is a CAD base for the rest of the tower
%   rf_sidx    a root-free interval of a level's product lies in one stack
%              cell, so (rfc_cad) the inner truth is constant there -- the
%              hypothesis cvl's bfold_cvl needs to read a quantifier from the
%              walk's separators and sections (sem_cvlc)
%   sinv_sect  the outer family is sign-invariant on each of its sectors
%              (sect_svec through the sector's rational sample)
%----------------------------------------------------------------------------
BEGIN
  IMPORTING col_tower, cad_run, sect_svec, cad_decide

  G, Q: VAR list[list[mpoly]]
  TW, TW1: VAR Tower
  C: VAR [list[real] -> bool]
  p, q, ws, p1, p2: VAR list[real]
  y, y0, x: VAR real
  qs, qs1: VAR list[bool]
  q0: VAR bool
  Psi: VAR [SV -> bool]
  Y: VAR list[rat]
  s: VAR Sect
  a: VAR nat

  %% ---- stack indices -------------------------------------------------------------------------
  sidx_onto: LEMMA delin_cl?(G, C) AND C(p) AND C(q) IMPLIES
    EXISTS (y1: real): sidx(G, q, y1) = sidx(G, p, y)
  stk_at: LEMMA C(p) IMPLIES stk(G, C, sidx(G, p, y))(cons(y, p))

  %% ---- the truth is constant on a cell -------------------------------------------------------
  sem_cad: LEMMA FORALL TW: FORALL qs, C, p, q: cons?(TW) AND length(qs) = length(TW)
    AND cad_over?(TW, C) AND C(p) AND C(q)
    IMPLIES (sem(qs, tlast(TW), Psi, p) IFF sem(qs, tlast(TW), Psi, q))

  %% ---- root-free intervals ------------------------------------------------------------------
  L: VAR list[real]
  nlt_eq: LEMMA FORALL L: (FORALL (w: real): member(w, L) IMPLIES NOT (min(y0, y) <= w AND w <= max(y0, y)))
    IMPLIES nlt(L, y) = nlt(L, y0)
  rf_sidx: LEMMA wok?(zf(G, ws), msg(ws), Y) AND P(zf(G, ws), ws)(y0) /= 0 AND rootfree?(zf(G, ws), ws, y0, y)
    IMPLIES sidx(G, ws, y) = sidx(G, ws, y0)

  vs: VAR list[real]
  %% ---- the truth of the level at a point is the fold of its cell values ------------------
  Tv(qs1, TW1, Psi, vs)(y): bool = sem(qs1, tlast(TW1), Psi, cons(y, vs))

  rfc_cad: LEMMA cad_over?(cons(G, TW1), C) AND cons?(TW1) AND length(qs1) = length(TW1) AND C(ws)
    AND wok?(zf(G, ws), msg(ws), Y)
    IMPLIES rfc?(Tv(qs1, TW1, Psi, ws), zf(G, ws), ws, Y)
  %% so the fold of the cell value list is the quantifier (cvl's bfold_cvl over a CAD)
  sem_cvlc: LEMMA cad_over?(cons(G, TW1), C) AND cons?(TW1) AND length(qs1) = length(TW1) AND C(ws)
    AND wok?(zf(G, ws), msg(ws), Y)
    IMPLIES (sem(cons(q0, qs1), tlast(TW1), Psi, ws) IFF
             bfold(q0, cvl(Tv(qs1, TW1, Psi, ws), zf(G, ws), ws, Y)))

  %% ---- the outer family on its sectors -------------------------------------------------------
  sinv_sect: LEMMA gaps_ok(rts(Q)) AND member(s, sects(rts(Q))) IMPLIES sinv?(Q, scell(s))
END col_sem
