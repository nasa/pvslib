qe1_ok: THEORY
%----------------------------------------------------------------------------
% Quantifier elimination for one free variable: the answer is correct.
%
% qe1_sJ_sem (any index set J; qe1_s_sem at minJ): if every entry's sector
% that contains x carries the truth value P and Q's sign vector at x, and
% some entry's sector contains x, then qe1_s's output holds at x iff P -- on
% the separating branch through the sign conditions (atoms_sem, sep1?), on
% the other through sectX_ok.  qe1_sm_sem: so does qe1_sm's, which may be the
% merged answer qe1_mo (mo_sem: qe_mrg's mrgX_sem on the sorted sectors,
% sects_chain and sortu_incr).  sig1_inv: Q's sign vector at a sector's
% sample is its sign vector on the whole sector.  qe1c_ok applies them to
% the Collins run.
%----------------------------------------------------------------------------
BEGIN
  IMPORTING qe_def, qe_ldd_ok[list[int]], qe_mrg, cad_out_ok, sect_svec, map_member[Sect, SC],
            map_member[SC, QEnt], map_member[QEnt, list[int]], map_member[list[int], Fm],
            map_member[QEnt, Fm]

  F, Q: VAR list[list[mpoly]]
  J: VAR list[nat]
  w: VAR list[int]
  v: VAR SV
  e: VAR QEnt
  es: VAR list[QEnt]
  pe: VAR [QEnt -> bool]
  x: VAR real
  pt: VAR list[real]
  s: VAR Sect
  P: VAR bool

  %% ---- lists --------------------------------------------------------------------------------
  filter_mem: LEMMA FORALL es: member(e, filter(pe)(es)) IFF (member(e, es) AND pe(e))
  every_mem_qe1_ok: LEMMA FORALL es: every(pe)(es) AND member(e, es) IMPLIES pe(e)
  sigJ_len: LEMMA FORALL J: length(sigJ(J, v)) = length(J)

  %% ---- the sign conditions ------------------------------------------------------------------
  a: VAR Fm
  atoms_all: LEMMA FORALL J: FORALL w: every(LAMBDA (j: nat): j < length(Q))(J) AND length(w) = length(J)
    IMPLIES ((FORALL (f: Fm): member(f, atomsF(Q, J, w)) IMPLIES qfsem(f)(pt)) IFF sigJ(J, svec(Q, pt)) = w)
  atoms_sem: LEMMA every(LAMBDA (j: nat): j < length(Q))(J) AND length(w) = length(J)
    IMPLIES (qfsem(sig1F(Q, J, w))(pt) IFF sigJ(J, svec(Q, pt)) = w)
  atoms_qf: LEMMA FORALL J: FORALL w: FORALL (f: Fm): member(f, atomsF(Q, J, w)) IMPLIES qf?(f)

  %% ---- the output from the entries (no engine) --------------------------------------------------
  qe1_sJ_sem: LEMMA
    (FORALL e: member(e, es) AND in?(e`esec, x) IMPLIES (e`ev IFF P) AND e`esig = svec(Q, (: x :)))
    AND (EXISTS e: member(e, es) AND in?(e`esec, x))
    IMPLIES (qfsem(qe1_sJ(Q, es, J)`out)((: x :)) IFF P)
  qe1_sJ_qf: LEMMA qe1_sJ(Q, es, J)`qf IMPLIES qf?(qe1_sJ(Q, es, J)`out)
  qe1_s_sem: LEMMA
    (FORALL e: member(e, es) AND in?(e`esec, x) IMPLIES (e`ev IFF P) AND e`esig = svec(Q, (: x :)))
    AND (EXISTS e: member(e, es) AND in?(e`esec, x))
    IMPLIES (qfsem(qe1_s(Q, es)`out)((: x :)) IFF P)
  qe1_s_qf: LEMMA qe1_s(Q, es)`qf IMPLIES qf?(qe1_s(Q, es)`out)

  %% ---- the merged answer ------------------------------------------------
  anyT_es: LEMMA FORALL es: anyT(map(LAMBDA (e: QEnt): e`esec)(es), map(LAMBDA (e: QEnt): e`ev)(es))(x)
    IFF EXISTS e: member(e, es) AND e`ev AND in?(e`esec, x)
  sox_sem: LEMMA qfsem(f_orl(map(LAMBDA (e: QEnt): sectX(e`esec))(filter(LAMBDA (e: QEnt): e`ev)(es))))((: x :))
    IFF EXISTS e: member(e, es) AND e`ev AND in?(e`esec, x)
  mo_sem: LEMMA qfsem(qe1_mo(Q, es))((: x :)) IFF EXISTS e: member(e, es) AND e`ev AND in?(e`esec, x)
  qe1_sm_sem: LEMMA
    (FORALL e: member(e, es) AND in?(e`esec, x) IMPLIES (e`ev IFF P) AND e`esig = svec(Q, (: x :)))
    AND (EXISTS e: member(e, es) AND in?(e`esec, x))
    IMPLIES (qfsem(qe1_sm(Q, es)`out)((: x :)) IFF P)
  qe1_sm_qf: LEMMA qe1_sm(Q, es)`qf IMPLIES qf?(qe1_sm(Q, es)`out)

  %% ---- the run's first level ------------------------------------------------------------------
  sig1_inv: LEMMA member(s, sects(rts(Q))) AND in?(s, value(sample(s))) AND in?(s, x)
    IMPLIES osv_of(Q, odS(s)) = svec(Q, (: x :))
END qe1_ok
