            SGI`multip * SGI`inv = Id(rows(S)) AND
             is_simple_prod?(rows(S), FALSE, FALSE)(SGI`inv)))
    AND (det(SGI`ans) = det(S))
    AND (det(S) /= 0 IFF
          (FORALL (k, p):
             k < rows(S) AND p < rows(S) IMPLIES
              (entry(SGI`ans)(k, p) /= 0 IFF k = p)))}"
     |matrix_diag| |matrices|)
