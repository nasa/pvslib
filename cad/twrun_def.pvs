twrun_def: THEORY
%----------------------------------------------------------------------------
% The Collins-style run over a given tower.
% Executable.
%
% decc_def's certificate and col_out's records for an arbitrary tower TW
% whose outer line is cut at the roots of the projection of its lowest
% family (cbot): the walk's certificate at every sector (twok) and one
% record per path of every sector's tree (cad_outw).  decc_o and cad_outc
% are these for TW = ctw(F, k); quantifier elimination with derivative-
% closed free levels uses them for ctwd(F, k, d).
%----------------------------------------------------------------------------
BEGIN
  IMPORTING decc_def, cad_out

  u: VAR nat
  TW: VAR Tower
  F: VAR list[list[mpoly]]

  twok(u, TW): bool =
    cons?(TW) AND gaps_ok(rts(cbot(TW))) AND every(okc?(u))(map(cscof(u, TW))(sects(rts(cbot(TW)))))

  cad_outw(u, F, TW): list[ORec] = olflat(map(LAMBDA (s: Sect): srecs(u, F, s, TW))(sects(rts(cbot(TW)))))
END twrun_def
