decb_def: THEORY
%----------------------------------------------------------------------------
% The Collins decision with the smaller bottom-step projection, executable.
%
% decb_o is decc_o with the line cut at the roots of cbotb(TW) =
% pdownb(car(TW)) (cad_projb_def's projb) instead of Collins' projection of
% the lowest family -- when every member of that family is nonzero at the
% rational sample of every sector that is not a root (nzb?).  That holds for
% every family the strategies build; when it fails, decb_o is decc_o.
% decb_ok proves it correct and complete.
%----------------------------------------------------------------------------
BEGIN
  IMPORTING decc_def, cad_projb_def

  TW: VAR Tower
  F, Q: VAR list[list[mpoly]]
  qs: VAR list[bool]
  Psi: VAR [SV -> bool]
  u: VAR nat

  %% the outer family: the smaller projection of the tower's lowest family
  cbotb(TW): list[list[mpoly]] = IF cons?(TW) THEN pdownb(car(TW)) ELSE null[list[mpoly]] ENDIF

  %% every member of Q is nonzero at the rational sample of every sector of its roots
  %% that is not a root
  nzb?(Q): bool =
    every(LAMBDA (s: Sect): at?(s) OR every(LAMBDA (f: list[mpoly]): meval(mpol(f))((: sval(s) :)) /= 0)(Q))
         (sects(rts(Q)))

  %% qs OUTERMOST first, at least two quantifiers
  decb_o(u, qs, F, Psi): [# ok: bool, val: bool #] =
    IF null?(qs) OR null?(cdr(qs)) THEN (# ok := FALSE, val := FALSE #)
    ELSE LET TW = ctw(F, length(cdr(qs))), Q = cbotb(TW) IN
      IF nzb?(Q) THEN
        LET ss = sects(rts(Q)), cs = map(cscof(u, TW))(ss) IN
        (# ok := gaps_ok(rts(Q)) AND every(okc?(u))(cs),
           val := IF car(qs) THEN every(scval(u, cdr(qs), Psi))(cs) ELSE some(scval(u, cdr(qs), Psi))(cs) ENDIF #)
      ELSE decc_o(u, qs, F, Psi) ENDIF
    ENDIF
END decb_def
