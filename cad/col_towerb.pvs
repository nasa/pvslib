col_towerb: THEORY
%----------------------------------------------------------------------------
% The Collins tower over a base cell where its lowest family is delineable.
%
% ptower_cad2: a chained tower whose lowest family is delineable (delin_cl?)
% over a connected C is a CAD over C.  The cells of the lowest stack are
% connected (conn_stk) and that family is sign-invariant on them (stk_sinv);
% it is the projection of the next family (chain?), so col_tower's
% ptower_cad applies to the rest of the tower over each of them.  ctw_cad2
% applies it to ctw(F, k).
%
% The bottom step can then use a smaller projection: bot_cad on a set where
% every member of cad_projb_def's projb of the lowest family is nonzero
% (cad_projb's projb_delin), bot_cad1 on a set with one point (cad_projb's
% kconst_one, col_stack's kcol_stack).
%----------------------------------------------------------------------------
BEGIN
  IMPORTING col_tower, cad_projb

  F, G: VAR list[list[mpoly]]
  TW: VAR Tower
  C: VAR [list[real] -> bool]
  p, q, p0: VAR list[real]
  k: VAR nat

  ptower_cad2: THEOREM chain?(TW) AND conn?(C) AND (cons?(TW) IMPLIES delin_cl?(car(TW), C))
    IMPLIES cad_over?(TW, C)
  ctw_cad2: THEOREM conn?(C) AND (k >= 1 IMPLIES delin_cl?(car(ctw(F, k)), C)) IMPLIES cad_over?(ctw(F, k), C)

  bot_cad: THEOREM k >= 1 AND conn?(C) AND C(p0)
    AND (FORALL (u: mpoly): member(u, projb(car(ctw(F, k)))) IMPLIES nzon?(u, C))
    IMPLIES cad_over?(ctw(F, k), C)
  bot_cad1: THEOREM k >= 1 AND conn?(C) AND C(p0) AND (FORALL p, q: C(p) AND C(q) IMPLIES p = q)
    IMPLIES cad_over?(ctw(F, k), C)
END col_towerb
