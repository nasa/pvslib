qsec_lift: THEORY
%----------------------------------------------------------------------------
% A section oracle over an APPROXIMATE base oracle.
%
% cell_ok's allok_agree says: at the exact oracle msg(ys), every query the
% section certifies (allok?) answers the sign at the section root beta.  At n
% levels the base oracle of a section cell is itself a descriptor oracle,
% right only on the reads its own certificate covered.  qsec_det (qsec_rd)
% moves the queries from the approximate oracle to the exact one: if sg
% agrees with msg(ys) on the reads the queries make (qs_rd), then the queries
% return the same ok flags and values at both, and allok_agree applies.
%----------------------------------------------------------------------------
BEGIN
  IMPORTING qsec_rd, cell_ok

  P: VAR list[list[mpoly]]
  ys: VAR list[real]
  sg, sg1, sg2, sg3: VAR SG
  lo, hi: VAR rat
  beta: VAR real
  R: VAR list[mpoly]

  agree_trans: LEMMA agree(sg1, sg2, R) AND agree(sg2, sg3, R) IMPLIES agree(sg1, sg3, R)

  allok_agree2: THEOREM lvl?(P, ys, lo, hi, beta)
    AND agree(sg, msg(ys), qs_rd(sg, P, lo, hi, R)) AND allok?(sg, P, lo, hi, R)
    IMPLIES agree(sg_sec(sg, P, lo, hi), msg(cons(beta, ys)), R)
END qsec_lift
