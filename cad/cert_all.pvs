cert_all: THEORY
%----------------------------------------------------------------------------
% The walk's leading-coefficient certificate holds at every point.
%
% Before it counts anything, the walk of a cell asks two things of its
% family P = zf(F, ws) (walk_transfer's cert?): every member with a main
% variable has a nonzero leading coefficient there (memok?), and so has the
% product of the live members (slc? of bprod).  Both hold at EVERY point, by
% construction:
%   - a member of zf(F, ws) is tz(msg(ws), strip(g)), whose top coefficient
%     is nonzero at ws (ztrunc's tz_top), so strip leaves it alone
%     (strip_top) and it is within the chain bound bk (lsumk_mem);
%   - the product prodl(L) has no coefficient above the sum of the degrees:
%     they vanish at every point (prodl_above), so they are structurally zero
%     (zc_iff) and strip removes them (strip_at); its coefficient at that sum
%     is the product of the leading coefficients (prodl_top), nonzero at ws
%     when every factor's is (prodl_strip).
% So certz?(F, ws) always holds (certz_all), and with walk_transfer's
% wok_exist, separators that pass the walk's certificate exist at every point.
%----------------------------------------------------------------------------
BEGIN
  IMPORTING zfam, mpoly_unique

  u: VAR mpoly
  ys, ws: VAR list[real]
  f, h, l: VAR list[mpoly]
  L, F, G: VAR list[list[mpoly]]
  i, j: VAR nat

  %% ---- structural zeros ---------------------------------------------------------------
  zc_iff: LEMMA zc?(u) IFF (FORALL ys: meval(u)(ys) = 0)
  zc_msg: LEMMA zc?(u) IMPLIES msg(ws)(u) = 0

  strip_top: LEMMA cons?(f) AND msg(ws)(llast(f)) /= 0 IMPLIES strip(f) = f
  lbut_nth: LEMMA FORALL f: i + 1 < length(f) IMPLIES nth(lbut(f), i) = nth(f, i)
  strip_at: LEMMA FORALL f: j < length(f) AND NOT zc?(nth(f, j))
    AND (FORALL i: j < i AND i < length(f) IMPLIES zc?(nth(f, i)))
    IMPLIES length(strip(f)) = j + 1 AND llast(strip(f)) = nth(f, j)

  %% ---- the product of a list of coefficient lists ----------------------------------------
  lsd(L): RECURSIVE nat = IF null?(L) THEN 0 ELSE dg(car(L)) + lsd(cdr(L)) ENDIF
  MEASURE length(L)
  prodl_above: LEMMA FORALL L: i > lsd(L) IMPLIES earr(prodl(L), ys)(i) = 0
  prodl_top: LEMMA FORALL L: (FORALL l: member(l, L) IMPLIES cons?(l) AND meval(llast(l))(ws) /= 0)
    IMPLIES lsd(L) < length(prodl(L)) AND earr(prodl(L), ws)(lsd(L)) /= 0
  prodl_strip: LEMMA (FORALL l: member(l, L) IMPLIES cons?(l) AND meval(llast(l))(ws) /= 0)
    IMPLIES length(strip(prodl(L))) = lsd(L) + 1 AND meval(llast(strip(prodl(L))))(ws) /= 0

  %% ---- the effective family -------------------------------------------------------------
  zf_top: LEMMA member(h, zf(F, ws)) IMPLIES cons?(h) AND msg(ws)(llast(h)) /= 0 AND strip(h) = h
  lsumk_mem: LEMMA FORALL L: member(h, L) IMPLIES length(h) <= lsumk(L)
  lsd_lives: LEMMA FORALL L: (FORALL h: member(h, L) IMPLIES length(h) >= 2)
    IMPLIES lsd(L) + length(L) = lsumk(L) AND lsd(L) >= length(L)
  memok_zf: LEMMA FORALL G: (FORALL h: member(h, G) IMPLIES member(h, zf(F, ws)))
    IMPLIES memok?(zf(F, ws), msg(ws), G)
  bprod_zf: LEMMA cons?(lives(zf(F, ws))) IMPLIES slc?(bk(zf(F, ws)), msg(ws), bprod(zf(F, ws)))

  certz_all: THEOREM certz?(F, ws)
END cert_all
