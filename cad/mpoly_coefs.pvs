mpoly_coefs: THEORY
%----------------------------------------------------------------------------
% Bridge between the recursive representation and NASALib's univariate
% polynomials (used for the uniqueness of normal forms).
%
% For a coefficient list l and a valuation ys of the remaining variables,
% coefs(l, ys) is the real coefficient sequence of the univariate polynomial
% in the head variable; meval_mpol_poly says meval computes exactly that
% polynomial, and poly_coefs_eq transfers "equal as functions of the head
% variable" to "equal coefficients" through reals@polynomials.
%----------------------------------------------------------------------------
BEGIN
  IMPORTING mpoly_norm, reals@polynomials

  l, l1, l2, t: VAR list[mpoly]
  h: VAR mpoly
  ys: VAR list[real]
  x: VAR real
  i: VAR nat

  coefs(l, ys): sequence[real] =
    LAMBDA (i: nat): IF i < length(l) THEN meval(nth(l, i))(ys) ELSE 0 ENDIF

  coefs_cons_0: LEMMA coefs(cons(h, t), ys)(0) = meval(h)(ys)
  coefs_cons_succ: LEMMA coefs(cons(h, t), ys)(i + 1) = coefs(t, ys)(i)
  coefs_shift: LEMMA (LAMBDA (i: nat): coefs(cons(h, t), ys)(i + 1)) = coefs(t, ys)
  coefs_beyond: LEMMA i >= length(l) IMPLIES coefs(l, ys)(i) = 0
  coefs_nth: LEMMA i < length(l) IMPLIES coefs(l, ys)(i) = meval(nth(l, i))(ys)

  meval_mpol_poly: LEMMA cons?(l) IMPLIES
    meval(mpol(l))(cons(x, ys)) = polynomial(coefs(l, ys), length(l) - 1)(x)

  % equal as functions of the head variable implies equal coefficients
  poly_coefs_eq: LEMMA cons?(l1) AND cons?(l2) AND
    (FORALL x: meval(mpol(l1))(cons(x, ys)) = meval(mpol(l2))(cons(x, ys)))
    IMPLIES coefs(l1, ys)(i) = coefs(l2, ys)(i)

END mpoly_coefs
