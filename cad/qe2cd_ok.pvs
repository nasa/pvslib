qe2cd_ok: THEORY
%----------------------------------------------------------------------------
% Collins quantifier elimination with derivative-closed free levels is
% correct and always quantifier-free.
%
%   qe2cd_bf     for every prenex formula with m >= 2 free variables: qe2cd
%                answers, its answer is quantifier-free, and it holds at a
%                point of R^m exactly when the formula does
%
% The tower ctwd(F, k, m - 1) is a CAD over every sector of its outer line
% (ctwd's ctwd_cad, col_sem's sinv_sect), so twrun_ok's wsector_recs gives
% qe2_ok's secout_sem on each sector (dsect_sem); its free families are
% closed under the derivative (ctwd_dcl), so qe2_sep's ents_sep makes the
% free cells' signatures separate and secout quantifier-free (dsect_qf).
%----------------------------------------------------------------------------
BEGIN
  IMPORTING qe2cd_def, qe2_sep, qe1_full

  u, k, d: VAR nat
  m: VAR posnat
  qb, os: VAR list[bool]
  F: VAR list[list[mpoly]]
  Psi: VAR [SV -> bool]
  bphi: VAR BF
  s: VAR Sect
  pt: VAR list[real]

  %% ---- the tower ------------------------------------------------------------------------------
  ctwd_scad: LEMMA k >= 1 IMPLIES scad?(ctwd(F, k, d))
  qe2cd_tw_shape: LEMMA m >= 2 AND cons?(qb) IMPLIES
    cons?(qe2cd_tw(m, qb, F)) AND length(qe2cd_tw(m, qb, F)) = m - 1 + length(qb)
    AND tlast(qe2cd_tw(m, qb, F)) = F

  %% ---- one sector -------------------------------------------------------------------------------
  dsect_sem: LEMMA m >= 2 AND cons?(qb) AND twok(u, qe2cd_tw(m, qb, F)) AND length(pt) = m
    AND member(s, sects(rts(cbot(qe2cd_tw(m, qb, F))))) AND in?(s, car(dropn(m - 1, pt)))
    IMPLIES (qfsem(secout(m, qb, Psi, s, qe2cd_tw(m, qb, F),
                          secr(s, cad_outw(u, F, qe2cd_tw(m, qb, F)))))(pt)
             IFF sem(qb, F, Psi, pt))
  dsect_qf: LEMMA m >= 2 AND cons?(qb) AND twok(u, qe2cd_tw(m, qb, F))
    AND member(s, sects(rts(cbot(qe2cd_tw(m, qb, F)))))
    IMPLIES qf?(secout(m, qb, Psi, s, qe2cd_tw(m, qb, F), secr(s, cad_outw(u, F, qe2cd_tw(m, qb, F)))))

  %% ---- the answer ---------------------------------------------------------------------------------
  qe2cd_c_sem: LEMMA m >= 2 AND cons?(qb) AND twok(u, qe2cd_tw(m, qb, F)) AND length(pt) = m
    IMPLIES (qfsem(qe2cd_c(u, m, qb, F, Psi)`out)(pt) IFF sem(qb, F, Psi, pt))
  qe2cd_c_qf: LEMMA m >= 2 AND cons?(qb) AND twok(u, qe2cd_tw(m, qb, F))
    IMPLIES qf?(qe2cd_c(u, m, qb, F, Psi)`out)

  qe2cd_correct: THEOREM qe2cd_o(u, m, qb, F, Psi)`ok AND length(pt) = m IMPLIES
    qf?(qe2cd_o(u, m, qb, F, Psi)`out) AND (qfsem(qe2cd_o(u, m, qb, F, Psi)`out)(pt) IFF sem(qb, F, Psi, pt))
  qe2cd_flag: LEMMA qe2cd_o(u, m, qb, F, Psi)`ok IMPLIES
    qe2cd_o(u, m, qb, F, Psi)`qf = qf?(qe2cd_o(u, m, qb, F, Psi)`out)

  qe2cd_u_ok: THEOREM m >= 2 AND cons?(qb) IMPLIES qe2cd_u(m, qb, F, Psi, u)`ok
  qe2cd_u_eq: LEMMA EXISTS (u2: nat): qe2cd_u(m, qb, F, Psi, u) = qe2cd_o(u2, m, qb, F, Psi)

  qe2cd_isqf: THEOREM m >= 2 AND cons?(os) IMPLIES qe2cd(m, os, F, bphi)`qf
  qe2cd_bf: THEOREM m >= 2 AND cons?(os) AND length(pt) = m IMPLIES
    qe2cd(m, os, F, bphi)`ok AND qf?(qe2cd(m, os, F, bphi)`out)
    AND (qfsem(qe2cd(m, os, F, bphi)`out)(pt) IFF fsem(os, F, bphi, pt))
  qe2cd_bf_qf: THEOREM qe2cd(m, os, F, bphi)`qf IMPLIES qf?(qe2cd(m, os, F, bphi)`out)
END qe2cd_ok
