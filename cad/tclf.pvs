tclf: THEORY
%----------------------------------------------------------------------------
% Towers: a tower TW = (F_0, ..., F_{n-1}),
% outermost first, whose formula's family is tlast(TW).  CLF(TW, ws) is the
% closure of a tower at a base point ws: the effective family of each level
% passes cert? at EVERY point of that level over ws, and the reads of each
% level's walk there are members of the family above (rdz?).
%----------------------------------------------------------------------------
BEGIN
  IMPORTING towern_def, zfam, cvl

  TW: VAR Tower
  ws: VAR list[real]
  y: VAR real

  %% ---- towers ------------------------------------------------------------------------
  tlast(TW): RECURSIVE list[list[mpoly]] =
    IF null?(TW) THEN null[list[mpoly]] ELSIF null?(cdr(TW)) THEN car(TW) ELSE tlast(cdr(TW)) ENDIF
  MEASURE length(TW)
  len_cons_tclf: LEMMA length(TW) >= 1 IMPLIES cons?(TW)
  tlast_cons: LEMMA cons?(TW) AND cons?(cdr(TW)) IMPLIES tlast(TW) = tlast(cdr(TW))

  CLF(TW, ws): RECURSIVE bool =
    IF null?(TW) THEN TRUE
    ELSE certz?(car(TW), ws) AND
         (null?(cdr(TW)) OR
          FORALL (y: real): rdz?(car(cdr(TW)), car(TW), cons(y, ws)) AND CLF(cdr(TW), cons(y, ws)))
    ENDIF
  MEASURE length(TW)
END tclf
