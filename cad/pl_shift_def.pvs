pl_shift_def: THEORY
%----------------------------------------------------------------------------
% The Taylor shift of a rational polynomial.  Executable.
%
% pshift(pl, m) has at t the value pl has at m + t (pl_shift's pshift_sem):
% cons(c, r) at m + t is c + (m + t) r(m + t), so the shift of cons(c, r) is
% c + m R + t R, with R the shift of r (NASALib's psum and pscal).  alg_isign
% evaluates the shifted query on [lb - m, ub - m], an interval around 0: there
% interval Horner overestimates by about the half-width times |q'(m)|, where
% on [lb, ub] itself the overestimate grows with the size of the coefficients.
%----------------------------------------------------------------------------
BEGIN
  IMPORTING alg_def

  pl: VAR Polylist
  m: VAR rat

  pshift(pl, m): RECURSIVE Polylist =
    IF null?(cdr(pl)) THEN pl
    ELSE LET R = pshift(cdr(pl), m) IN psum(psum((: car(pl) :), pscal(m, R)), cons(0, R))
    ENDIF
  MEASURE length(pl)
END pl_shift_def
