cad_endgame: THEORY
%----------------------------------------------------------------------------
% The endgame of (cad).  The strategy states each atom of
% the goal as the sign condition the decision reads -- x >= 1 as
% sign3(x - 1) = 1 OR sign3(x - 1) = 0 -- and proves that equation with these
% three rewrites and one arithmetic step.  Then the goal and the formula from
% decide8_correct are propositional combinations of the same atoms, and
% bddsimp closes the goal without a case split on the signs.
%----------------------------------------------------------------------------
BEGIN
  IMPORTING reals@sign3

  x: VAR real

  cadz_s3_pos:  LEMMA sign3(x) = 1 IFF x > 0
  cadz_s3_zero: LEMMA sign3(x) = 0 IFF x = 0
  cadz_s3_neg:  LEMMA sign3(x) = -1 IFF x < 0
END cad_endgame
