ev_pred: THEORY
%----------------------------------------------------------------------------
% "Eventually" over the escalation parameter u:
% ev?(p) -- p holds for every large enough u.  Closed under conjunction and
% under weakening; ev_nat adds finite lists and eventually constant maps.
%----------------------------------------------------------------------------
BEGIN
  u, N: VAR nat
  p, q: VAR pred[nat]

  ev?(p): bool = EXISTS N: FORALL u: u >= N IMPLIES p(u)
  ev_and_ev_pred: LEMMA ev?(p) AND ev?(q) IMPLIES ev?(LAMBDA u: p(u) AND q(u))
  ev_mono_ev_pred: LEMMA ev?(p) AND (FORALL u: p(u) IMPLIES q(u)) IMPLIES ev?(q)
END ev_pred
