decb_run: THEORY
%----------------------------------------------------------------------------
% decide8's run decomposes R^(k+1) into a CAD adapted to its family, with no
% certificate: col_run's col_cad_run for decb_o.
%
% decb_o cuts the line of the outermost variable at the roots of the smaller
% bottom-step projection Q = cbotb(ctw(F, k)) when nzb?(Q) holds, and at the
% roots of pbot(F, k), as decc_o does, otherwise: bsects(k, F).  Over every
% sector it uses the Collins run's tower ctw(F, k), so its cells are col_run's
% ccell(k, F)(s, A) over these sectors.  decb_cad_run: for every F and every
% k >= 1, the conditions of col_cad_run hold for bsects(k, F):
%   (1) the cells of R^(k+1) cover it, and two of them meet only if they
%       are the same (sector and indices);
%   (2) every cell, at every level, is connected and first-order definable;
%   (3) over each sector the tower is a CAD (cad_over?): decb_ok's sect_cadb
%       when nzb?(Q) holds, the gaps of the sorted roots always passing
%       (gaps_ok_incr);
%   (4) the graph of every root function over a cell is definable;
%   (5) every polynomial of F has one sign on every cell of R^(k+1).
% decide8 runs decb_o over the checked basis fam(B) of its input family F
% when every member of F passes the product check (cad_decide8_def);
% decb_cad_input: F then has one sign vector on every cell of that run too
% (fsplit_top's svec_smap).
%----------------------------------------------------------------------------
BEGIN
  IMPORTING decb_ok, col_run, fsplit_top

  k, i: VAR nat
  F: VAR list[list[mpoly]]
  B: VAR list[mpoly]
  s, s1, s2: VAR Sect
  A, A1, A2: VAR list[nat]
  p, p1, p2, q: VAR list[real]

  %% the sectors decb_o cuts the outer line into
  csectsb(k, F): list[Sect] = sects(rts(cbotb(ctw(F, k))))
  bsects(k, F): list[Sect] = IF nzb?(cbotb(ctw(F, k))) THEN csectsb(k, F) ELSE csects(k, F) ENDIF

  %% over each sector of the smaller bottom step the tower is a CAD
  csectorb_cad: LEMMA k >= 1 AND nzb?(cbotb(ctw(F, k))) AND member(s, csectsb(k, F))
    IMPLIES cad_over?(ctw(F, k), scell(s))

  %% the cells over the sectors of the smaller bottom step, when nzb? holds
  decb_cad_nz: LEMMA k >= 1 AND nzb?(cbotb(ctw(F, k))) IMPLIES
        (FORALL p: length(p) = k + 1 IMPLIES
           EXISTS s, A: member(s, csectsb(k, F)) AND length(A) = k AND ccell(k, F)(s, A)(p))
    AND (FORALL p, s1, s2, A1, A2: member(s1, csectsb(k, F)) AND member(s2, csectsb(k, F))
           AND length(A1) = k AND length(A2) = k
           AND ccell(k, F)(s1, A1)(p) AND ccell(k, F)(s2, A2)(p)
           IMPLIES s1 = s2 AND A1 = A2)
    AND (FORALL s, A: member(s, csectsb(k, F)) AND length(A) <= k IMPLIES
           conn?(ccell(k, F)(s, A)) AND fod?(1 + length(A))(ccell(k, F)(s, A)))
    AND (FORALL s: member(s, csectsb(k, F)) IMPLIES cad_over?(ctw(F, k), scell(s)))
    AND (FORALL s, A, i: member(s, csectsb(k, F)) AND length(A) < k
           AND (FORALL q: ccell(k, F)(s, A)(q) IMPLIES i < nroot(nth(ctw(F, k), length(A)), q))
           IMPLIES fod?(2 + length(A))
             (LAMBDA p: cons?(p) AND ccell(k, F)(s, A)(cdr(p))
                        AND car(p) = rt(nth(ctw(F, k), length(A)), cdr(p), i)))
    AND (FORALL s, A, p1, p2: member(s, csectsb(k, F)) AND length(A) = k
           AND ccell(k, F)(s, A)(p1) AND ccell(k, F)(s, A)(p2)
           IMPLIES svec(F, p1) = svec(F, p2))

  %% ---- DECIDE8'S RUN IS A CAD ADAPTED TO ITS FAMILY ------------------------------------------
  decb_cad_run: THEOREM k >= 1 IMPLIES
        (FORALL p: length(p) = k + 1 IMPLIES
           EXISTS s, A: member(s, bsects(k, F)) AND length(A) = k AND ccell(k, F)(s, A)(p))
    AND (FORALL p, s1, s2, A1, A2: member(s1, bsects(k, F)) AND member(s2, bsects(k, F))
           AND length(A1) = k AND length(A2) = k
           AND ccell(k, F)(s1, A1)(p) AND ccell(k, F)(s2, A2)(p)
           IMPLIES s1 = s2 AND A1 = A2)
    AND (FORALL s, A: member(s, bsects(k, F)) AND length(A) <= k IMPLIES
           conn?(ccell(k, F)(s, A)) AND fod?(1 + length(A))(ccell(k, F)(s, A)))
    AND (FORALL s: member(s, bsects(k, F)) IMPLIES cad_over?(ctw(F, k), scell(s)))
    AND (FORALL s, A, i: member(s, bsects(k, F)) AND length(A) < k
           AND (FORALL q: ccell(k, F)(s, A)(q) IMPLIES i < nroot(nth(ctw(F, k), length(A)), q))
           IMPLIES fod?(2 + length(A))
             (LAMBDA p: cons?(p) AND ccell(k, F)(s, A)(cdr(p))
                        AND car(p) = rt(nth(ctw(F, k), length(A)), cdr(p), i)))
    AND (FORALL s, A, p1, p2: member(s, bsects(k, F)) AND length(A) = k
           AND ccell(k, F)(s, A)(p1) AND ccell(k, F)(s, A)(p2)
           IMPLIES svec(F, p1) = svec(F, p2))

  %% ... and to the input family, when decide8 runs it over the checked basis
  decb_cad_input: THEOREM k >= 1 AND every(ucheck?(B))(ubs(F)) AND member(s, bsects(k, fam(B)))
    AND length(A) = k AND ccell(k, fam(B))(s, A)(p1) AND ccell(k, fam(B))(s, A)(p2)
    IMPLIES svec(F, p1) = svec(F, p2)
END decb_run
