mpoly_unique: THEORY
%----------------------------------------------------------------------------
% Uniqueness of normal forms: two normal terms that denote the same
% function are the same term.  Together with meval_mnorm and mnorm_normal
% this says mnorm(p) = mnorm(q) IFF p and q denote the same function, i.e.
% the mpoly-eq strategy is complete as well as sound.
%----------------------------------------------------------------------------
BEGIN
  IMPORTING mpoly_coefs, structures@more_list_props[mpoly]

  p, q, h: VAR mpoly
  l, l1, l2, t: VAR list[mpoly]
  xs, ys: VAR list[real]
  x: VAR real
  i, k: VAR nat
  c: VAR rat

  %% sizes and normality of list elements

  nth_msize: LEMMA i < length(l) IMPLIES msize(nth(l, i)) < msize(mpol(l))
  tail_normal_cons: LEMMA normalx(TRUE, mpol(l)) IMPLIES cons?(l)
  tail_normal_nth: LEMMA normalx(TRUE, mpol(l)) AND i < length(l) IMPLIES normal?(nth(l, i))
  tail_normal_last: LEMMA normalx(TRUE, mpol(l)) IMPLIES nth(l, length(l) - 1) /= zero
  normal_cons: LEMMA normal?(mpol(l)) IMPLIES cons?(l)
  normal_nth: LEMMA normal?(mpol(l)) AND i < length(l) IMPLIES normal?(nth(l, i))
  normal_last: LEMMA normal?(mpol(l)) AND length(l) >= 2 IMPLIES nth(l, length(l) - 1) /= zero
  normal_single: LEMMA normal?(mpol(l)) AND length(l) = 1 IMPLIES NOT mconst?(car(l))
  normal_zero: LEMMA normal?(zero)
  normal_const: LEMMA normal?(mconst(c))

  %% equality as functions

  eq_fun?(p, q): bool = FORALL xs: meval(p)(xs) = meval(q)(xs)

  eq_fun_sym: LEMMA eq_fun?(p, q) IMPLIES eq_fun?(q, p)

  % coefficientwise consequence of equal functions of the head variable
  eq_fun_coefs: LEMMA cons?(l1) AND cons?(l2) AND eq_fun?(mpol(l1), mpol(l2)) AND i < length(l1)
    IMPLIES eq_fun?(nth(l1, i), IF i < length(l2) THEN nth(l2, i) ELSE zero ENDIF)

  meval_single: LEMMA meval(mpol((: mconst(c) :)))(xs) = c

  eq_fun_const_coefs: LEMMA cons?(l) AND eq_fun?(mpol(l), mconst(c)) IMPLIES
    eq_fun?(nth(l, 0), mconst(c)) AND
    (FORALL i: 0 < i AND i < length(l) IMPLIES eq_fun?(nth(l, i), zero))

  %% the theorem

  unique: THEOREM normal?(p) AND normal?(q) AND eq_fun?(p, q) IMPLIES p = q

  mnorm_eq_iff: COROLLARY mnorm(p) = mnorm(q) IFF eq_fun?(p, q)

END mpoly_unique
