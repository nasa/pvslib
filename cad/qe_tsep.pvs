qe_tsep: THEORY
%----------------------------------------------------------------------------
% In a CAD whose families are derivative-closed, distinct cells have
% distinct signatures.
%
% stk_sep: over a base cell C where G is delineable, two points of the
% stacks a and b with the same sign vector on G have a = b.  The point of
% index b is moved to the fiber of the first point (sec_in: every index up to
% 2 nroot is realized over every base point; nroot is constant on C) without
% changing its sign vector (delin_cl?: equal stack indices mean equal sign
% vectors), and on one fiber equal sign vectors mean equal indices
% (qe_thom's fiber_sidx).  tcell_sep: by induction over the tower, two cells
% whose points have the same sign vector on every family (each at its own
% level) have the same stack indices.
%----------------------------------------------------------------------------
BEGIN
  IMPORTING qe_thom, cad_tower

  G: VAR list[list[mpoly]]
  C: VAR [list[real] -> bool]
  TW: VAR Tower
  A, B: VAR list[nat]
  p, q, p1, p2: VAR list[real]
  a, b, j: VAR nat

  stk_sep: LEMMA delin_cl?(G, C) AND dcl?(G) AND stk(G, C, a)(p1) AND stk(G, C, b)(p2)
    AND svec(G, p1) = svec(G, p2) IMPLIES a = b

  %% the sign vectors of all the families, each at its level
  tsame?(TW, p, q): bool = FORALL j: j < length(TW) IMPLIES
    svec(nth(TW, j), dropn(length(TW) - 1 - j, p)) = svec(nth(TW, j), dropn(length(TW) - 1 - j, q))

  tcell_sep: LEMMA FORALL TW: FORALL C, A, B, p, q: cad_over?(TW, C) AND every(dcl?)(TW)
    AND length(A) = length(TW) AND length(B) = length(TW)
    AND tcell(TW, C, A)(p) AND tcell(TW, C, B)(q) AND tsame?(TW, p, q) IMPLIES A = B
END qe_tsep
