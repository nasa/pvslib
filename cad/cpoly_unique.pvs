cpoly_unique: THEORY
%----------------------------------------------------------------------------
% Complex polynomials: roots are few, coefficients are determined.
%
% NASALib's complex@fundamental_algebra gives the existence of a root and
% one linear factor (polynomial_zero_factor) but nothing about how many roots
% a polynomial has or whether its coefficients are determined by its values.
% Both are needed to factor a polynomial into linear factors with its leading
% coefficient in front, which is the form the root-continuity argument
% (croot_near) uses.  roots_bound: a polynomial of degree at most n that vanishes
% at n + 1 distinct points vanishes everywhere.  coefs_unique: a polynomial
% that vanishes everywhere has zero coefficients up to its degree.
% factor_lc: when p = (x - y) q with p of degree n, the leading coefficient of
% q is that of p.
%----------------------------------------------------------------------------
BEGIN
  IMPORTING complex@fundamental_algebra

  a, b: VAR sequence[complex]
  n, i: VAR nat
  x, y, z, c: VAR complex

  %% n + 1 distinct roots: the polynomial is the zero function
  roots_bound: THEOREM FORALL (n: nat): FORALL (a: sequence[complex], r: [nat -> complex]):
    (FORALL (i, j: nat): i <= n AND j <= n AND i /= j IMPLIES r(i) /= r(j)) AND
    (FORALL (i: nat): i <= n IMPLIES cpolynomial(a, n)(r(i)) = real_(0))
    IMPLIES FORALL (z: complex): cpolynomial(a, n)(z) = real_(0)

  %% a polynomial that is the zero function has zero coefficients
  coefs_unique: THEOREM FORALL (n: nat): FORALL (a: sequence[complex]):
    (FORALL (z: complex): cpolynomial(a, n)(z) = real_(0)) IMPLIES
    FORALL (i: nat): i <= n IMPLIES a(i) = real_(0)

  %% the difference of two polynomials, coefficientwise
  cpoly_sub: LEMMA FORALL (n: nat): FORALL (a, b: sequence[complex], z: complex):
    cpolynomial(LAMBDA (i: nat): a(i) - b(i), n)(z) = cpolynomial(a, n)(z) - cpolynomial(b, n)(z)

  %% two polynomials with the same values have the same coefficients
  coefs_eq: LEMMA (FORALL (z: complex): cpolynomial(a, n)(z) = cpolynomial(b, n)(z)) IMPLIES
    FORALL (i: nat): i <= n IMPLIES a(i) = b(i)

  %% the coefficients of (x - y) q for q of degree n: b(i - 1) - y b(i) up
  %% to n, then b(n) at n + 1
  shift_coef(y, b, n)(i): complex =
    IF i = 0 THEN -y * b(0) ELSIF i <= n THEN b(i - 1) - y * b(i) ELSE b(i - 1) ENDIF
  shift_poly: LEMMA FORALL (n: nat): FORALL (b: sequence[complex], y, x: complex):
    (x - y) * cpolynomial(b, n)(x) = cpolynomial(shift_coef(y, b, n), n + 1)(x)

  %% the leading coefficient of a linear factor's cofactor
  factor_lc: THEOREM n > 0 AND
    (FORALL (x: complex): cpolynomial(a, n)(x) = (x - y) * cpolynomial(b, n - 1)(x))
    IMPLIES b(n - 1) = a(n)
END cpoly_unique
