loc_const: THEORY
%----------------------------------------------------------------------------
% A predicate that is locally constant on a closed interval is constant on it.
%
% This is the connectedness of the real line, in the only form the transfer
% theorem uses: if every point t of [a, b] has a neighbourhood on which P
% agrees with P(t), then P(a) gives P(b).  The proof is the usual one, by the
% least upper bound of the set of points up to which P holds throughout.
%----------------------------------------------------------------------------
BEGIN
  P: VAR [real -> bool]
  a, b, t, u, c: VAR real

  lc?(P, a, b): bool = FORALL t: a <= t AND t <= b IMPLIES
    EXISTS (e: posreal): FORALL u: a <= u AND u <= b AND abs(u - t) < e
      IMPLIES (P(u) IFF P(t))

  %% the points up to which P holds throughout
  upto(P, a, b): setof[real] =
    {t | a <= t AND t <= b AND FORALL u: a <= u AND u <= t IMPLIES P(u)}

  upto_lub: LEMMA a <= b AND P(a) IMPLIES
    EXISTS c: least_upper_bound?(c, upto(P, a, b)) AND a <= c AND c <= b

  %% the least upper bound is itself such a point
  lub_in: LEMMA a <= b AND lc?(P, a, b) AND P(a) AND
    least_upper_bound?(c, upto(P, a, b)) AND a <= c AND c <= b
    IMPLIES upto(P, a, b)(c)

  %% and it cannot lie below b
  lub_end: LEMMA a <= b AND lc?(P, a, b) AND P(a) AND
    least_upper_bound?(c, upto(P, a, b)) AND a <= c AND c <= b
    IMPLIES c = b

  loc_const: THEOREM a <= b AND lc?(P, a, b) AND P(a) IMPLIES P(b)

  %% the symmetric form: the two ends agree
  loc_const_iff: THEOREM a <= b AND lc?(P, a, b) IMPLIES (P(a) IFF P(b))
END loc_const
