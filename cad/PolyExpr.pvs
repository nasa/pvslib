%----------------------------------------------------------------------------
% Deep embedding of polynomial expressions: the syntax the
% mpoly-eq strategy builds from a PVS real expression.  Variables are
% positional indices into the valuation list (1 = head).
%----------------------------------------------------------------------------
PolyExpr: DATATYPE
BEGIN
  pe_const(pc: rat): pe_const?
  pe_var(pv: posnat): pe_var?
  pe_add(pa1, pa2: PolyExpr): pe_add?
  pe_sub(ps1, ps2: PolyExpr): pe_sub?
  pe_mul(pm1, pm2: PolyExpr): pe_mul?
  pe_neg(pn1: PolyExpr): pe_neg?
  pe_pow(pp1: PolyExpr, pp2: nat): pe_pow?
END PolyExpr
