cad_endgame_ex: THEORY
%----------------------------------------------------------------------------
% Tests of (cad)'s endgame.  Every comparison and every
% connective reaches the endgame through the full decision: the sentences
% are universal, or their witnesses irrational, so the witness search does
% not settle them first.  Also TRUE and FALSE, a repeated atom, division by a
% numeral, several variables, and a refuted hypothesis.
%----------------------------------------------------------------------------
BEGIN
  IMPORTING cad@pvs_cad
  %% each comparison, against zero and against a nonzero right-hand side
  e_eq:     LEMMA FORALL (x: real): x^2 = 2 * x - 1 IMPLIES x = 1
  e_ne:     LEMMA FORALL (x: real): x^2 + 1 /= 0
  e_ne2:    LEMMA FORALL (x: real): x /= 1 IMPLIES x^2 - 2 * x + 1 > 0
  e_lt_gt:  LEMMA FORALL (x: real): x < 1 OR x > 0
  e_ge_le:  LEMMA FORALL (x: real): x >= 1 OR x <= 1
  e_ge0:    LEMMA FORALL (x: real): x^2 >= 0
  e_le0:    LEMMA FORALL (x: real): -x^2 <= 0
  %% numbers on the left, division by a numeral
  e_left:   LEMMA FORALL (x: real): 0 <= x^2 AND 1 <= x^2 + 1
  e_div:    LEMMA FORALL (x: real): x / 2 + x / 3 = 5 * x / 6
  %% NOT, IFF, TRUE, FALSE, a repeated atom
  e_not:    LEMMA FORALL (x: real): NOT (x^2 < 0) AND NOT (x^2 + 1 = 0)
  e_iff:    LEMMA FORALL (x: real): (x^3 > 0 IFF x > 0) AND (x^2 = 0 IFF x = 0)
  e_true:   LEMMA FORALL (x: real): TRUE IFF x^2 >= 0
  e_false:  LEMMA FORALL (x: real): FALSE IFF x^2 < 0
  e_repeat: LEMMA FORALL (x: real): (x > 1 IMPLIES x > 0) AND (x > 1 OR x <= 1)
  %% several variables, alternation
  e_two:    LEMMA FORALL (x: real): FORALL (y: real): x^2 + y^2 >= 2 * x * y
  e_alt:    LEMMA FORALL (a: real): EXISTS (x: real): a > 0 IMPLIES (x^2 = a AND x /= 0)
  %% an existential whose witness is irrational, with /= and >=
  e_irr:    LEMMA EXISTS (x: real): x^2 = 3 AND x >= 1 AND x /= 2
  %% a refuted hypothesis: FALSE at the irrational x = sqrt(2), with one variable, so the
  %% witness search has nothing to fix; closed by (cad -1)
  e_refute: LEMMA NOT (FORALL (x: real): x^2 /= 2 OR x < 0)
END cad_endgame_ex
