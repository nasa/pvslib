cad_reduce_ex: THEORY
%----------------------------------------------------------------------------
% The witness search's one-variable reduction.  With three or more
% quantifiers, (cad) gives the full decision 10 s; when it does not answer in
% that time, (cad) fixes an existential variable of the sentence to a small
% constant, decides the smaller sentence, and proves the goal from it (a
% witness that does not depend on the other variables is a witness).
%
% Here the sentence says that a polynomial plus a constant is positive on the
% unit disc.  Its full decision, over the three variables c, x, y, does not
% finish in 40 s; with c fixed to 2 the two-variable sentence is decided at
% once, and the whole proof takes about 15 s.  disc_goal is proved by (cad);
% disc_hyp, its negation as a hypothesis, is refuted by (cad -1) the same way.
%----------------------------------------------------------------------------
BEGIN
  IMPORTING cad@pvs_cad

  disc_goal: LEMMA EXISTS (c: real): FORALL (x: real): FORALL (y: real):
    x^2 + y^2 <= 1 IMPLIES x^4 - 3 * x^2 * y + y^3 + c > 0

  disc_hyp: LEMMA (FORALL (c: real): EXISTS (x: real): EXISTS (y: real):
    x^2 + y^2 <= 1 AND x^4 - 3 * x^2 * y + y^3 + c <= 0) IMPLIES FALSE
END cad_reduce_ex
