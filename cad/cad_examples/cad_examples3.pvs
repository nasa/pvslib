cad_examples3: THEORY
%----------------------------------------------------------------------------
% Three quantifiers through (cad) (IMPORTING pvs_cad: the Collins run).
% Each TRUE sentence below is closed by the single step (cad); a FALSE one is
% stated negated in the antecedent form and refuted by (flatten) then
% (cad -1).
%----------------------------------------------------------------------------
BEGIN
  IMPORTING cad@pvs_cad
  %% above any two numbers there is a third
  t_above: LEMMA FORALL (x: real): FORALL (y: real): EXISTS (z: real): z > x AND z > y
  %% but not always one strictly between them
  t_between: LEMMA (FORALL (x: real): FORALL (y: real): EXISTS (z: real): z > x AND z < y)
    IMPLIES FALSE
  %% no x lies below every y by a square
  t_sqrt: LEMMA (EXISTS (x: real): FORALL (y: real): EXISTS (z: real): z * z = y - x)
    IMPLIES FALSE
  t_shift: LEMMA FORALL (x: real): EXISTS (y: real): FORALL (z: real): z * z + y > x
  t_sos: LEMMA FORALL (x: real): FORALL (y: real): FORALL (z: real):
    x^2 + y^2 + z^2 >= 2 * x * y
  %% over the unit disc the sphere has a point
  t_sphere: LEMMA FORALL (x: real): FORALL (y: real): EXISTS (z: real):
    x^2 + y^2 + z^2 = 1 OR x^2 + y^2 > 1
  %% the cone has a point over every (x, y)
  t_cone: LEMMA FORALL (x: real): FORALL (y: real): EXISTS (z: real): z^2 = x^2 + y^2

  %% grouped binders, decided through the nested form
  t_grouped: LEMMA FORALL (x, y: real): EXISTS (z: real): z > x AND z > y
END cad_examples3
