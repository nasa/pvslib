cad_star_ex: THEORY
%----------------------------------------------------------------------------
% Tests of (cad *): the polynomial content of a whole sequent.
% Each lemma is first taken apart with (skeep) and
% (flatten), so that the facts sit in the sequent as formulas over skolem
% constants, next to formulas (cad *) cannot use; then (cad *) decides the
% implication from the usable antecedents to the usable consequents.
%----------------------------------------------------------------------------
BEGIN
  IMPORTING cad@pvs_cad, reals@sqrt
  f, g: [real -> real]
  P: pred[real]

  %% 1. facts over skolem constants
  s_pos: LEMMA FORALL (x, y: real): x > 0 AND y > 0 IMPLIES x * y > 0
  %% 2. several consequents
  s_split: LEMMA FORALL (x: real): x < 0 OR x >= 0
  %% 3. a non-polynomial term becomes an unknown real
  s_sqrt: LEMMA FORALL (x: nnreal, a: real): a = sqrt(x) AND a * a = x AND a > 1 IMPLIES x > 1
  %% 4. an uninterpreted function; list formulas are skipped
  s_fun: LEMMA FORALL (x: real, l: list[real]):
    f(x) > x^2 AND member(x, l) AND length(l) = 3 IMPLIES f(x) > -1
  %% 5. a quantified hypothesis: no real root means a negative discriminant
  s_disc: LEMMA FORALL (b, c: real): (FORALL (z: real): z^2 + b * z + c > 0) IMPLIES b^2 < 4 * c
  %% 6. a quantified goal
  s_root: LEMMA FORALL (x: real): x > 0 IMPLIES EXISTS (y: real): y * y = x
  %% 7a. alternation in the goal
  s_alt_goal: LEMMA FORALL (a: real): a > 0 IMPLIES (FORALL (z: real): EXISTS (w: real): w * a > z)
  %% 7b. alternation in a hypothesis
  s_alt_hyp: LEMMA FORALL (c: real):
    (FORALL (z: real): EXISTS (w: real): w > z AND w * c > 1) IMPLIES c > 0
  %% 8. facts from types: posreal, and sqrt's nonnegative range
  s_posreal: LEMMA FORALL (x: posreal): x + 1 > 1
  s_sqrtpos: LEMMA FORALL (y: nnreal): sqrt(y) + 1 >= 1
  %% 9. skipped formulas: a bound variable under g, a quantifier under IMPLIES
  s_skip: LEMMA FORALL (x: real): (FORALL (z: real): g(z) <= 1) AND
    (x > 0 IMPLIES EXISTS (z: real): z * z = x) AND x > 2 IMPLIES x > 1
  %% 10. everything at once
  s_mix: LEMMA FORALL (x: real, l: list[real]): P(x) AND cons?(l) AND
    (FORALL (z: real): f(z) >= 0) AND f(x) > x^2 AND x /= 0 IMPLIES f(x) > 0
  %% 11. connectives, division, sq
  s_iff: LEMMA FORALL (x: real): (x > 1 IFF x - 1 > 0) AND NOT (x^2 < 0)
  s_div: LEMMA FORALL (x: real): x / 2 + x / 2 = x AND sq(x) >= 0
  %% 12. two variables in one binding of a hypothesis (the version with four
  %% variables, u^2 + v^2 = a AND u * v = b |- a >= 2b, is correct but too
  %% slow for the decision itself: plain (cad) on its closed form does not
  %% finish in 5 minutes)
  s_two: LEMMA FORALL (a: real): (EXISTS (u, v: real): u * u + v * v = a) IMPLIES a >= 0

  %% An expected failure: (cad *) says a FALSE implication is FALSE and leaves
  %% the sequent as it was.
END cad_star_ex
