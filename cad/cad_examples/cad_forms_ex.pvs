cad_forms_ex: THEORY
%----------------------------------------------------------------------------
% Regression examples for formulas as people write them:
% every connective around quantified parts, on both sides of the sequent
% (a goal proved, a false hypothesis refuted), grouped binders, binders over
% posreal, nnreal, negreal, npreal and nzreal, unknown real terms (each with
% the bounds its type gives), TRUE and FALSE beside quantified parts, comparisons of a
% term with itself, the connectives' synonyms, NOT over compound formulas,
% and (cad-qe) / (cad *) on such formulas.  The lemmas of the goal, hypothesis,
% subtype, constant and NOT groups are one (cad) call each, except where a
% (skeep) is noted; the (cad *) and (cad-qe) lemmas take (skeep) then (cad *),
% or (skeep), (split), and on each side (flatten), (cad-qe) and (cad *).
% cad_showcase has the commented tour; a few lemmas here repeat its examples
% on purpose, so that the regression set stands on its own.
%----------------------------------------------------------------------------
BEGIN
  IMPORTING cad@pvs_cad
  f: VAR [real -> real]
  a, b, c, d: VAR real

  %% ---- goals --------------------------------------------------------------------------------
  fx_imp: LEMMA FORALL (b, c: real): (EXISTS (t: real): t^2 + b*t + c = 0) IMPLIES b^2 >= 4*c
  fx_iff: LEMMA FORALL (b, c: real): (EXISTS (t: real): t^2 + b*t + c = 0) IFF b^2 >= 4*c
  fx_eps: LEMMA FORALL (e: real): e > 0 IMPLIES
    EXISTS (d: real): d > 0 AND FORALL (x: real): -d < x AND x < d IMPLIES x^2 < e
  fx_or: LEMMA FORALL (a: real): (FORALL (x: real): x^2 + a > 0) OR (EXISTS (x: real): x^2 + a <= 0)
  fx_and: LEMMA (FORALL (x: real): x^2 >= 0) AND (EXISTS (y: real): y^3 = 2)
  fx_grouped: LEMMA FORALL (x, y: real): EXISTS (z, w: real): z > x AND w > y AND z + w > x + y
  fx_nest3: LEMMA FORALL (a: real): (EXISTS (x: real): (FORALL (y: real): x*y = 0) AND x = a) IFF a = 0
  fx_not_in: LEMMA FORALL (a: real): NOT (EXISTS (x: real): x^2 + 1 = a) IMPLIES a < 1
  fx_conj_prem: LEMMA FORALL (a: real): ((EXISTS (t: real): t^2 = a) AND a /= 0) IMPLIES
    (EXISTS (u: real): u > 0 AND u^2 = a)
  fx_disj: LEMMA FORALL (a: real): (EXISTS (t: real): t^2 = a) OR (EXISTS (s: real): s^2 = -a) OR a = 7

  %% ---- false hypotheses ---------------------------------------------------------------------
  fx_neg_goal: LEMMA NOT (FORALL (x: real): EXISTS (y: real): x*y = 1)
  fx_h_iff: LEMMA NOT (FORALL (b, c: real): (EXISTS (t: real): t^2 + b*t + c = 0) IFF b^2 > 4*c)
  fx_h_or: LEMMA (FORALL (x: real): x^2 < 0) OR (EXISTS (y: real): y^2 < -1) IMPLIES 1 = 0
  fx_h_and: LEMMA NOT ((EXISTS (x: real): x^2 = 2) AND (FORALL (y: real): y^2 > 0))
  fx_h_imp: LEMMA (FORALL (x: real): EXISTS (y: real): x*y = 1) IMPLIES 1 = 2

  %% ---- subtypes of the reals ----------------------------------------------------------------
  fx_s_all: LEMMA FORALL (x: posreal): EXISTS (y: real): y^2 = x
  fx_s_ex: LEMMA EXISTS (x: posreal): x^2 = 2
  fx_s_nn: LEMMA FORALL (x: nnreal): x + 1 > 0
  fx_s_neg: LEMMA NOT (EXISTS (x: negreal): x^2 < 0)
  fx_s_mixed: LEMMA FORALL (a: posreal, b: real): EXISTS (x: nnreal): x^2 = a
  fx_s_hyp: LEMMA (FORALL (x: posreal): x > 1) IMPLIES 1 = 0
  fx_s_eps: LEMMA FORALL (e: posreal): EXISTS (d: posreal): FORALL (x: real): -d < x AND x < d IMPLIES x^2 < e

  %% ---- constants beside quantified parts ----------------------------------------------------
  fx_c_imp: LEMMA FORALL (u: real): TRUE IMPLIES (u < 0 OR ((EXISTS (b1: real): b1^2 = u) AND (EXISTS (b2: real): b2^3 = u)))
  fx_c_and: LEMMA (EXISTS (x: real): x > 0) AND TRUE
  fx_c_or: LEMMA FALSE OR (FORALL (x: real): x^2 >= 0)
  fx_c_hyp: LEMMA (FORALL (x: real): x^2 > 0) IMPLIES FALSE
  fx_c_iff: LEMMA ((EXISTS (x: real): x^2 = 2) IFF TRUE)
  fx_c_under: LEMMA FORALL (a: real): ((EXISTS (t: real): t^2 = a) AND TRUE) IMPLIES a >= 0
  fx_c_not: LEMMA FORALL (x: real): NOT FALSE AND (EXISTS (y: real): y > x)

  %% ---- (cad *), (cad-qe) ----------------------------------------------------------------------
  fx_star_unknown: LEMMA FORALL (f: [real -> real]): (EXISTS (t: real): t^2 = f(0)) IMPLIES f(0) >= 0
  fx_star_nonprenex: LEMMA FORALL (a: real): ((EXISTS (t: real): t^2 = a) IMPLIES a = 0) IMPLIES a <= 0
  fx_qe_grouped: LEMMA (EXISTS (s, t: real): s^2 + t^2 = 1 AND (s - d)^2 + t^2 = 1) IFF d^2 <= 4
  fx_qe_and: LEMMA ((EXISTS (t: real): t^2 = a) AND (EXISTS (s: real): s^3 = a)) IFF a >= 0
  fx_qe_sub: LEMMA (EXISTS (t: posreal): t^2 = a) IFF a > 0
  fx_qe_const: LEMMA ((EXISTS (t: real): t^2 = a) AND TRUE) IFF a >= 0

  %% ---- NOT over compound formulas (each one (cad); fx_hyps3, fx_nz_unk: (skeep) (cad -)) -----
  fx_not3: LEMMA FORALL (a: real): NOT ((EXISTS (t: real): t^2 = a) AND a < 0 AND a > -1)
  fx_not_ne: LEMMA FORALL (a: real): NOT (a /= 0 AND (EXISTS (t: real): t * a = 0 AND t /= 0))
  fx_notnot: LEMMA FORALL (a: real): NOT NOT (EXISTS (t: real): t^3 = a)
  fx_not_or: LEMMA FORALL (a: real): a >= 0 AND a <= 5 IMPLIES NOT ((FORALL (t: real): t^2 /= a) OR a > 5)
  fx_hyps3: LEMMA FORALL (c: real): (EXISTS (t: posreal): t^2 = c) AND c < 0 AND c > -5 IMPLIES 1 = 0
  fx_nz_unk: LEMMA FORALL (c: nzreal): (EXISTS (t: posreal): t * c = 1) AND c < 0 IMPLIES 1 = 0

  %% ---- the connectives' synonyms ------------------------------------------------------------
  fx_syn_imp: LEMMA FORALL (b, c: real): (EXISTS (t: real): t^2 + b*t + c = 0) => b^2 >= 4*c
  fx_syn_and: LEMMA (FORALL (x: real): x^2 >= 0) & (EXISTS (y: real): y^3 = 2)
  fx_syn_iff: LEMMA FORALL (a: real): (EXISTS (t: real): t^2 = a) <=> a >= 0
  fx_syn_uni: LEMMA FORALL (a: real): ((EXISTS (t: real): t^2 = a) ∧ a ≠ 0) ⇒ (a > 0 ∨ a < 0)
  fx_syn_when: LEMMA FORALL (a: real): (EXISTS (t: real): t^2 = a) WHEN a >= 0
  fx_syn_not: LEMMA ¬ (EXISTS (x: real): x^2 < 0)

  %% ---- npreal and nzreal binders, comparisons of a term with itself ---------------------------
  fx_s_np: LEMMA FORALL (x: npreal): x - 1 < 0
  fx_s_nz: LEMMA FORALL (x: nzreal): x^2 > 0
  fx_s_nz_ex: LEMMA EXISTS (x: nzreal): x^3 = -1
  fx_refl: LEMMA FORALL (a: real): (EXISTS (t: real): t^3 = a) <=> (a = a)
  fx_refl_q: LEMMA FORALL (a: real): (FORALL (t: nzreal): t /= t) OR (EXISTS (s: real): s^3 = a)

  %% ---- unknown terms with the bound their types give: (skeep), then (cad) or (cad -1) ---------
  fx_typed_pos: LEMMA FORALL (e: posreal): EXISTS (d: posreal): d < e
  fx_typed_sqrt: LEMMA FORALL (x: nnreal): sqrt(x) + 1 > 0
  fx_typed_negint: LEMMA FORALL (k: negint): k^2 >= 1
  fx_typed_hyp: LEMMA FORALL (e: posreal): (EXISTS (d: posreal): d + e = 0) IMPLIES 1 = 0

  %% ---- (cad-qe) with a nzreal binder and with synonyms ---------------------------------------
  fx_qe_nz: LEMMA (EXISTS (t: nzreal): t^2 = a) IFF a > 0
  fx_qe_syn: LEMMA (EXISTS (t: real): t^2 = a & t /= 0) <=> a > 0

  %% ---- found by the final review: every bound a type gives (both bounds of below(5)); a
  %% quantifier-free hypothesis P IMPLIES FALSE; constants inside a quantifier-free leaf; a
  %% quantifier whose body folds to a constant; sq against x * x --------------------------------
  fx_below_star: LEMMA FORALL (i: below(5)): i * i + i >= 0
  fx_below: LEMMA FORALL (i: below(5)): i * i <= 16
  %% a theory constant, so that nothing is substituted: (flatten) (cad -1) gets the hypothesis
  %% P IMPLIES FALSE itself; fx_qf_imp_goal, the same by (cad), the goal side
  qc: real
  fx_qf_imp_false: LEMMA ((qc * qc - 2 * qc + 1 >= 0) IMPLIES FALSE) IMPLIES 1 = 2
  fx_qf_imp_goal: LEMMA ((qc * qc - 2 * qc + 1 >= 0) IMPLIES FALSE) IMPLIES 1 = 2
  fx_leaf_refl: LEMMA FORALL (x: real): EXISTS (y: posreal): y <= y AND y > x
  fx_fold_q: LEMMA (FORALL (x: real): NOT (x < x)) AND (EXISTS (y: real): y^3 = 2)
  fx_sq: LEMMA FORALL (c: real): sq(c) = c * c

  %% ---- found by the review of 2026-10-03 -------------------------------------------------------
  %% the synonym ⇔; binders written nonneg_real, nonpos_real, nonzero_real; a posnat unknown
  %% after (skeep)
  fx_syn_iff_uni: LEMMA FORALL (a: real): (EXISTS (t: real): t^2 = a) ⇔ a >= 0
  fx_s_nonneg: LEMMA FORALL (x: nonneg_real): x + 1 > 0
  fx_s_nonpos: LEMMA FORALL (x: nonpos_real): x - 1 < 0
  fx_s_nonzero: LEMMA FORALL (x: nonzero_real): x^2 > 0
  fx_typed_posnat: LEMMA FORALL (n: posnat): n^2 >= n
  %% OR, IMPLIES and IFF refuted as hypotheses; a grouped binder and subtype binders in one
  fx_h_or2: LEMMA NOT ((FORALL (x: real): x^2 < 0) OR (EXISTS (y: real): y^2 < -1))
  fx_h_imp2: LEMMA NOT ((EXISTS (x: real): x^2 = 2) IMPLIES (FORALL (y: real): y^2 > 0))
  fx_h_iff2: LEMMA NOT ((EXISTS (x: real): x^2 = 2) IFF (FORALL (y: real): y^2 > 0))
  fx_h_grouped: LEMMA NOT (FORALL (x, y: real): x^2 + y^2 > 0)
  fx_s_hyp_nn: LEMMA NOT (EXISTS (x: nnreal): x + 1 <= 0)
  fx_s_hyp_np: LEMMA NOT (EXISTS (x: npreal): x > 0)
  fx_s_hyp_nz: LEMMA NOT (EXISTS (x: nzreal): x^2 = 0)
  %% (cad-direct) on a formula that is not prenex
  cd_general: LEMMA FORALL (a: real): (EXISTS (x: real): x^2 = a) OR a < 0
  %% (cad-qe) on an alternating prefix: (skeep), (split), on each side (flatten), (cad-qe), (cad *)
  qe_alt_forms_ex: LEMMA (FORALL (x: real): EXISTS (y: real): x * y = a) IFF a = 0
  %% a free variable named T, like a NASALib function that pointwise function arithmetic
  %% lets into polynomial text: (cad-qe) must print it as (T::real), and (cad *) must read
  %% that as the same T; (skeep), (split), on each side (flatten), (cad-qe), (cad *)
  qe_name_T: LEMMA FORALL (T: real): (EXISTS (t: real): t^2 + t = T) IFF 4*T + 1 >= 0
END cad_forms_ex
