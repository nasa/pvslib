cad_examples4: THEORY
%----------------------------------------------------------------------------
% Four quantifiers through (cad) (IMPORTING pvs_cad: the Collins run).  Each
% TRUE sentence below is closed by the single step (cad); a FALSE one is
% stated in the antecedent form and refuted by (flatten) then (cad -1).
%----------------------------------------------------------------------------
BEGIN
  IMPORTING cad@pvs_cad
  %% above any three numbers there is a fourth
  e4_above: LEMMA FORALL (x: real): FORALL (y: real): FORALL (z: real): EXISTS (w: real):
    w > x AND w > y AND w > z
  %% but not always one above two of them and below the third
  e4_between: LEMMA (FORALL (x: real): FORALL (y: real): FORALL (z: real): EXISTS (w: real):
    w > x AND w > y AND w < z) IMPLIES FALSE
  %% alternating quantifiers
  e4_sum: LEMMA FORALL (x: real): EXISTS (y: real): FORALL (z: real): EXISTS (w: real):
    w > x + y + z
  e4_square: LEMMA FORALL (x: real): FORALL (y: real): EXISTS (z: real): FORALL (w: real):
    w^2 + z > x + y
END cad_examples4
