cad_hard_ex: THEORY
%----------------------------------------------------------------------------
% Problems that are hard for CAD, decided by (cad) through the Collins run
% (IMPORTING pvs_cad): one variable of high degree, three and four variables
% of low degree, and two variables of degree 7 to 10.  With the read-closure
% decision of the full version (tag v1.0-full, cad_limits*.pvs) most of them
% did not finish within 90-120 s.  Still out of reach: Mignotte's polynomial
% (two roots about 10^-7 apart) and AM-GM in four variables.
%----------------------------------------------------------------------------
BEGIN
  IMPORTING cad@pvs_cad
  %% ---- one variable of high degree ----
  %% Wilkinson's polynomial (x-1)(x-2)...(x-20), expanded: positive left of 1
  h_wilk20: LEMMA FORALL (x: real): x < 1 IMPLIES
    x^20 - 210*x^19 + 20615*x^18 - 1256850*x^17 + 53327946*x^16 - 1672280820*x^15
      + 40171771630*x^14 - 756111184500*x^13 + 11310276995381*x^12 - 135585182899530*x^11
      + 1307535010540395*x^10 - 10142299865511450*x^9 + 63030812099294896*x^8
      - 311333643161390640*x^7 + 1206647803780373360*x^6 - 3599979517947607200*x^5
      + 8037811822645051776*x^4 - 12870931245150988800*x^3 + 13803759753640704000*x^2
      - 8752948036761600000*x + 2432902008176640000 > 0

  %% the Chebyshev polynomial T30 stays between -1 and 1 on [-1, 1]
  h_cheb30: LEMMA FORALL (x: real): -1 <= x AND x <= 1 IMPLIES
    (536870912*x^30 - 4026531840*x^28 + 13589544960*x^26 - 27262976000*x^24
       + 36175872000*x^22 - 33426505728*x^20 + 22052208640*x^18 - 10478223360*x^16
       + 3572121600*x^14 - 859955200*x^12 + 141892608*x^10 - 15275520*x^8 + 990080*x^6
       - 33600*x^4 + 450*x^2 - 1 <= 1
     AND
     536870912*x^30 - 4026531840*x^28 + 13589544960*x^26 - 27262976000*x^24
       + 36175872000*x^22 - 33426505728*x^20 + 22052208640*x^18 - 10478223360*x^16
       + 3572121600*x^14 - 859955200*x^12 + 141892608*x^10 - 15275520*x^8 + 990080*x^6
       - 33600*x^4 + 450*x^2 - 1 >= -1)

  %% ---- three and four variables of low degree ----
  %% AM-GM for three numbers
  c_amgm3: LEMMA FORALL (x: real): FORALL (y: real): FORALL (z: real):
    x >= 0 AND y >= 0 AND z >= 0 IMPLIES x^3 + y^3 + z^3 >= 3*x*y*z

  %% Schur's inequality (t = 1)
  c_schur: LEMMA FORALL (x: real): FORALL (y: real): FORALL (z: real):
    x >= 0 AND y >= 0 AND z >= 0 IMPLIES
    x*(x - y)*(x - z) + y*(y - x)*(y - z) + z*(z - x)*(z - y) >= 0

  %% u^2 + v^2 = a and uv = b give a >= 2b
  d_two_squares: LEMMA FORALL (a: real): FORALL (b: real): FORALL (u: real): FORALL (v: real):
    u*u + v*v = a AND u*v = b IMPLIES a >= 2*b

  %% Cauchy-Schwarz in the plane
  d_cs2: LEMMA FORALL (a: real): FORALL (b: real): FORALL (c: real): FORALL (d: real):
    (a*c + b*d)^2 <= (a^2 + b^2)*(c^2 + d^2)

  %% ---- two variables of degree 7 to 10 ----
  %% y^7 + xy + 1 = 0 has a root y for every x
  g_root7: LEMMA FORALL (x: real): EXISTS (y: real): y^7 + x*y + 1 = 0

  %% y^7 - x y^3 + x^5 = 0 has a root y for every x
  b7_root: LEMMA FORALL (x: real): EXISTS (y: real): y^7 - x*y^3 + x^5 = 0

  %% x^8 + y^8 >= 2 x^4 y^4
  g_amgm8: LEMMA FORALL (x: real): FORALL (y: real): x^8 + y^8 >= 2*x^4*y^4

  %% x^8 + y^8 = 1 meets y = x^2
  g_meet8: LEMMA EXISTS (x: real): EXISTS (y: real): x^8 + y^8 = 1 AND y = x^2

  %% x^8 + y^8 = 1 meets x^3 = y^5
  b8_meet: LEMMA EXISTS (x: real): EXISTS (y: real): x^8 + y^8 = 1 AND x^3 = y^5

  %% y^9 + xy + 1 = 0 has a root y for every x
  g_root9: LEMMA FORALL (x: real): EXISTS (y: real): y^9 + x*y + 1 = 0

  %% x^10 + y^10 >= 2 x^5 y^5
  g_amgm10: LEMMA FORALL (x: real): FORALL (y: real): x^10 + y^10 >= 2*x^5*y^5

END cad_hard_ex
