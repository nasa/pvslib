qe8_ex: THEORY
%----------------------------------------------------------------------------
% (cad-qe) through qe8, the Collins run first: this
% theory imports qe8, so (cad-qe) eliminates by qe8 and the proof
% instantiates qe8_correct.  Six equivalences, an alternating prefix (q8_alt),
% grouped binders (q8_disc2g), and qe8's fallback to qe2cd on two free
% variables (q8_win_cc, q8_win_cd).
%----------------------------------------------------------------------------
BEGIN
  IMPORTING cad@qe8, cad@mpoly_embed, cad@cad_endgame
  D, a, b, r: VAR real

  q8_sqrt: LEMMA (EXISTS (t: real): t^2 = D) IFF D >= 0
  q8_disc: LEMMA (FORALL (x: real): x^2 + b*x + 1 > 0) IFF b^2 < 4
  q8_disc2: LEMMA (EXISTS (x: real): EXISTS (y: real): x^2 + y^2 < r) IFF r > 0
  q8_eq2: LEMMA (EXISTS (t: real): t = a AND t = b) IFF a = b
  q8_quad: LEMMA (EXISTS (t: real): t^2 + a*t + b = 0) IFF a^2 >= 4*b
  q8_win: LEMMA
    (EXISTS (t: real): 0 <= t AND t <= 10 AND (5 - t)^2 + (t/2)^2 < D^2) IFF D^2 > 5
  %% an alternating prefix
  q8_alt: LEMMA (FORALL (x: real): EXISTS (y: real): x * y = a) IFF a = 0
  q8_disc2g: LEMMA (EXISTS (x, y: real): x^2 + y^2 < r) IFF r > 0

  %% EXISTS t: 0 <= t AND t <= T AND (5 - t)^2 + (t/2)^2 < D^2, two free variables T, D
  %% (T the outer one), as qe8 takes it: the polynomials t, t - T, 5/4 t^2 - 10 t + 25 - D^2,
  %% and the matrix NOT(t < 0) AND NOT(t - T > 0) AND 5/4 t^2 - ... < 0.  Collins's answer
  %% (qe2cc) is not quantifier-free here, so qe8 falls back to the derivative-augmented
  %% tower (qe2cd), whose answer is (qe2cd_bf, qe8_correct).
  winF: list[list[mpoly]] =
    (: (: mconst(0), mconst(1) :),
       (: mpol((: mconst(0), mconst(-1) :)), mconst(1) :),
       (: mpol((: mpol((: mconst(25), mconst(0), mconst(-1) :)) :)), mconst(-10), mconst(5/4) :) :)
  winB: BF = band(bnot(batom(0, -1)), band(bnot(batom(1, 1)), batom(2, -1)))
  q8_win_cc: LEMMA NOT qe2cc(2, (: FALSE :), winF, winB)`qf
  q8_win_cd: LEMMA qe8(2, (: FALSE :), winF, winB)`ok AND qe8(2, (: FALSE :), winF, winB)`qf
END qe8_ex
