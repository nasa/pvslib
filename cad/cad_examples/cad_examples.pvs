cad_examples: THEORY
%----------------------------------------------------------------------------
% Examples decided by (cad) through the Collins run (IMPORTING pvs_cad).
%
% Each lemma is a closed prenex formula over the reals with one variable per
% quantifier and a Boolean combination of polynomial sign conditions as its
% matrix; (cad) decides it by decide8 (cad_decide8) and proves it from
% decide8_correct.  w_trivial and w_trivial_h are settled by the witness
% search's constant fold, before any decision.
%----------------------------------------------------------------------------
BEGIN
  IMPORTING cad@pvs_cad
  ex_above: LEMMA FORALL (x: real): EXISTS (y: real): y > x
  ex_zero: LEMMA EXISTS (x: real): FORALL (y: real): x * y = 0
  ex_sos: LEMMA FORALL (x: real): FORALL (y: real): x^2 + y^2 >= 0

  %% the unit circle: over every x some point is on it or x is outside
  ex_circle: LEMMA FORALL (x: real): EXISTS (y: real): x^2 + y^2 = 1 OR x^2 > 1
  %% some vertical line misses the circle
  ex_circle2: LEMMA EXISTS (x: real): FORALL (y: real): x^2 + y^2 > 1
  %% a line meets every vertical
  ex_line: LEMMA FORALL (x: real): EXISTS (y: real): x + 2 * y = 1 AND y * y >= 0
  %% inside the disc the abscissa is below one
  ex_disc: LEMMA FORALL (x: real): FORALL (y: real): x^2 + y^2 < 1 IMPLIES x < 1
  %% three variables, by (cad) since S5d
  ex_three: LEMMA FORALL (x: real): FORALL (y: real): EXISTS (z: real): z > x AND z > y

  %% grouped binders, decided through the nested form
  ex_grouped: LEMMA FORALL (x, y: real): x^2 + y^2 >= 2 * x * y
  %% the witness search: the constant y = 0 settles the matrix for every x, as a goal and
  %% as a refuted hypothesis
  w_trivial: LEMMA FORALL (x: real): EXISTS (y: real): y^2 = 0 OR x * y > x^2 + 1
  w_trivial_h: LEMMA NOT (EXISTS (x: real): FORALL (y: real): y^2 /= 0 AND x * y <= x^2 + 1)
END cad_examples
