cad_decide8_ex: THEORY
%----------------------------------------------------------------------------
% (cad) and (cad :cad-only? t) through the Collins run with the minimal
% import: this theory imports cad_decide8 and mpoly_embed, not pvs_cad, so
% (cad) decides by decide8 (decb_u over the tower of Collins projections,
% with the checked basis of each family) and the proof instantiates
% decide8_correct.  l3_quad took more than 600 s with the read-closure run of
% the full version (tag v1.0-full).
%----------------------------------------------------------------------------
BEGIN
  IMPORTING cad@cad_decide8, cad@mpoly_embed
  c8_circle: LEMMA FORALL (x: real): EXISTS (y: real): x^2 + y^2 = 1 OR x^2 > 1

  c8_k3_lin: LEMMA FORALL (c: real): EXISTS (x1: real): EXISTS (x2: real): EXISTS (x3: real):
    (x1 >= -1 AND x1 <= 1 AND x2 >= -1 AND x2 <= 1 AND x3 >= -1 AND x3 <= 1 AND x1 + x2 + x3 >= c) OR c > 3

  c8_l3_quad: LEMMA FORALL (c: real): EXISTS (x1: real): EXISTS (x2: real): EXISTS (x3: real):
    (x1^2 <= 1 AND x2^2 <= 1 AND x3^2 <= 1 AND x1 + x2 + x3 >= c) OR c > 3

  %% (cad :cad-only? t) with one quantifier (the sectors of the line), and on a hypothesis:
  %% (cad -1 :cad-only? t)
  c8_one: LEMMA FORALL (x: real): x^4 - 2*x^2 + 1 >= 0
  c8_hyp: LEMMA NOT (FORALL (x: real): EXISTS (y: real): x * y = 1)
END cad_decide8_ex
