sres_gcd: THEORY
%----------------------------------------------------------------------------
% The k-th subresultant polynomial, and its roots.
%
% Sk(A, p, B, q, k) is the polynomial whose coefficient of z^i (i <= k) is the
% determinant of the k-th subresultant matrix with its last column replaced
% by the column of degree i (subres2's sresc at a point); its coefficient of
% z^k is the principal subresultant coefficient psc_k (sres_lead).
%   sres_comb    Sk = u*A + v*B for the cofactor vector of the last column
%                (rdet_lin's expansion in unit columns; the columns of degree
%                above k repeat earlier columns, rdet_cols_eq)
%   sres_common  a common root of A and B is a root of Sk
%   sres_roots   when the common divisors of A and B have degree k exactly
%                (ccd? at k, not at k + 1), every root of Sk is a common root:
%                Sk is the common divisor times a nonzero constant
% So when the psc pattern of a pair is constant along a set, the common roots
% of the pair are the roots of one polynomial with continuously varying
% coefficients and a nonvanishing leading coefficient -- which is how common
% roots persist.
%----------------------------------------------------------------------------
BEGIN
  IMPORTING sres_thm

  A, B: VAR [nat -> real]
  p, q, k, i, a: VAR nat
  z: VAR complex

  %% the column of degree i of the k-th matrix
  scol(A, p, B, q, k, i)(a): real =
    IF i < p + q - k THEN sylj(A, p, B, q, k)(a, p + q - k - 1 - i) ELSE 0 ENDIF
  %% the coefficient of z^i of the k-th subresultant
  sresv(A, p, B, q, k)(i): real =
    rdet(msub(p + q, 2 * k), setcol(sylj(A, p, B, q, k), msub(p + q, 2 * k + 1), scol(A, p, B, q, k, i)))
  Sk(A, p, B, q, k)(z): complex = cpolynomial(LAMBDA i: real_(sresv(A, p, B, q, k)(i)), k)(z)
  %% the cofactors of the last column
  cofv(A, p, B, q, k)(a): complex =
    real_(rdet(msub(p + q, 2 * k), setcol(sylj(A, p, B, q, k), msub(p + q, 2 * k + 1), ecol(a))))

  xr: VAR [nat -> real]
  n: VAR nat
  csum_real: LEMMA csum(n, LAMBDA a: real_(xr(a))) = real_(sigma(0, n - 1, xr))

  sres_lead: LEMMA 2 * k < p + q IMPLIES
    sresv(A, p, B, q, k)(k) = rdet(p + q - 2 * k, sylj(A, p, B, q, k))

  ecf_cofv: LEMMA k <= p AND k <= q AND 2 * k < p + q IMPLIES
    ecf(cofv(A, p, B, q, k), A, p, B, q, k)(i) =
      IF i <= k THEN real_(sresv(A, p, B, q, k)(i)) ELSE real_(0) ENDIF
  sres_comb: LEMMA k <= p AND k <= q AND 2 * k < p + q IMPLIES
    Sk(A, p, B, q, k)(z) = comb(cofv(A, p, B, q, k), A, p, B, q, k)(z)

  sres_common: LEMMA k <= p AND k <= q AND 2 * k < p + q AND rp(A, p)(z) = real_(0) AND rp(B, q)(z) = real_(0)
    IMPLIES Sk(A, p, B, q, k)(z) = real_(0)

  sres_roots: THEOREM A(p) /= 0 AND B(q) /= 0 AND 2 * k < p + q
    AND ccd?(rp(A, p), rp(B, q), k) AND NOT ccd?(rp(A, p), rp(B, q), k + 1)
    AND Sk(A, p, B, q, k)(z) = real_(0)
    IMPLIES rp(A, p)(z) = real_(0) AND rp(B, q)(z) = real_(0)
END sres_gcd
