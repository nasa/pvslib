qe_fm: THEORY
%----------------------------------------------------------------------------
% The meaning of qe_fm_def's formulas: f_orl holds iff some member holds,
% f_andl iff every member holds, and both are quantifier-free when their
% members are.
%----------------------------------------------------------------------------
BEGIN
  IMPORTING qe_fm_def

  phi: VAR Fm
  L: VAR list[Fm]
  pt: VAR list[real]

  qfsem_orl: LEMMA FORALL L: qfsem(f_orl(L))(pt) IFF EXISTS phi: member(phi, L) AND qfsem(phi)(pt)
  qfsem_andl: LEMMA FORALL L: qfsem(f_andl(L))(pt) IFF FORALL phi: member(phi, L) IMPLIES qfsem(phi)(pt)
  qf_orl: LEMMA FORALL L: (FORALL phi: member(phi, L) IMPLIES qf?(phi)) IMPLIES qf?(f_orl(L))
  qf_andl: LEMMA FORALL L: (FORALL phi: member(phi, L) IMPLIES qf?(phi)) IMPLIES qf?(f_andl(L))
END qe_fm
