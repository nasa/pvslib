mpoly_real: THEORY
%----------------------------------------------------------------------------
% From coefficient lists over mpoly to real coefficient arrays.
%
% A polynomial in the eliminated variable is a list of mpoly coefficients in
% the parameters. Once the parameters are given real values ys, each
% coefficient becomes a real number, so the list becomes a real coefficient
% array in the sense of reals@polynomials, which is the form every theorem of
% NASALib's Sturm development is stated in. earr is that array and earr_eval
% is the evaluation homomorphism: the polynomial it denotes is the one our
% meval computes. This is what lets a symbolic construction be checked
% against the library's theorems one valuation at a time.
%----------------------------------------------------------------------------
BEGIN
  IMPORTING mpoly_pdiv, poly_unique, analysis@derivatives[real]

  l, l1, l2: VAR list[mpoly]
  ys: VAR list[real]
  x: VAR real
  i: VAR nat
  c: VAR mpoly

  earr(l, ys)(i): real = IF i < length(l) THEN meval(nth(l, i))(ys) ELSE 0 ENDIF

  cons_length_pos: LEMMA cons?(l) IMPLIES length(l) > 0
  earr_above: LEMMA i >= length(l) IMPLIES earr(l, ys)(i) = 0
  earr_cdr: LEMMA cons?(l) IMPLIES (LAMBDA i: earr(l, ys)(i + 1)) = earr(cdr(l), ys)
  llast_nth: LEMMA cons?(l) IMPLIES llast(l) = nth(l, length(l) - 1)
  earr_top: LEMMA cons?(l) IMPLIES earr(l, ys)(length(l) - 1) = meval(llast(l))(ys)
  earr_eval: THEOREM cons?(l) IMPLIES
    polynomial(earr(l, ys), length(l) - 1)(x) = meval(mpol(l))(cons(x, ys))
  earr_eval_d: THEOREM i + 1 >= length(l) IMPLIES
    polynomial(earr(l, ys), i)(x) = meval(mpol(l))(cons(x, ys))

  %% the polynomial as a function of the eliminated variable
  pf(l, ys): [real -> real] = LAMBDA (x: real): meval(mpol(l))(cons(x, ys))
  pf_cont: LEMMA continuous?(pf(l, ys))
END mpoly_real
