subres: THEORY
%----------------------------------------------------------------------------
% The principal subresultant coefficients.
%
% psc(f, g, j) is the determinant of sresm(f, g, j), the Sylvester-style
% matrix whose last column carries degree j, which is what makes the
% determinant the PRINCIPAL coefficient rather than the whole subresultant.
% ring_det's det_eval commutes with evaluation for any matrix, so the
% specialization theorem comes free (psc_eval).  The Collins projection
% (col_def) takes them: they decide the common divisors of two polynomials.
%----------------------------------------------------------------------------
BEGIN
  IMPORTING sylvester

  f, g: VAR list[mpoly]
  ys: VAR list[real]

  %% The j-th subresultant matrix.  Rows: dg(g) - j shifts of f, then
  %% dg(f) - j shifts of g, so it is square of side dg(f) + dg(g) - 2j.
  %% Columns b < side - 1 carry degree dg(f) + dg(g) - j - 1 - b; the LAST
  %% column carries degree j, which is what makes the determinant the
  %% PRINCIPAL coefficient rather than the whole subresultant.
  sresm(f, g, (j: nat)): MMat =
    LAMBDA (a, b: nat):
      LET p = dg(f), q = dg(g),
          side = p + q - 2 * j,
          %% the j = 0 case keeps the plain column degree for EVERY b (it is
          %% then the Sylvester matrix of f and g)
          d = IF j = 0 OR b < side - 1 THEN p + q - j - 1 - b ELSE j ENDIF
      IN IF a < q - j THEN coef_at(f, d - (q - j - 1 - a))
         ELSE coef_at(g, d - (p - j - 1 - (a - (q - j))))
         ENDIF

  psc(f, g, (j: nat | 2 * j <= dg(f) + dg(g))): mpoly =
    det(dg(f) + dg(g) - 2 * j, sresm(f, g, j))

  %% and evaluation commutes
  psc_eval: LEMMA FORALL (j: nat): 2 * j <= dg(f) + dg(g) IMPLIES
    meval(psc(f, g, j))(ys) = rdet(dg(f) + dg(g) - 2 * j, ev(sresm(f, g, j), ys))
END subres
