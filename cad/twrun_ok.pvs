twrun_ok: THEORY
%----------------------------------------------------------------------------
% The run over any tower that is a CAD over its sectors: col_out_ok and
% qe2cc_ok's sector facts with the tower as a
% parameter.
%
%   twok_ev      the certificate holds from some u on (decc_walk's okw_ev at
%                each of the finitely many sectors)
%   wsector_recs over a sector, when the certificate holds and the tower is
%                a CAD over every sector (scad?): the sector's records lie in
%                their cells and cover them, the top family is sign-invariant
%                on the top cells -- qe2_ok's secout_sem's hypotheses
%----------------------------------------------------------------------------
BEGIN
  IMPORTING twrun_def, col_out_ok, cad_fold_ok

  u: VAR nat
  TW: VAR Tower
  F: VAR list[list[mpoly]]
  s: VAR Sect
  r: VAR CRec
  o: VAR ORec

  %% the tower is a CAD over each sector of its outer line
  scad?(TW): bool = FORALL s: member(s, sects(rts(cbot(TW)))) IMPLIES cad_over?(TW, scell(s))

  twok_ev: LEMMA cons?(TW) IMPLIES ev?(LAMBDA u: twok(u, TW))

  cad_outw_mem: LEMMA member(o, cad_outw(u, F, TW)) IFF
    EXISTS s, r: member(s, sects(rts(cbot(TW))))
      AND member(r, ctree(u, TW, tables(u, TW, odS(s)), odS(s)))
      AND o = (# rsec := s, radr := r`adr, rsod := r`sod, rsv := osv_of(F, r`sod) #)

  wsector_okt: LEMMA twok(u, TW) AND member(s, sects(rts(cbot(TW))))
    IMPLIES oktw?(u, TW, tables(u, TW, odS(s)), odS(s)) AND scell(s)(den(odS(s)))

  wrec_wf: LEMMA twok(u, TW) AND member(o, cad_outw(u, F, TW)) IMPLIES wf?(o`rsod)

  wsector_recs: LEMMA twok(u, TW) AND scad?(TW) AND member(s, sects(rts(cbot(TW))))
    IMPLIES cad_over?(TW, scell(s))
      AND recin?(TW, scell(s), tlast(TW), secr(s, cad_outw(u, tlast(TW), TW)))
      AND reccov?(TW, scell(s), secr(s, cad_outw(u, tlast(TW), TW)))
      AND fsinv?(TW, scell(s), tlast(TW))
END twrun_ok
