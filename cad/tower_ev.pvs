tower_ev: THEORY
%----------------------------------------------------------------------------
% A tower's walks pass at every cell for every large u, and what a closure
% round reads stops changing.
%
% lvall? is lvok_o at every cell of every level.  By induction on the tower,
% for tables that are valid and eventually constant (the tables are the
% leftmost path's, shared by all the cells of a level): from some u on the
% top walk passes and its separators and so its cells are fixed (lev_ok),
% every cell is well formed (cells_wf), and below each of the
% finitely many cells the same holds (ev_list), so lvall? eventually holds
% and treads_o is eventually constant (tower_ev; cellsr_cong).  The tables
% of a tower are themselves eventually constant (tables_evc).
%----------------------------------------------------------------------------
BEGIN
  IMPORTING lev_ev, innern_sem, ev_nat[OD], ev_nat[Tower], ev_nat[list[CT]]

  u: VAR nat
  TW: VAR Tower
  TB: VAR list[CT]
  TBf: VAR [nat -> list[CT]]
  od, od2: VAR OD

  %% the walk half of okn_o
  lvall?(u, TW, TB, od): RECURSIVE bool =
    IF null?(TW) OR null?(TB) THEN FALSE
    ELSE lvok_o(u, car(TW), od, car(TB)) AND
      (null?(cdr(TW)) OR
        (cons?(cdr(TB)) AND
          (FORALL od2: member(od2, cells_o(feff(car(TW), od), od, car(TB),
                                           seps_t(u, feff(car(TW), od), od, car(TB))))
             IMPLIES lvall?(u, cdr(TW), cdr(TB), od2))))
    ENDIF
  MEASURE length(TW)

  %% tables that are valid, of the tower's length, and eventually constant
  goodtb?(TW, TBf): bool = evc?(TBf) AND FORALL u: vtb?(TBf(u)) AND length(TBf(u)) = length(TW)
  goodtb_car: LEMMA goodtb?(TW, TBf) AND cons?(TW) IMPLIES cons?(TBf(u)) AND valid?(car(TBf(u)))
  goodtb_cdr: LEMMA goodtb?(TW, TBf) AND cons?(TW) IMPLIES goodtb?(cdr(TW), LAMBDA u: cdr(TBf(u)))

  tower_ev: LEMMA FORALL TW: FORALL od, TBf: cons?(TW) AND wf?(od) AND goodtb?(TW, TBf) IMPLIES
    ev?(LAMBDA u: lvall?(u, TW, TBf(u), od)) AND evc?(LAMBDA u: treads_o(u, TW, TBf(u), od))

  tables_evc: LEMMA FORALL TW: FORALL od: wf?(od) IMPLIES evc?(LAMBDA u: tables(u, TW, od))

  tables_vtb: LEMMA FORALL TW: FORALL od: vtb?(tables(u, TW, od))

  tables_good: LEMMA wf?(od) IMPLIES goodtb?(TW, LAMBDA u: tables(u, TW, od))
END tower_ev
