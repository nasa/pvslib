mpoly_cert: THEORY
%----------------------------------------------------------------------------
% Checked factorizations are correct.
%
% mpoly_cert_def's fsplit(U) is a proposed basis B of U, used only when every
% u in U passes the check u = c * (product of b^e over B) by normal forms
% (ucheck?).  Nothing of mpoly_gcd_def is trusted: these lemmas use only the
% check.
%   ucert_eval    a checked u evaluates to c times the product
%   fsplit_cinv   if every member of fsplit(U) has one sign on C, so does
%                 every member of U
%   fsplit_nz     if every member of fsplit(U) is nonzero on C, so is every
%                 member of U
%----------------------------------------------------------------------------
BEGIN
  IMPORTING mpoly_cert_def, col_def, earr_ops

  u, v, b: VAR mpoly
  U, B: VAR list[mpoly]
  E: VAR list[nat]
  c: VAR rat
  n: VAR nat
  C: VAR [list[real] -> bool]
  p, q, xs: VAR list[real]

  %% ---- evaluation ----------------------------------------------------------------------------
  ucert_eval: LEMMA ucert?(u, B, E, c) IMPLIES meval(u)(xs) = c * meval(pprod(B, E))(xs)

  %% ---- one sign on C ---------------------------------------------------------------------------
  cinv_const_mpoly_cert: LEMMA mconst?(u) IMPLIES cinv?(u, C)
  cinv_mul: LEMMA cinv?(u, C) AND cinv?(v, C) IMPLIES cinv?(mmul(u, v), C)
  cinv_pow: LEMMA FORALL n: cinv?(u, C) IMPLIES cinv?(mpow(u, n), C)
  pprod_cinv: LEMMA FORALL B: FORALL E: (FORALL b: member(b, B) IMPLIES cinv?(b, C)) IMPLIES cinv?(pprod(B, E), C)
  ucert_cinv: LEMMA ucert?(u, B, E, c) AND (FORALL b: member(b, B) IMPLIES cinv?(b, C)) IMPLIES cinv?(u, C)
  every_ucheck: LEMMA FORALL U: every(ucheck?(B))(U) AND member(u, U) IMPLIES ucheck?(B)(u)
  fsplit_cinv: LEMMA (FORALL v: member(v, fsplit(U)) IMPLIES cinv?(v, C)) IMPLIES
    FORALL u: member(u, U) IMPLIES cinv?(u, C)

  %% ---- nonzero on C ----------------------------------------------------------------------------
  pprod_nz: LEMMA FORALL B: FORALL E: (FORALL b: member(b, B) IMPLIES meval(b)(xs) /= 0) IMPLIES
    meval(pprod(B, E))(xs) /= 0
  fsplit_nz: LEMMA (FORALL v: member(v, fsplit(U)) IMPLIES FORALL p: C(p) IMPLIES meval(v)(p) /= 0) IMPLIES
    FORALL u: member(u, U) IMPLIES FORALL p: C(p) IMPLIES meval(u)(p) /= 0
END mpoly_cert
