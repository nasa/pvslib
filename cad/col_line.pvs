col_line: THEORY
%----------------------------------------------------------------------------
% THE COLLINS CAD IN EVERY DIMENSION: the line,
% and every number of variables in one theorem.
%
% With one variable (k = 0) the run projects nothing: the line is cut at the
% real roots of F itself (csects_0: csects(0, F) = sects(rts(F))), the tower
% is empty and every cell is a sector (ccell_0: ccell(0, F)(s, A) = scell(s)).
% ccells?(k, F) collects the conditions of col_run's col_cad_run for F in
% k + 1 variables: the cells cover R^(k+1) and are disjoint, every cell at
% every level is connected and first-order definable, over each sector the
% tower is a CAD, the graph of every root function over a cell is definable,
% and F has one sign vector on every cell.
%   col_cad_line  ccells?(0, F): the sectors of the roots of F form a CAD of
%                 the line adapted to F
%   col_cells     ccells?(k, F) for every k: the cells built from Collins'
%                 projection form a CAD adapted to F in every number of
%                 variables, with no certificate
%----------------------------------------------------------------------------
BEGIN
  IMPORTING col_run

  k, i: VAR nat
  F: VAR list[list[mpoly]]
  s, s1, s2: VAR Sect
  A, A1, A2: VAR list[nat]
  p, p1, p2, q: VAR list[real]

  ccells?(k, F): bool =
        (FORALL p: length(p) = k + 1 IMPLIES
           EXISTS s, A: member(s, csects(k, F)) AND length(A) = k AND ccell(k, F)(s, A)(p))
    AND (FORALL p, s1, s2, A1, A2: member(s1, csects(k, F)) AND member(s2, csects(k, F))
           AND length(A1) = k AND length(A2) = k
           AND ccell(k, F)(s1, A1)(p) AND ccell(k, F)(s2, A2)(p)
           IMPLIES s1 = s2 AND A1 = A2)
    AND (FORALL s, A: member(s, csects(k, F)) AND length(A) <= k IMPLIES
           conn?(ccell(k, F)(s, A)) AND fod?(1 + length(A))(ccell(k, F)(s, A)))
    AND (FORALL s: member(s, csects(k, F)) IMPLIES cad_over?(ctw(F, k), scell(s)))
    AND (FORALL s, A, i: member(s, csects(k, F)) AND length(A) < k
           AND (FORALL q: ccell(k, F)(s, A)(q) IMPLIES i < nroot(nth(ctw(F, k), length(A)), q))
           IMPLIES fod?(2 + length(A))
             (LAMBDA p: cons?(p) AND ccell(k, F)(s, A)(cdr(p))
                        AND car(p) = rt(nth(ctw(F, k), length(A)), cdr(p), i)))
    AND (FORALL s, A, p1, p2: member(s, csects(k, F)) AND length(A) = k
           AND ccell(k, F)(s, A)(p1) AND ccell(k, F)(s, A)(p2)
           IMPLIES svec(F, p1) = svec(F, p2))

  %% ---- the line ---------------------------------------------------------------------------------
  csects_0: LEMMA csects(0, F) = sects(rts(F))
  ccell_0: LEMMA ccell(0, F)(s, A) = scell(s)
  scell_fod: LEMMA fod?(1)(scell(s))

  col_cad_line: THEOREM ccells?(0, F)

  %% ---- THE COLLINS CAD, EVERY NUMBER OF VARIABLES -------------------------------------------------
  col_cells: THEOREM ccells?(k, F)
END col_line
