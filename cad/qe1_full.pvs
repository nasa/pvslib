qe1_full: THEORY
%----------------------------------------------------------------------------
% Quantifier elimination for one free variable: the answer is always
% quantifier-free.
%
% With epc_ok every sector description sectX is quantifier-free (qf_sectX),
% so qe1_s's and qe1_sm's answers always are (qe1_sJ_isqf, qe1_sm_isqf);
% qe1c_ok and qe2cd_ok use this for the Collins QE.
%----------------------------------------------------------------------------
BEGIN
  IMPORTING qe1_ok, qe_ep_ok

  s: VAR Sect
  b: VAR Alg
  t: VAR int
  Q: VAR list[list[mpoly]]
  es: VAR list[QEnt]
  J: VAR list[nat]

  qf_cmpX: LEMMA qf?(cmpX(b, t))
  qf_sectX: LEMMA qf?(sectX(s))
  qe1_sJ_isqf: LEMMA qe1_sJ(Q, es, J)`qf
  qe1_sm_isqf: LEMMA qe1_sm(Q, es)`qf
END qe1_full
