gform_ok: THEORY
%----------------------------------------------------------------------------
% The decision of formulas of any shape is correct and always answers.
%
%   g2f_ok       fsem(g2f(g)) is gsem(g): the translation into rcf_fol keeps
%                the meaning (sign3 of the difference for the comparisons,
%                NOT EXISTS NOT for FORALL)
%   qfval_ok     qfval is fsem on quantifier-free formulas
%   decide_g_ok  decide_g(g) IFF gsem(g)(null): qelim_ok at m = 0 and the
%                result's value computed by qfval
%   qe_g_qf      qe_g(g, m) is quantifier-free
%   qe_g_ok      with m free variables: qe_g(g, m) holds at a point with m
%                coordinates exactly when g does
%----------------------------------------------------------------------------
BEGIN
  IMPORTING gform_def, qelim_ok

  g: VAR Gm
  phi: VAR Fm
  pt: VAR list[real]
  m: VAR nat

  qfval_ok: LEMMA FORALL phi: FORALL pt: qf?(phi) IMPLIES (qfval(phi)(pt) IFF fsem(phi)(pt))
  g2f_ok: LEMMA FORALL g: FORALL pt: fsem(g2f(g))(pt) IFF gsem(g)(pt)

  decide_g_ok: THEOREM decide_g(g) IFF gsem(g)(null)

  qe_g_qf: LEMMA qf?(qe_g(g, m))
  qe_g_ok: THEOREM length(pt) = m IMPLIES (fsem(qe_g(g, m))(pt) IFF gsem(g)(pt))

  %% ---- TRUE and FALSE beside other formulas: (cad) rewrites them away first, so
  %% that taking a formula apart never meets a piece PVS would drop ----------------
  bb: VAR bool
  gb_and_tl: LEMMA (TRUE AND bb) = bb
  gb_and_tr: LEMMA (bb AND TRUE) = bb
  gb_and_fl: LEMMA (FALSE AND bb) = FALSE
  gb_and_fr: LEMMA (bb AND FALSE) = FALSE
  gb_or_tl: LEMMA (TRUE OR bb) = TRUE
  gb_or_tr: LEMMA (bb OR TRUE) = TRUE
  gb_or_fl: LEMMA (FALSE OR bb) = bb
  gb_or_fr: LEMMA (bb OR FALSE) = bb
  gb_imp_tl: LEMMA (TRUE IMPLIES bb) = bb
  gb_imp_tr: LEMMA (bb IMPLIES TRUE) = TRUE
  gb_imp_fl: LEMMA (FALSE IMPLIES bb) = TRUE
  gb_imp_fr: LEMMA (bb IMPLIES FALSE) = NOT bb
  gb_iff_tl: LEMMA (TRUE IFF bb) = bb
  gb_iff_tr: LEMMA (bb IFF TRUE) = bb
  gb_iff_fl: LEMMA (FALSE IFF bb) = NOT bb
  gb_iff_fr: LEMMA (bb IFF FALSE) = NOT bb
  gb_not_t: LEMMA (NOT TRUE) = FALSE
  gb_not_f: LEMMA (NOT FALSE) = TRUE
END gform_ok
