nsc_scale: THEORY
%----------------------------------------------------------------------------
% Sign-change counting is blind to positive rescaling.
%
% This is what licenses the whole approach to sh_count.  NASALib's Sturm
% counts sign changes in compute_remainder_seq, whose entries come from
% adjusted_remainder -- and adjusted_remainder_def pins those entries only up
% to a POSITIVE factor:
%
%     polynomial(thispoly, thisdeg) = polynomial(-cp * pd`rem, pd`rdeg)
%     for some cp: posreal
%
% So the entries are the classical Sturm sequence (negated remainders) up to
% positive factors.  That is harmless exactly because the COUNT does not see
% such factors, which is what this theory proves; and it is why a chain
% entry's leading-coefficient SIGN is well defined, which is the quantity the
% psc correspondence is about.
%
% number_sign_changes_eq already does the work once the signs are known to
% agree pointwise, and sign_ext_mult reduces positive rescaling to that.
%----------------------------------------------------------------------------
BEGIN
  IMPORTING Sturm@poly_strategy

  a, b: VAR [nat -> real]
  i: VAR nat

  sign_ext_pos: LEMMA FORALL (cp: posreal), (x: real):
    sign_ext(cp * x) = sign_ext(x)

  nsc_scale: LEMMA (FORALL (j: upto(i)): EXISTS (cp: posreal): b(j) = cp * a(j))
    IMPLIES number_sign_changes(a, i)`num = number_sign_changes(b, i)`num
END nsc_scale
