walk_fuel: THEORY
%----------------------------------------------------------------------------
% The separator search with an explicit fuel.
%
% seps runs swide and sint with the fixed fuel sfuel2 = 24, which a root
% beyond 2^24, or two roots closer than about 2^-23 of the search width,
% exhausts.  seps_n is the same search with fuel n, and seps is seps_n at
% sfuel2.  walk_count and walk_search prove that at every
% exact oracle some fuel makes the search succeed, and that more fuel then
% changes nothing.
%----------------------------------------------------------------------------
BEGIN
  IMPORTING walk_def

  F: VAR list[list[mpoly]]
  sg: VAR SG
  n: VAR nat

  seps_n(F, sg, n): list[rat] =
    IF null?(lives(F)) THEN (: 0 :)
    ELSE LET b: posrat = swide(F, sg, 1, n) IN
         cons(-b, append(sint(F, sg, -b, b, n), (: b :)))
    ENDIF
END walk_fuel
