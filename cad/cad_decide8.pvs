cad_decide8: THEORY
%----------------------------------------------------------------------------
% decide8 is correct and always answers: the Collins
% run by decb_u_correct / decb_u_complete, over the checked basis of the
% input family by fsplit_top's sem_split, fewer quantifiers
% by decq1 (decq1_correct, from cell1's svs1 through qfold_svs1; cell1's
% svs1ok_complete).  decide8_correct is the lemma (cad) instantiates.
%----------------------------------------------------------------------------
BEGIN
  IMPORTING cad_decide8_def, decb_u, fsplit_top, cad_endgame

  qs, os: VAR list[bool]
  F: VAR list[list[mpoly]]
  Psi: VAR [SV -> bool]
  phi: VAR BF
  L: VAR list[bool]

  len_ge2: LEMMA length(L) >= 2 IMPLIES cons?(L) AND cons?(cdr(L))

  q: VAR bool
  %% one quantifier over a cell, and over the bottom level
  qfold_svs1: LEMMA svs1ok(F) IMPLIES (qfold(q, svs1(F), Psi) IFF sem((: q :), F, Psi, null))

  decq1_correct: LEMMA length(qs) <= 1 AND decq1(qs, F, Psi)`ok IMPLIES
    (decq1(qs, F, Psi)`val IFF sem(reverse(qs), F, Psi, null))

  decq8_correct: THEOREM decq8(qs, F, Psi)`ok IMPLIES
    (decq8(qs, F, Psi)`val IFF sem(reverse(qs), F, Psi, null))
  decq8_complete: THEOREM decq8(qs, F, Psi)`ok

  decide8_correct: THEOREM decide8(reverse(os), F, phi)`ok IMPLIES
    (decide8(reverse(os), F, phi)`val IFF fsem(os, F, phi, null))
  decide8_decides: THEOREM decide8(reverse(os), F, phi)`val IFF fsem(os, F, phi, null)
END cad_decide8
