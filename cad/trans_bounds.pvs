trans_bounds: THEORY
%----------------------------------------------------------------------------
% Polynomial bounds of transcendental functions on whole ranges, in the form
% (cad) reads: no division but by numbers, and no condition
% on the argument but a comparison (ln_bnd's x > 0), so that an instance
% raises no TCC.  Each comes from NASALib's trig and lnexp lemmas; exp(x) > 0
% is exp's type.  T5 adds them as facts about sin(t), cos(t), exp(t), ln(t)
% and atan(t) when t holds constants of the sequent, beside interval
% enclosures: they hold up to the points where the two sides touch
% (sin(c) <= c at c = 0), where no enclosure can show it.  cad-num takes
% them by rungs: the ranges, then the bounds of degree 3, last those of
% higher degree.
%----------------------------------------------------------------------------
BEGIN
  IMPORTING trig@trig_approx, lnexp@ln_exp_ineq

  x: VAR real

  %% the ranges
  sin_bnd_rng: LEMMA -1 <= sin(x) AND sin(x) <= 1
  cos_bnd_rng: LEMMA -1 <= cos(x) AND cos(x) <= 1
  atan_bnd_rng: LEMMA -8/5 < atan(x) AND atan(x) < 8/5

  %% degree 3
  sin_bnd_pos: LEMMA x >= 0 IMPLIES x - x^3 / 6 <= sin(x) AND sin(x) <= x
  sin_bnd_neg: LEMMA x <= 0 IMPLIES x <= sin(x) AND sin(x) <= x - x^3 / 6
  cos_bnd: LEMMA 1 - x^2 / 2 <= cos(x)
  exp_bnd_lb: LEMMA 1 + x <= exp(x)
  exp_bnd_ub: LEMMA x < 1 IMPLIES (1 - x) * exp(x) <= 1
  ln_bnd: LEMMA x > 0 IMPLIES x - 1 <= x * ln(x) AND ln(x) <= x - 1
  atan_bnd_pos: LEMMA x >= 0 IMPLIES x <= (1 + x^2) * atan(x) AND atan(x) <= x
  atan_bnd_neg: LEMMA x <= 0 IMPLIES x <= atan(x) AND (1 + x^2) * atan(x) <= x

  %% higher degree: NASALib's sin_bounds and cos_bounds at n = 1, whose
  %% Taylor sums are these polynomials
  sin_approx_5: LEMMA sin_approx(x, 2) = x - x^3 / 6 + x^5 / 120
  sin_approx_7: LEMMA sin_approx(x, 3) = x - x^3 / 6 + x^5 / 120 - x^7 / 5040
  cos_approx_4: LEMMA cos_approx(x, 2) = 1 - x^2 / 2 + x^4 / 24
  cos_approx_6: LEMMA cos_approx(x, 3) = 1 - x^2 / 2 + x^4 / 24 - x^6 / 720

  sin_bnd7_pos: LEMMA x >= 0 IMPLIES
    x - x^3 / 6 + x^5 / 120 - x^7 / 5040 <= sin(x) AND sin(x) <= x - x^3 / 6 + x^5 / 120
  sin_bnd7_neg: LEMMA x <= 0 IMPLIES
    x - x^3 / 6 + x^5 / 120 <= sin(x) AND sin(x) <= x - x^3 / 6 + x^5 / 120 - x^7 / 5040
  cos_bnd6: LEMMA
    1 - x^2 / 2 + x^4 / 24 - x^6 / 720 <= cos(x) AND cos(x) <= 1 - x^2 / 2 + x^4 / 24
END trans_bounds
