cad_slab: THEORY
%----------------------------------------------------------------------------
% Slabs over a connected set are connected.
%
% A slab over C is a set of points cons(y, q) with q in C and y in a slice
% S(q) of the real line.  If C is connected, every slice is an interval
% (conv?), and a continuous section m runs through the slices (m(q) in S(q)),
% the slab is connected (conn_slab).  Graphs of continuous functions (one-
% point slices), bands between two continuous functions, the half-bands
% below and above one, and the whole cylinder are all slabs; so every cell
% of a stack over a connected cell is connected.
%
% Proof: along a slice, a locally constant property is constant (conn_line);
% along the section it is locally constant on C, because the section is
% continuous, hence constant (C is connected).  Two points of the slab are
% joined slice - section - section - slice.
%----------------------------------------------------------------------------
BEGIN
  IMPORTING cad_conn

  C, C1, C2: VAR [list[real] -> bool]
  Phi: VAR [list[real] -> bool]
  S: VAR [list[real] -> [real -> bool]]
  m, r, r1, r2: VAR [list[real] -> real]
  p, q, q0, p0: VAR list[real]
  y, c: VAR real

  slab(C, S)(p): bool = cons?(p) AND C(cdr(p)) AND S(cdr(p))(car(p))

  %% locally constant on a set is locally constant on a subset
  lcon_sub: LEMMA (FORALL p: C1(p) IMPLIES C2(p)) AND lcon?(Phi, C2) IMPLIES lcon?(Phi, C1)

  %% continuity of sections built from continuous ones
  cont_const_slab: LEMMA cont_on?(LAMBDA q: c, C)
  cont_plus: LEMMA cont_on?(r, C) IMPLIES cont_on?(LAMBDA q: r(q) + c, C)
  cont_mid: LEMMA cont_on?(r1, C) AND cont_on?(r2, C) IMPLIES cont_on?(LAMBDA q: (r1(q) + r2(q)) / 2, C)

  %% the section: Phi along it is locally constant on C
  sec_lcon: LEMMA lcon?(Phi, slab(C, S)) AND cont_on?(m, C) AND (FORALL q: C(q) IMPLIES S(q)(m(q)))
    IMPLIES lcon?(LAMBDA q: Phi(cons(m(q), q)), C)

  %% along a slice, to the section
  slab_vert: LEMMA lcon?(Phi, slab(C, S)) AND slab(C, S)(p)
    AND conv?(S(cdr(p))) AND S(cdr(p))(m(cdr(p)))
    IMPLIES (Phi(p) IFF Phi(cons(m(cdr(p)), cdr(p))))

  conn_slab: THEOREM conn?(C) AND cont_on?(m, C)
    AND (FORALL q: C(q) IMPLIES conv?(S(q)) AND S(q)(m(q)))
    IMPLIES conn?(slab(C, S))

  %% the empty set is connected
  conn_empty: LEMMA (FORALL p: NOT C(p)) IMPLIES conn?(C)
END cad_slab
