map_member[T, U: TYPE]: THEORY
%----------------------------------------------------------------------------
% Membership in a mapped list: the image of a member is a member of the
% image, and every member of the image is the image of a member.
%----------------------------------------------------------------------------
BEGIN
  g: VAR [T -> U]
  a: VAR T
  v: VAR U
  l: VAR list[T]

  map_mem: LEMMA FORALL l: member(a, l) IMPLIES member(g(a), map(g)(l))
  map_mem_inv_map_member: LEMMA FORALL l: member(v, map(g)(l)) IMPLIES EXISTS a: member(a, l) AND v = g(a)
END map_member
