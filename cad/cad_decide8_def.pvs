cad_decide8_def: THEORY
%----------------------------------------------------------------------------
% The decision behind (cad) in a theory that imports cad_decide8: the
% Collins run.  Executable.
%
% A sentence with two or more quantifiers goes to decb_u: decb_o, the walk
% over the tower of Collins projections of the family with the line cut by
% the smaller bottom-step projection (decb_def; decc_o, the
% walk with Collins' bottom step, when the smaller one's check fails), from
% u = 0, raising u until its certificate holds (decb_u_def); it always
% answers (decb_u's decb_u_complete).  The family it decides over is a basis
% of the input family (mpoly_gcd_def's, meant to be squarefree) when the
% product check confirms that it factors every input polynomial
% (fsplit_top_def), with the matrix reading the
% basis' signs through smap; otherwise the input family itself.  With one
% quantifier or none it goes to decq1: the sign vector of the constants, or
% the fold over the sign vectors at the sectors of the line (cell1's svs1).
%----------------------------------------------------------------------------
BEGIN
  IMPORTING decb_u_def, fsplit_top_def

  qs: VAR list[bool]
  F: VAR list[list[mpoly]]
  Psi: VAR [SV -> bool]
  phi: VAR BF

  %% no quantifier, or one: the sign vector of the constants, or the fold over
  %% the sign vectors at the sectors of the line (cell1's svs1)
  decq1(qs, F, Psi): [# ok: bool, val: bool #] =
    IF null?(qs) THEN (# ok := TRUE, val := Psi(svec(F, null[real])) #)
    ELSE (# ok := svs1ok(F), val := qfold(car(qs), svs1(F), Psi) #) ENDIF

  decq8(qs, F, Psi): [# ok: bool, val: bool #] =
    IF length(qs) >= 2 THEN
      LET U = ubs(F), B = basis(U) IN
        IF every(ucheck?(B))(U) THEN decb_u(reverse(qs), fam(B), spsi(map(sce(B))(U), Psi), 0)
        ELSE decb_u(reverse(qs), F, Psi, 0) ENDIF
    ELSE decq1(qs, F, Psi) ENDIF

  decide8(qs, F, phi): [# ok: bool, val: bool #] = decq8(qs, F, LAMBDA (v: SV): bfsv(phi, v))
END cad_decide8_def
