qelim_ok: THEORY
%----------------------------------------------------------------------------
% TARSKI-SEIDENBERG FOR EVERY FIRST-ORDER FORMULA: every set definable by a
% first-order formula over the reals (rcf_fol's Fm: rational coefficients,
% no real parameters) is definable by a quantifier-free one.
%
%   enc_ok    a quantifier-free M whose atoms sit at positions i, i + 1, ...
%             of the family G (atw?): encB(M, i) over G means M
%   qelim_qf  qelim(phi, m) is quantifier-free
%   qelim_ok  it holds at a point with m coordinates exactly when phi does
%             (induction on phi; under fex: qe8_complete with m free
%             variables, decide8_decides when m = 0)
%   fod_qfd   fod?(n)(S) IFF qfd?(n)(S): the sets definable by a first-order
%             formula (rational constants, no real parameters) are the
%             quantifier-free definable ones, Boolean combinations of sign
%             conditions on polynomials with rational coefficients, i.e. the
%             semi-algebraic sets defined over Q.  Every such set is
%             semi-algebraic in the sense of Basu-Pollack-Roy and
%             Bochnak-Coste-Roy, whose definition allows real coefficients
%             (a larger class: {pi} is semi-algebraic but not qfd?(1))
%----------------------------------------------------------------------------
BEGIN
  IMPORTING qelim_def, qe8, cad_decide8

  M, phi, a, b: VAR Fm
  i, j, m, n: VAR nat
  G: VAR list[list[mpoly]]
  B: VAR BF
  pt, xs: VAR list[real]
  S: VAR [list[real] -> bool]

  %% ---- the encoding of a quantifier-free formula ---------------------------------------
  atw?(M, G, i): bool = FORALL j: j < length(atomsF(M)) IMPLIES
    i + j < length(G) AND nth(G, i + j) = as_list(nth(atomsF(M), j))

  atw_not: LEMMA atw?(fnot(a), G, i) IMPLIES atw?(a, G, i)
  atw_andl: LEMMA atw?(fand(a, b), G, i) IMPLIES atw?(a, G, i)
  atw_andr: LEMMA atw?(fand(a, b), G, i) IMPLIES atw?(b, G, i + length(atomsF(a)))

  enc_ok: LEMMA FORALL M: FORALL G, i, xs: qf?(M) AND atw?(M, G, i)
    IMPLIES (bfeval(encB(M, i), G, xs) IFF fsem(M)(xs))
  encF_ok: LEMMA qf?(M) IMPLIES (bfeval(encB(M, 0), encF(M), xs) IFF fsem(M)(xs))

  %% one existential quantifier over the encoding
  fsem_ex1: LEMMA fsem((: FALSE :), G, B, xs) IFF EXISTS (x: real): bfeval(B, G, cons(x, xs))

  %% ---- quantifier elimination for every formula ----------------------------------------
  qelim_qf: LEMMA FORALL phi: FORALL m: qf?(qelim(phi, m))
  qelim_ok: THEOREM FORALL phi: FORALL m, pt: length(pt) = m
    IMPLIES (fsem(qelim(phi, m))(pt) IFF fsem(phi)(pt))

  %% ---- definable sets are semi-algebraic ------------------------------------------------
  qfd?(n)(S): bool = EXISTS phi: qf?(phi) AND FORALL pt: length(pt) = n IMPLIES (S(pt) IFF fsem(phi)(pt))
  fod_qfd: THEOREM fod?(n)(S) IFF qfd?(n)(S)
END qelim_ok
