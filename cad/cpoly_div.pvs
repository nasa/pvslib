cpoly_div: THEORY
%----------------------------------------------------------------------------
% Divisibility and common divisors of complex polynomials.
%
% cdvd?(H, P): P = H * Q for a polynomial Q.  ccd?(F, G, k): F and G have a
% common monic divisor of degree k, written as a product of k linear factors
% cpr(r, k); the largest such k is the degree of the gcd, without defining
% the gcd.  The subresultant theorem (sres_thm) is stated with ccd?.
%   ccd_0, ccd_down    every pair has the divisor 1; ccd? is downward closed
%   cdvd_cof           the cofactor of a divisor of a polynomial of exact
%                      degree p has degree p - k and the same leading
%                      coefficient
%   ccd_up             a common root of the cofactors gives one more factor
%   ccoprime           G | U F with no common root of G and F gives G | U
%                      (induction on deg G: peel a root of G off U)
%----------------------------------------------------------------------------
BEGIN
  IMPORTING cpoly_alg

  F, G, P, Q, U, V, W, H, T: VAR [complex -> complex]
  r, s: VAR [nat -> complex]
  n, m, k, p, q, n0, n1, n2: VAR nat
  z, y, c, d: VAR complex

  cdvd?(H, P): bool = EXISTS Q, m: cpol?(Q, m) AND FORALL z: P(z) = H(z) * Q(z)

  ccd?(F, G, k): bool = EXISTS r: cdvd?(cpr(r, k), F) AND cdvd?(cpr(r, k), G)

  %% ---- basic facts ------------------------------------------------------------------------
  clead_0: LEMMA clead?(P, 0, c) IMPLIES FORALL z: P(z) = c
  clead_root: LEMMA clead?(P, n, c) AND P(y) = real_(0) IMPLIES n > 0
  clead_has_root: LEMMA clead?(P, n, c) AND n > 0 IMPLIES EXISTS y: P(y) = real_(0)

  ccd_0: LEMMA cpol?(F, p) AND cpol?(G, q) IMPLIES ccd?(F, G, 0)
  ccd_down: LEMMA ccd?(F, G, k + 1) IMPLIES ccd?(F, G, k)
  ccd_le: LEMMA FORALL k: ccd?(F, G, k) AND m <= k IMPLIES ccd?(F, G, m)

  cdvd_cof: LEMMA clead?(F, p, c) AND cdvd?(cpr(r, k), F) IMPLIES
    k <= p AND EXISTS Q: clead?(Q, p - k, c) AND FORALL z: F(z) = cprod(r, k)(z) * Q(z)

  ccd_le_deg: LEMMA clead?(F, p, c) AND ccd?(F, G, k) IMPLIES k <= p
  ccd_le_deg2: LEMMA clead?(G, q, d) AND ccd?(F, G, k) IMPLIES k <= q

  %% ---- one more common factor ---------------------------------------------------------------
  extend_cprod: LEMMA cprod(extend(r, k, y), k + 1)(z) = (z - y) * cprod(r, k)(z)
  ccd_up: LEMMA (FORALL z: F(z) = cprod(r, k)(z) * U(z)) AND (FORALL z: G(z) = cprod(r, k)(z) * V(z))
    AND clead?(U, n0, c) AND clead?(V, n1, d) AND U(y) = real_(0) AND V(y) = real_(0)
    IMPLIES ccd?(F, G, k + 1)

  %% ---- coprime cancellation ------------------------------------------------------------------
  ccoprime: LEMMA FORALL m: FORALL G, U, F, W, c, n0, n1, n2:
    clead?(G, m, c) AND cpol?(U, n0) AND cpol?(F, n1) AND cpol?(W, n2)
    AND (FORALL z: G(z) = real_(0) IMPLIES F(z) /= real_(0))
    AND (FORALL z: U(z) * F(z) = G(z) * W(z))
    IMPLIES cdvd?(G, U)
END cpoly_div
