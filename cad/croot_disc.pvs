croot_disc: THEORY
%----------------------------------------------------------------------------
% One root per disc: the pigeonhole step of the local Collins argument.
%
% sep?(L, eps): distinct members of L are at least 2 eps apart, so a point
% is within eps of at most one of them (sep_one).  covers?(Lz, A, eps): every
% member of A has a member of Lz within eps.
%   cover_len  a list covering an eps-separated distinct list A is at least
%              as long as A (each member of A uses up its own member of Lz:
%              remove it with rm1 and recurse)
%   disc_one   if L2 covers the eps-separated distinct list L1 and is no
%              longer than L1, no member of L1 has two members of L2 within
%              eps: removing one of them would leave a cover that is too
%              short
% With L1 the distinct roots of a polynomial at p1 and L2 those at a nearby p
% (col_pair shows there are as many, and rp_lsc that they cover), every disc around
% a root at p1 holds exactly one root at p.
%----------------------------------------------------------------------------
BEGIN
  IMPORTING croot_lsc

  L, L1, L2, Lz, A: VAR list[complex]
  a, b, x, z, w: VAR complex
  eps: VAR posreal

  %% remove the first occurrence of x
  rm1(x, L): RECURSIVE list[complex] =
    IF null?(L) THEN null[complex]
    ELSIF car(L) = x THEN cdr(L)
    ELSE cons(car(L), rm1(x, cdr(L)))
    ENDIF
  MEASURE length(L)

  mem_cons_croot_disc: LEMMA member(z, cons(a, L)) IFF z = a OR member(z, L)
  rm1_len: LEMMA FORALL L: member(x, L) IMPLIES length(rm1(x, L)) + 1 = length(L)
  rm1_mem: LEMMA FORALL L: member(z, L) AND z /= x IMPLIES member(z, rm1(x, L))

  %% ---- separated lists and covers ------------------------------------------------------------
  sep?(L, eps): bool = FORALL a, b: member(a, L) AND member(b, L) AND a /= b IMPLIES abs(a - b) >= 2 * eps
  covers?(Lz, A, eps): bool = FORALL a: member(a, A) IMPLIES EXISTS z: member(z, Lz) AND abs(z - a) < eps

  sep_one: LEMMA sep?(L, eps) AND member(a, L) AND member(b, L) AND abs(z - a) < eps AND abs(z - b) < eps
    IMPLIES a = b
  sep_cdr: LEMMA sep?(cons(a, L), eps) IMPLIES sep?(L, eps)

  cover_len: LEMMA FORALL A: FORALL Lz: dist?(A) AND sep?(A, eps) AND covers?(Lz, A, eps)
    IMPLIES length(A) <= length(Lz)

  disc_one: LEMMA dist?(L1) AND sep?(L1, eps) AND length(L2) <= length(L1) AND covers?(L2, L1, eps)
    AND member(a, L1) AND member(z, L2) AND member(w, L2) AND abs(z - a) < eps AND abs(w - a) < eps
    IMPLIES z = w
END croot_disc
