root_fol: THEORY
%----------------------------------------------------------------------------
% The stack index is first-order definable.  The formulas are rcf_cad_def's.
%
% rootF_ok: rootF(G) holds at cons(v, q) iff v is a root over q (rootat?).
% geF_ok: geF(G, i) holds at cons(u, q) iff at least i entries of the root
% list lie below u -- a root z < u with at least i - 1 below z; the witness
% for the converse is the i-th root (nlt_mem, nth_below).  sidxF_ok: sidxF(G,
% a) holds at cons(y, q) iff the stack index of y over q is a.  stkF_ok: over
% a set defined by phi, stkF defines its stack cell of index a.  The root
% list exists at every point (rl_all, from rtl_ok and certz_all), so no
% hypothesis on q is needed.
%----------------------------------------------------------------------------
BEGIN
  IMPORTING rcf_cad_def, mpoly_embed, cad_stkc, cert_all

  G: VAR list[list[mpoly]]
  g: VAR list[mpoly]
  q, p: VAR list[real]
  u, v, y, z: VAR real
  i, j, a, n: VAR nat
  L: VAR list[real]
  C: VAR [list[real] -> bool]
  phi: VAR Fm

  pdel0: LEMMA pdel(cons(v, q), 0) = q
  pdel1: LEMMA pdel(cons(z, cons(v, q)), 1) = cons(z, q)
  s3_zero: LEMMA sign3(z) = 0 IFF z = 0
  s3_neg: LEMMA sign3(z) = -1 IFF z < 0
  s3_pos: LEMMA sign3(z) = 1 IFF z > 0
  lt21_ok: LEMMA meval(lt21)(cons(z, cons(u, q))) = u - z
  rl_all: LEMMA rl?(G, q)(rtl(G, q))

  %% ---- v is a root over q -------------------------------------------------------------------
  nzF_ok: LEMMA fsem(nzF(g))(cons(v, q)) IFF EXISTS z: meval(mpol(g))(cons(z, q)) /= 0
  rootF_ok: LEMMA FORALL G: fsem(rootF(G))(cons(v, q)) IFF rootat?(G, q)(v)

  %% ---- at least i roots below u --------------------------------------------------------------
  nth_below: LEMMA sincr?(L) AND j < length(L) AND j < nlt(L, y) IMPLIES nth(L, j) < y
  geF_ok: LEMMA FORALL i: FORALL u, q: fsem(geF(G, i))(cons(u, q)) IFF i <= nlt(rtl(G, q), u)

  %% ---- the stack index and the stack cell -------------------------------------------------------
  sidxF_ok: LEMMA fsem(sidxF(G, a))(cons(y, q)) IFF sidx(G, q, y) = a
  stkF_ok: LEMMA (FORALL q: length(q) = n IMPLIES (C(q) IFF fsem(phi)(q))) AND length(p) = n + 1
    IMPLIES (stk(G, C, a)(p) IFF fsem(stkF(G, phi, a))(p))
END root_fol
