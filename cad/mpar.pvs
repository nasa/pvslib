mpar: THEORY
%----------------------------------------------------------------------------
% Continuity in ALL coordinates, and persistence of finitely many signs, in
% many parameters.
%
% near?(vs1, vs0, d): the two valuations have the same length and every
% coordinate of vs1 is within d of the one of vs0.  meval is continuous for
% this (mev_mcont, by induction on the term through prod_cont), so finitely
% many polynomials each nonzero at vs0 keep their signs on a neighbourhood
% of vs0.
%----------------------------------------------------------------------------
BEGIN
  IMPORTING mpoly_def, reals@abs_lems, reals@real_orders, structures@listn

  u: VAR mpoly
  vs, vs0, vs1: VAR list[real]
  x, x0, a, b, a0, b0: VAR real
  d, d1, e: VAR posreal

  near?(vs1, vs0, d): RECURSIVE bool =
    IF null?(vs0) THEN null?(vs1)
    ELSE cons?(vs1) AND abs(car(vs1) - car(vs0)) < d AND near?(cdr(vs1), cdr(vs0), d)
    ENDIF
  MEASURE length(vs0)

  near_refl: LEMMA FORALL vs: near?(vs, vs, d)
  near_cons: LEMMA near?(cons(x, vs1), cons(x0, vs0), d) IFF (abs(x - x0) < d AND near?(vs1, vs0, d))
  near_mono: LEMMA FORALL vs0: FORALL vs1: near?(vs1, vs0, d) AND d <= d1 IMPLIES near?(vs1, vs0, d1)
  near_hd: LEMMA near?(vs1, vs0, d) IMPLIES abs(hd(vs1) - hd(vs0)) < d
  near_tl: LEMMA near?(vs1, vs0, d) IMPLIES near?(tl(vs1), tl(vs0), d)

  %% sums and products of nearby numbers
  sum_near: LEMMA abs(a - a0) < e / 2 AND abs(b - b0) < e / 2 IMPLIES abs((a + b) - (a0 + b0)) < e
  mprod_bound: LEMMA abs(a - a0) < d AND abs(b - b0) < d AND d <= 1 IMPLIES
    abs(a * b - a0 * b0) < (abs(a0) + abs(b0) + 1) * d
  prod_cont: LEMMA EXISTS d: FORALL a, b: abs(a - a0) < d AND abs(b - b0) < d IMPLIES
    abs(a * b - a0 * b0) < e

  mev_mcont: THEOREM FORALL u: FORALL vs0: FORALL e: EXISTS d: FORALL vs1:
    near?(vs1, vs0, d) IMPLIES abs(meval(u)(vs1) - meval(u)(vs0)) < e
END mpar
