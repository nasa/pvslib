qe1c_ok: THEORY
%----------------------------------------------------------------------------
% Collins quantifier elimination for one free variable is correct,
% quantifier-free and always answers, from the answer
% layer of qe1_ok and qe1_full.
%
%   qe1cc_correct  a certified answer is quantifier-free and equivalent:
%                  qfsem(out)((: x :)) IFF sem(qb, F, Psi, (: x :))
%   qe1cc_bf       for every prenex formula with one free variable and at
%                  least one bound one, qe1cc answers, quantifier-free, with
%                  qfsem(out)((: x :)) IFF fsem(os, F, phi, (: x :))
%
% Each entry's value is the inner truth on its sector (decc_ok's
% colsect_sem), its signs are those of the outer family there (qe1_ok's
% sig1_inv), the sectors cover the line, and qe1_sm turns such entries into
% an equivalent formula (qe1_sm_sem), always quantifier-free (qe1_sm_isqf).
% The certificate is decc_o's, so it holds from some u on.
%----------------------------------------------------------------------------
BEGIN
  IMPORTING qe1c_def, qe1_full

  u: VAR nat
  qb, os: VAR list[bool]
  F: VAR list[list[mpoly]]
  Psi: VAR [SV -> bool]
  phi: VAR BF
  x: VAR real
  e: VAR QEnt

  %% ---- the entries ------------------------------------------------------------------------------
  qe1cc_ent: LEMMA cons?(qb) AND gaps_ok(rts(pbot(F, length(qb))))
    AND every(okc?(u))(map(cscof(u, ctw(F, length(qb))))(sects(rts(pbot(F, length(qb))))))
    AND member(e, map(qent(u, qb, Psi, pbot(F, length(qb))))
                     (map(cscof(u, ctw(F, length(qb))))(sects(rts(pbot(F, length(qb)))))))
    AND in?(e`esec, x)
    IMPLIES (e`ev IFF sem(qb, F, Psi, (: x :))) AND e`esig = svec(pbot(F, length(qb)), (: x :))

  qe1cc_cov: LEMMA EXISTS e:
    member(e, map(qent(u, qb, Psi, pbot(F, length(qb))))
                 (map(cscof(u, ctw(F, length(qb))))(sects(rts(pbot(F, length(qb)))))))
    AND in?(e`esec, x)

  %% ---- the answer ---------------------------------------------------------------------------------
  qe1cc_correct: THEOREM qe1cc_o(u, qb, F, Psi)`ok IMPLIES
    qf?(qe1cc_o(u, qb, F, Psi)`out)
    AND (qfsem(qe1cc_o(u, qb, F, Psi)`out)((: x :)) IFF sem(qb, F, Psi, (: x :)))

  qe1cc_u_ok: THEOREM cons?(qb) IMPLIES qe1cc_u(qb, F, Psi, u)`ok
  qe1cc_u_eq: LEMMA EXISTS (u2: nat): qe1cc_u(qb, F, Psi, u) = qe1cc_o(u2, qb, F, Psi)

  qe1cc_bf: THEOREM cons?(os) IMPLIES
    qe1cc(os, F, phi)`ok AND qf?(qe1cc(os, F, phi)`out)
    AND (qfsem(qe1cc(os, F, phi)`out)((: x :)) IFF fsem(os, F, phi, (: x :)))
END qe1c_ok
