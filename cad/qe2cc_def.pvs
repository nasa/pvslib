qe2cc_def: THEORY
%----------------------------------------------------------------------------
% Quantifier elimination for m >= 2 free variables over the Collins tower.
% Executable.
%
% qe2_def's answer on the Collins run: every sector s of the outer line
% carries the same tower ctw(F, k) (k = m - 1 + #bound), the records of
% cad_outc in s give the free cells and their values, and secout writes the
% answer on s (sign conditions on the free levels' polynomials when they
% separate the free cells, else the cells' first-order formulas), joined
% with the sector's formula sectX(s).  The answer is quantifier-free
% exactly when its qf flag says so.  qe2cc_u raises u until decc_o's
% certificate holds (decc_ev).
%----------------------------------------------------------------------------
BEGIN
  IMPORTING qe2_def, col_out, decc_u_def

  u: VAR nat
  m: VAR posnat
  qb: VAR list[bool]
  F: VAR list[list[mpoly]]
  Psi: VAR [SV -> bool]
  bphi: VAR BF

  qe2cc_c(u, m, qb, F, Psi): QER =
    LET k = m - 1 + length(qb),
        TW = ctw(F, k),
        R = cad_outc(u, qsn(m + length(qb)), F),
        parts = map(LAMBDA (s: Sect):
                      LET so = secout(m, qb, Psi, s, TW, secr(s, R)) IN
                      IF so = ffalse THEN ffalse
                      ELSIF so = ftrue THEN liftF(sectX(s), m - 1)
                      ELSE fand(liftF(sectX(s), m - 1), so) ENDIF)
                   (sects(rts(cbot(TW)))),
        o = f_orl(filter(LAMBDA (f: Fm): f /= ffalse)(parts)) IN
    (# ok := TRUE, qf := qf?(o), out := o #)

  qe2cc_o(u, m, qb, F, Psi): QER =
    IF m >= 2 AND cons?(qb) AND decc_o(u, qsn(m + length(qb)), F, Psi)`ok
      THEN qe2cc_c(u, m, qb, F, Psi) ELSE qbad ENDIF

  qe2cc_u(m, qb, F, Psi, u): RECURSIVE QER =
    LET dd = qe2cc_o(u, m, qb, F, Psi) IN
    IF dd`ok OR m < 2 OR null?(qb) THEN dd ELSE qe2cc_u(m, qb, F, Psi, u + 1) ENDIF
  MEASURE umc(qsn(m + length(qb)), F, Psi, u)

  qe2cc(m, qb, F, bphi): QER = qe2cc_u(m, qb, F, LAMBDA (v: SV): bfsv(bphi, v), 0)
END qe2cc_def
