rcf_cells: THEORY
%----------------------------------------------------------------------------
% The cells of a cylindrical decomposition are first-order definable.
%
% sectF_ok: sectF(s) defines the sector s of the line, through cmpF_ok
% (x - value(b) has sign t iff some z with p(z) = 0 and lb <= z <= ub has
% sign3(x - z) = t; the root of an algebraic number is unique in its CLOSED
% interval, value_char).  cellF_ok: over a base set defined by phi, cellF
% defines the tower's cell with stack indices A, for any A no longer than
% the tower -- so the cells of every level are covered; no certificate is
% needed, since the root lists exist at every point.  col_run applies them
% to the Collins run (col_cad_run).
% graph_fod: over a definable cell where the i-th root exists, the graph of
% the i-th root function is definable (it is the stack cell of index 2i+1,
% sec_graph), so the section functions are definable too (BPR Def. 5.1).
%
% "Definable" means by a first-order formula over the reals with rational
% polynomial sign atoms; such sets are also definable without quantifiers
% (qelim_ok's fod_qfd, the Tarski-Seidenberg theorem), so semi-algebraic,
% indeed defined over Q; cad_sa states it for the cells of the Collins CAD
% (col_cells_sa).
%----------------------------------------------------------------------------
BEGIN
  IMPORTING root_fol, alg_isign, cad_run

  ql: VAR list[rat]
  x, z: VAR real
  ys, p, q: VAR list[real]
  b: VAR Alg
  t: VAR int
  s: VAR Sect
  TW: VAR Tower
  C: VAR [list[real] -> bool]
  phi: VAR Fm
  A: VAR list[nat]
  n, i: VAR nat
  G: VAR list[list[mpoly]]

  %% ---- the sectors of the line --------------------------------------------------------------
  meval_pmc: LEMMA FORALL ql: cons?(ql) IMPLIES meval(mpol(pmc(ql)))(cons(x, ys)) = polylist(ql)(x)
  cmpF_ok: LEMMA fsem(cmpF(b, t))(cons(x, ys)) IFF sign3(x - value(b)) = t
  sectF_ok: LEMMA fsem(sectF(s))(cons(x, ys)) IFF in?(s, x)
  scell_ok: LEMMA length(p) = 1 IMPLIES (scell(s)(p) IFF fsem(sectF(s))(p))

  %% ---- the cells of a tower -------------------------------------------------------------------
  cellF_ok: LEMMA FORALL TW: FORALL C, phi, A, n, p:
    length(A) <= length(TW) AND (FORALL q: length(q) = n IMPLIES (C(q) IFF fsem(phi)(q)))
    AND length(p) = n + length(A)
    IMPLIES (tcell(TW, C, A)(p) IFF fsem(cellF(TW, phi, A))(p))

  %% ---- the section functions --------------------------------------------------------------------
  sec_graph: LEMMA (FORALL q: C(q) IMPLIES i < nroot(G, q)) IMPLIES
    (stk(G, C, 2 * i + 1)(p) IFF (cons?(p) AND C(cdr(p)) AND car(p) = rt(G, cdr(p), i)))
  graph_fod: LEMMA fod?(n)(C) AND (FORALL q: C(q) IMPLIES i < nroot(G, q)) IMPLIES
    fod?(n + 1)(LAMBDA p: cons?(p) AND C(cdr(p)) AND car(p) = rt(G, cdr(p), i))
END rcf_cells
