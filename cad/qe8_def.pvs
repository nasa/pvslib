qe8_def: THEORY
%----------------------------------------------------------------------------
% Quantifier elimination over the Collins run.
% Executable; (cad-qe) uses it in a theory that imports qe8.
%
% qe8(m, os, F, phi): with one free variable qe1cc (the Collins run;
% always quantifier-free); with m >= 2 qe2cc (the Collins run) when its
% answer is quantifier-free, otherwise qe2cd (the Collins run with the
% free families closed under the derivative, always quantifier-free).
% Every branch is the Collins run; the read-closure engine is not used.
%----------------------------------------------------------------------------
BEGIN
  IMPORTING qe1c_def, qe2cc_def, qe2cd_def

  m: VAR posnat
  os: VAR list[bool]
  F: VAR list[list[mpoly]]
  phi: VAR BF

  qe8(m, os, F, phi): QER =
    IF m = 1 THEN qe1cc(os, F, phi)
    ELSE LET r = qe2cc(m, os, F, phi) IN IF r`qf THEN r ELSE qe2cd(m, os, F, phi) ENDIF
    ENDIF
END qe8_def
