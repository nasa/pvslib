alg_rat: THEORY
%----------------------------------------------------------------------------
% alg_rat_def's rational values are right.
%
%   qroot_r   a candidate qroot returns is THE root of a`p in a's interval
%   ratx_r    so a rational value ratx finds is value(a)
%   ratx_b    and the number it returns otherwise has the same value
%----------------------------------------------------------------------------
BEGIN
  IMPORTING alg_rat_def

  a: VAR Alg
  rs: VAR list[rat]

  qroot_r: LEMMA FORALL rs: cons?(qroot(a, rs)) IMPLIES car(qroot(a, rs)) = value(a)
  ratx_r: LEMMA cons?(ratx(a)`r) IMPLIES car(ratx(a)`r) = value(a)
  ratx_b: LEMMA value(ratx(a)`b) = value(a)
END alg_rat
