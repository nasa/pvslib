fsplit_top: THEORY
%----------------------------------------------------------------------------
% Deciding over the checked basis of the input family.
%
% When a member u of F passes the check over B (u = c * product of b^e,
% mpoly_cert's ucert_eval), the sign of u at a point is sign(c) times the
% product of the signs of the b^e there (sce_sign: sign3 is multiplicative,
% spw_sign, sprd_sign).  So when every member passes, F's sign vector at
% each point is smap of fam(B)'s (svec_smap), and the sentence over F and Psi
% means the same as the one over fam(B) and spsi (sem_split).
%----------------------------------------------------------------------------
BEGIN
  IMPORTING fsplit_top_def, mpoly_cert, cad_decide

  F: VAR list[list[mpoly]]
  B: VAR list[mpoly]
  u: VAR mpoly
  e: VAR nat
  E: VAR list[nat]
  x: VAR real
  xs, ys: VAR list[real]
  os: VAR list[bool]
  Psi: VAR [list[Sign3] -> bool]

  spw_sign: LEMMA FORALL e: sign3(x ^ e) = spw(sign3(x), e)
  sprd_sign: LEMMA FORALL B: FORALL E: sign3(meval(pprod(B, E))(xs)) = sprd(svec(fam(B), xs), E)
  sce_sign: LEMMA ucheck?(B)(u) IMPLIES
    sign3(meval(u)(xs)) = sce(B)(u)`1 * sprd(svec(fam(B), xs), sce(B)(u)`2)
  svec_smap: LEMMA FORALL F: every(ucheck?(B))(ubs(F)) IMPLIES
    svec(F, xs) = smap(map(sce(B))(ubs(F)))(svec(fam(B), xs))
  sem_split: LEMMA FORALL os: FORALL ys: every(ucheck?(B))(ubs(F)) IMPLIES
    (sem(os, fam(B), spsi(map(sce(B))(ubs(F)), Psi), ys) IFF sem(os, F, Psi, ys))
END fsplit_top
