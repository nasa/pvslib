crit_pos: THEORY
%----------------------------------------------------------------------------
% The derivative of a polynomial function: the derivative of the
% polynomial function of the eliminated variable is the polynomial of the
% formal derivative (pf_deriv, pf_deriv_at), and it vanishes at an interior
% maximum (deriv_max_pf, from NASALib's analysis library), which qe_ep_ok's
% sign changes use.
%----------------------------------------------------------------------------
BEGIN
  IMPORTING earr_deriv, analysis@derivative_props[real]

  l: VAR list[mpoly]
  ys: VAR list[real]
  x, z, a, b, c: VAR real

  %% the derivative of the polynomial function of the eliminated variable is
  %% the polynomial of the formal derivative of the list
  mderiv_mpol: LEMMA cons?(l) IMPLIES mderiv(mpol(l)) = mpol(lderiv(l))
  pf_derivable: LEMMA derivable?(pf(l, ys))
  pf_deriv: LEMMA cons?(l) IMPLIES deriv(pf(l, ys)) = pf(lderiv(l), ys)
  pf_deriv_at: LEMMA cons?(l) IMPLIES
    deriv(pf(l, ys), x) = meval(mpol(lderiv(l)))(cons(x, ys))

  %% the derivative vanishes at an interior maximum
  deriv_max_pf: LEMMA cons?(l) AND a < c AND c < b AND
    (FORALL (z: real): a < z AND z < b IMPLIES pf(l, ys)(z) <= pf(l, ys)(c))
    IMPLIES meval(mpol(lderiv(l)))(cons(c, ys)) = 0
END crit_pos
