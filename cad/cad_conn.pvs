cad_conn: THEORY
%----------------------------------------------------------------------------
% Connected sets of points, and continuity on a set.
%
% Points are lists of reals, innermost coordinate first, compared with the
% sup-norm ball near? of mpar.  A set C is connected when every property
% that is locally constant on C is constant on C.  For subsets of R^k this
% is exactly topological connectedness, and it is the form the proofs use:
% the stack over a cell is locally constant (col_loc), so on a connected
% cell it is constant (col_stack).
%
% conn_line: an interval of the head coordinate, the rest fixed, is
% connected (from loc_const, the real-line fact already in the library).
%----------------------------------------------------------------------------
BEGIN
  IMPORTING mpar, walk_transfer

  C: VAR [list[real] -> bool]
  Phi: VAR [list[real] -> bool]
  p, q, p0: VAR list[real]
  r: VAR [list[real] -> real]
  S: VAR [real -> bool]
  xs: VAR list[real]
  x, t, u, a, b: VAR real

  lcon?(Phi, C): bool = FORALL p0: C(p0) IMPLIES
    EXISTS (d: posreal): FORALL p: C(p) AND near?(p, p0, d) IMPLIES (Phi(p) IFF Phi(p0))

  conn?(C): bool = FORALL Phi, p, q: lcon?(Phi, C) AND C(p) AND C(q) IMPLIES (Phi(p) IFF Phi(q))

  cont_on?(r, C): bool = FORALL p0: C(p0) IMPLIES FORALL (eta: posreal):
    EXISTS (d: posreal): FORALL p: C(p) AND near?(p, p0, d) IMPLIES abs(r(p) - r(p0)) < eta

  %% the segment of S at a fixed tail
  sline(S, xs)(p): bool = cons?(p) AND S(car(p)) AND cdr(p) = xs
  near_line: LEMMA FORALL (d: posreal): abs(u - t) < d IMPLIES near?(cons(u, xs), cons(t, xs), d)
  sline_eq: LEMMA sline(S, xs)(p) IMPLIES p = cons(car(p), xs) AND S(car(p))
  line_le: LEMMA conv?(S) AND lcon?(Phi, sline(S, xs)) AND S(a) AND S(b) AND a <= b
    IMPLIES (Phi(cons(a, xs)) IFF Phi(cons(b, xs)))
  conn_line: THEOREM conv?(S) IMPLIES conn?(sline(S, xs))
END cad_conn
