innern_sem: THEORY
%----------------------------------------------------------------------------
% One level of the descriptor walk reads the point its descriptor denotes;
% decc_walk's induction over the Collins tower
% (innern_cad) is built from these.
%
% At a checked level (lvok_o) the oracle is right on every read the level
% makes (lv_agree, from okqs_agree), so the filter is the effective family
% (feff_zf), and the walk, its separators, gaps and certificate through the
% descriptor are those at the point (lvl_exact, by odreads and walk_det).
% The cell list of the executable IS the cell value list of the point
% (cellsf_cvl: a separator's descriptor denotes the separator point, a
% section's the gap's root, opt_den / osec_den).  innern_base: at the bottom
% level the listed vectors are the fibre set (walk_fib, fib_zf), so the fold
% is the quantifier.
%----------------------------------------------------------------------------
BEGIN
  IMPORTING oddef, tclf, map_member[SV, SV]

  TB: VAR list[CT]
  tb: VAR CT
  F, P, G: VAR list[list[mpoly]]
  qs: VAR list[bool]
  q: VAR bool
  Psi: VAR [SV -> bool]
  od: VAR OD
  ws: VAR list[real]
  Y: VAR list[rat]
  y0, lo, hi: VAR rat
  v: VAR SV
  f: VAR [OD -> bool]
  T: VAR [real -> bool]
  u: VAR nat

  vtb?(TB): bool = every(valid?)(TB)

  %% ---- a checked level ------------------------------------------------------------------
  lv_agree: LEMMA wf?(od) AND lvok_o(u, F, od, tb) IMPLIES agree(osg(od), msg(den(od)), wr_t(u, F, od, tb))

  sg: VAR SG
  wok_cert: LEMMA FORALL (Z: list[rat]): wok?(F, sg, Z) IMPLIES cert?(F, sg)

  lvl_exact: LEMMA valid?(tb) AND wf?(od) AND lvok_o(u, F, od, tb) IMPLIES
    feff(F, od) = zf(F, den(od))
    AND (FORALL v: ins0(F, od, v) = insz(F, den(od), v))
    AND seps_t(u, feff(F, od), od, tb) = seps_n(feff(F, od), osg(od), sfuel2 + u)
    AND wok?(zf(F, den(od)), msg(den(od)), seps_t(u, feff(F, od), od, tb))
    AND wagree?(zf(F, den(od)), osg(od), msg(den(od)), seps_t(u, feff(F, od), od, tb))
    AND certz?(F, den(od))
    AND agree(osg(od), msg(den(od)), wi_rd_t(F, od, tb))

  %% ---- the cells of the executable -----------------------------------------------------
  bs: VAR list[bool]
  b0: VAR bool
  every_true: LEMMA FORALL bs: every(LAMBDA (b: bool): b)(bs) AND member(b0, bs) IMPLIES b0
  cellsf_msep: LEMMA FORALL Y: member(y0, Y) IMPLIES member(f(opt(od, y0)), cellsf_o(f, P, od, tb, Y))
  cellsf_msec: LEMMA FORALL Y: adj?(Y, lo, hi) AND gap_t(P, od, lo, hi, tb)
    IMPLIES member(f(osec(od, P, lo, hi)), cellsf_o(f, P, od, tb, Y))
  cellsf_sep: LEMMA FORALL Y: every(LAMBDA (b: bool): b)(cellsf_o(f, P, od, tb, Y)) AND member(y0, Y)
    IMPLIES f(opt(od, y0))
  cellsf_sec: LEMMA FORALL Y: every(LAMBDA (b: bool): b)(cellsf_o(f, P, od, tb, Y))
    AND adj?(Y, lo, hi) AND gap_t(P, od, lo, hi, tb)
    IMPLIES f(osec(od, P, lo, hi))

  cellsf_cvl: LEMMA FORALL Y:
    (FORALL y0: member(y0, Y) IMPLIES f(opt(od, y0)) = T(y0))
    AND (FORALL lo, hi: adj?(Y, lo, hi) IMPLIES (gap_t(P, od, lo, hi, tb) IFF gap?(G, msg(ws), lo, hi)))
    AND (FORALL lo, hi: adj?(Y, lo, hi) AND gap?(G, msg(ws), lo, hi) IMPLIES
           f(osec(od, P, lo, hi)) = T(secbeta(G, ws, lo, hi)))
    IMPLIES cellsf_o(f, P, od, tb, Y) = cvl(T, G, ws, Y)

  ys: VAR list[real]
  %% ---- the fibre set is all the semantics of one quantifier can see ----
  qfold_fib: LEMMA FORALL (vs: SVL): (FORALL v: member(v, vs) IFF fib(F, ys)(v))
    IMPLIES (qfold(q, vs, Psi) IFF sem((: q :), F, Psi, ys))

  %% ---- claim A ------------------------------------------------------------------------------
  innern_base: LEMMA length(qs) = 1 AND vtb?(TB) AND wf?(od) AND okn_o(u, (: P :), TB, od)
    IMPLIES (innern_o(u, qs, (: P :), TB, Psi, od) IFF sem(qs, P, Psi, den(od)))
      AND CLF((: P :), den(od))

  s: VAR Sect
  ss: VAR list[Sect]
  g: VAR [Sect -> SC]
  pr: VAR [SC -> bool]
  odS_wf: LEMMA wf?(odS(s))
  odS_den: LEMMA den(odS(s)) = (: value(sample(s)) :)

  every_map_mem: LEMMA FORALL ss: every(pr)(map(g)(ss)) AND member(s, ss) IMPLIES pr(g(s))
  every_map_all: LEMMA FORALL ss: (FORALL s: member(s, ss) IMPLIES pr(g(s))) IMPLIES every(pr)(map(g)(ss))
  some_map_mem: LEMMA FORALL ss: some(pr)(map(g)(ss)) IMPLIES EXISTS s: member(s, ss) AND pr(g(s))
  some_map_intro: LEMMA FORALL ss: member(s, ss) AND pr(g(s)) IMPLIES some(pr)(map(g)(ss))
END innern_sem
