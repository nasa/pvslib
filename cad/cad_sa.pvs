cad_sa: THEORY
%----------------------------------------------------------------------------
% THE CELLS ARE SEMI-ALGEBRAIC (Basu-Pollack-Roy), indeed defined over Q:
% each is defined, among the points of R^(1 + length(A)) (the space of its
% level; R^(2 + length(A)) for the graph of a root function over a cell
% with indices A), by a Boolean combination of sign conditions on
% polynomials with rational coefficients, without quantifiers (qelim_ok's
% qfd?, from the first-order definitions by fod_qfd).  Basu-Pollack-Roy's
% definition allows real coefficients; these sets are in the smaller class
% defined over Q.
%   col_cells_sa  every cell of the Collins CAD, at every level, in every
%                 number of variables, and the graph of every root function
%                 over a cell (col_line's col_cells)
%----------------------------------------------------------------------------
BEGIN
  IMPORTING qelim_ok, col_line

  k, i: VAR nat
  F: VAR list[list[mpoly]]
  s: VAR Sect
  A: VAR list[nat]
  p, q: VAR list[real]

  col_cells_sa: THEOREM
        (FORALL s, A: member(s, csects(k, F)) AND length(A) <= k
           IMPLIES qfd?(1 + length(A))(ccell(k, F)(s, A)))
    AND (FORALL s, A, i: member(s, csects(k, F)) AND length(A) < k
           AND (FORALL q: ccell(k, F)(s, A)(q) IMPLIES i < nroot(nth(ctw(F, k), length(A)), q))
           IMPLIES qfd?(2 + length(A))
             (LAMBDA p: cons?(p) AND ccell(k, F)(s, A)(cdr(p))
                        AND car(p) = rt(nth(ctw(F, k), length(A)), cdr(p), i)))

END cad_sa
