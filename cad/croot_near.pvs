croot_near: THEORY
%----------------------------------------------------------------------------
% The roots of nearby polynomials are near.
%
% Two facts about a proper complex polynomial p of degree n, from its
% factorization (croots) and the size of its coefficients.
%   root_bound: every root of p has modulus at most 1 + M / |a(n)| when
%   every coefficient has modulus at most M.
%   croot_root_near: for every eps > 0 there is a delta > 0 such that every root of
%   a polynomial of the same degree whose coefficients are within delta of
%   those of p lies within eps of some root of p.
% Applied both ways, croot_root_near says that when q moves to p the root sets
% converge in the Hausdorff sense; with a constant number of distinct real
% roots that makes the ordered real roots continuous, which is
% delineability.  Everything is stated with the roots as a function
% r: [nat -> complex] and the product cprod of croots.
%----------------------------------------------------------------------------
BEGIN
  IMPORTING croots, reals@product[int]

  a, b: VAR sequence[complex]
  r: VAR [nat -> complex]
  n, i: VAR nat
  z, y, w: VAR complex
  M, B, eps, delta: VAR real

  %% if every factor is at least eps, the product is at least eps^n
  cprod_far: LEMMA FORALL (n: nat): FORALL (r: [nat -> complex], z: complex, eps: real):
    eps > 0 AND (FORALL (i: nat): i < n IMPLIES abs(z - r(i)) >= eps)
    IMPLIES abs(cprod(r, n)(z)) >= eps ^ n

  %% the value of a polynomial at a point of modulus at most B, when the
  %% coefficients are at most M: |p(z)| <= (n + 1) M max(1, B)^n
  cpoly_bound: LEMMA FORALL (n: nat): FORALL (a: sequence[complex], z: complex, M, B: real):
    M >= 0 AND B > 1 AND abs(z) <= B AND (FORALL (i: nat): i <= n IMPLIES abs(a(i)) <= M)
    IMPLIES abs(cpolynomial(a, n)(z)) <= (n + 1) * M * B ^ n

  %% the difference of two polynomials is the polynomial of the difference
  cpoly_diff_bound: LEMMA FORALL (n: nat): FORALL (a, b: sequence[complex], z: complex, delta, B: real):
    delta >= 0 AND B > 1 AND abs(z) <= B AND
    (FORALL (i: nat): i <= n IMPLIES abs(a(i) - b(i)) <= delta)
    IMPLIES abs(cpolynomial(a, n)(z) - cpolynomial(b, n)(z)) <= (n + 1) * delta * B ^ n

  %% a root bound: a root has modulus at most 1 + n M / |a(n)| (a root of
  %% modulus above 1 satisfies |a(n)| |z|^n <= n M |z|^(n-1))
  root_bound: THEOREM proper_polynomial?(n)(a) AND
    (FORALL (i: nat): i <= n IMPLIES abs(a(i)) <= M) AND
    cpolynomial(a, n)(z) = real_(0)
    IMPLIES abs(z) <= 1 + n * M / abs(a(n))

  %% the main statement
  croot_root_near: THEOREM proper_polynomial?(n)(a) AND eps > 0 IMPLIES
    EXISTS (delta: real): delta > 0 AND
      FORALL (b: sequence[complex], z: complex):
        (FORALL (i: nat): i <= n IMPLIES abs(a(i) - b(i)) <= delta) AND
        cpolynomial(b, n)(z) = real_(0)
        IMPLIES EXISTS (r: [nat -> complex]):
          (FORALL (w: complex): cpolynomial(a, n)(w) = a(n) * cprod(r, n)(w)) AND
          EXISTS (i: nat): i < n AND abs(z - r(i)) < eps
END croot_near
