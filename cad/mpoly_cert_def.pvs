mpoly_cert_def: THEORY
%----------------------------------------------------------------------------
% Checked factorizations, executable.
%
% fsplit(U) is mpoly_gcd_def's proposed basis B of U when every u in U is
% c * (product of b^e over B), with e from mexp and c the constant cofactor,
% by normal forms (ucheck?); otherwise it is U itself.  Nothing of
% mpoly_gcd_def is trusted: mpoly_cert proves what fsplit gives from the
% check alone.
%----------------------------------------------------------------------------
BEGIN
  IMPORTING mpoly_gcd_def

  u: VAR mpoly
  U, B: VAR list[mpoly]
  E: VAR list[nat]
  c: VAR rat

  %% the product of b^e over B and E
  pprod(B, E): RECURSIVE mpoly =
    IF null?(B) OR null?(E) THEN one ELSE mmul(mpow(car(B), car(E)), pprod(cdr(B), cdr(E))) ENDIF
  MEASURE length(B)

  %% the constant cofactor of u over B with exponents E (0 when it is not a constant)
  ccof(u, B, E): rat = LET q = mex(u, pprod(B, E)) IN IF mconst?(q) THEN mc(q) ELSE 0 ENDIF
  %% u = c * product, by normal forms
  ucert?(u, B, E, c): bool = c /= 0 AND meq(mnorm(u), mnorm(mscal(c, pprod(B, E))))
  ucheck?(B)(u): bool = ucert?(u, B, exps(u, B), ccof(u, B, exps(u, B)))

  fsplit(U): list[mpoly] = LET B = basis(U) IN IF every(ucheck?(B))(U) THEN B ELSE U ENDIF
END mpoly_cert_def
