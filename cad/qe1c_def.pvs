qe1c_def: THEORY
%----------------------------------------------------------------------------
% Quantifier elimination for one free variable over the Collins tower.
% Executable.
%
% qe_def's answer on the Collins run: every sector of the roots of the outer
% family Q (the projection of the tower ctw(F, k)'s lowest family, as in
% decc_o) gives an entry -- the sector, the walk's value of the inner
% quantifiers at its sample, Q's sign vector there -- and qe1_sm turns the
% entries into a quantifier-free formula in the free variable.  qe1cc_u
% raises u until the walk's certificate holds; it always does (decc_ev).
%----------------------------------------------------------------------------
BEGIN
  IMPORTING qe_def, decc_u_def

  u: VAR nat
  qb: VAR list[bool]
  F: VAR list[list[mpoly]]
  Psi: VAR [SV -> bool]
  phi: VAR BF

  qe1cc_o(u, qb, F, Psi): QER =
    IF null?(qb) THEN qbad
    ELSE LET TW = ctw(F, length(qb)), Q = cbot(TW), cs = map(cscof(u, TW))(sects(rts(Q))) IN
      IF gaps_ok(rts(Q)) AND every(okc?(u))(cs) THEN qe1_sm(Q, map(qent(u, qb, Psi, Q))(cs)) ELSE qbad ENDIF
    ENDIF

  qe1cc_u(qb, F, Psi, u): RECURSIVE QER =
    LET d = qe1cc_o(u, qb, F, Psi) IN
    IF d`ok OR null?(qb) THEN d ELSE qe1cc_u(qb, F, Psi, u + 1) ENDIF
  MEASURE umc(cons(TRUE, qb), F, Psi, u)

  qe1cc(qb, F, phi): QER = qe1cc_u(qb, F, LAMBDA (v: SV): bfsv(phi, v), 0)
END qe1c_def
