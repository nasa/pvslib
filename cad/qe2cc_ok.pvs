qe2cc_ok: THEORY
%----------------------------------------------------------------------------
% Collins quantifier elimination for m >= 2 free variables is correct,
% as qe2_ok for the read-closure run.
%
%   qe2cc_correct  a certified answer is equivalent: for every point pt of
%                  R^m, qfsem(out)(pt) IFF sem(qb, F, Psi, pt); it is
%                  quantifier-free when its qf flag says so (qe2cc_qf)
%   qe2cc_bf       for every prenex formula: qe2cc answers, and its answer
%                  is equivalent (fsem)
%
% Over each sector the Collins tower is a CAD and the sector's records lie
% in their cells, cover them, and F is sign-invariant on the top cells
% (csector_recs, from col_run's col_cad_run and col_out_ok's cad_outc_ok),
% which is everything qe2_ok's secout_sem needs; the sectors cover the line
% (qe2_ok's part_sem / orl_filter).
%----------------------------------------------------------------------------
BEGIN
  IMPORTING qe2cc_def, qe2_ok, col_verified

  u: VAR nat
  m: VAR posnat
  qb, qs, os: VAR list[bool]
  F: VAR list[list[mpoly]]
  Psi: VAR [SV -> bool]
  bphi: VAR BF
  s: VAR Sect
  r: VAR ORec
  pt: VAR list[real]

  %% ---- one sector -------------------------------------------------------------------------------
  csector_recs: LEMMA decc_o(u, qs, F, Psi)`ok AND length(qs) >= 2 AND member(s, csects(length(cdr(qs)), F))
    IMPLIES cad_over?(ctw(F, length(cdr(qs))), scell(s))
      AND recin?(ctw(F, length(cdr(qs))), scell(s), F, secr(s, cad_outc(u, qs, F)))
      AND reccov?(ctw(F, length(cdr(qs))), scell(s), secr(s, cad_outc(u, qs, F)))
      AND fsinv?(ctw(F, length(cdr(qs))), scell(s), F)
      AND length(ctw(F, length(cdr(qs)))) = length(cdr(qs))
  crec_wf: LEMMA decc_o(u, qs, F, Psi)`ok AND length(qs) >= 2 AND member(r, cad_outc(u, qs, F))
    IMPLIES wf?(r`rsod)

  csect_sem: LEMMA m >= 2 AND cons?(qb) AND decc_o(u, qsn(m + length(qb)), F, Psi)`ok AND length(pt) = m
    AND member(s, csects(m - 1 + length(qb), F)) AND in?(s, car(dropn(m - 1, pt)))
    IMPLIES (qfsem(secout(m, qb, Psi, s, ctw(F, m - 1 + length(qb)),
                          secr(s, cad_outc(u, qsn(m + length(qb)), F))))(pt)
             IFF sem(qb, F, Psi, pt))

  %% ---- the answer ---------------------------------------------------------------------------------
  qe2cc_c_sem: LEMMA m >= 2 AND cons?(qb) AND decc_o(u, qsn(m + length(qb)), F, Psi)`ok AND length(pt) = m
    IMPLIES (qfsem(qe2cc_c(u, m, qb, F, Psi)`out)(pt) IFF sem(qb, F, Psi, pt))

  qe2cc_correct: THEOREM qe2cc_o(u, m, qb, F, Psi)`ok AND length(pt) = m IMPLIES
    (qfsem(qe2cc_o(u, m, qb, F, Psi)`out)(pt) IFF sem(qb, F, Psi, pt))
  qe2cc_qf: THEOREM qe2cc_o(u, m, qb, F, Psi)`qf IMPLIES qf?(qe2cc_o(u, m, qb, F, Psi)`out)

  qe2cc_u_ok: THEOREM m >= 2 AND cons?(qb) IMPLIES qe2cc_u(m, qb, F, Psi, u)`ok
  qe2cc_u_eq: LEMMA EXISTS (u2: nat): qe2cc_u(m, qb, F, Psi, u) = qe2cc_o(u2, m, qb, F, Psi)

  qe2cc_bf: THEOREM m >= 2 AND cons?(os) AND length(pt) = m IMPLIES
    qe2cc(m, os, F, bphi)`ok AND (qfsem(qe2cc(m, os, F, bphi)`out)(pt) IFF fsem(os, F, bphi, pt))
  qe2cc_bf_qf: THEOREM qe2cc(m, os, F, bphi)`qf IMPLIES qf?(qe2cc(m, os, F, bphi)`out)
END qe2cc_ok
