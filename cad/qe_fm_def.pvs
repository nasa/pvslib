qe_fm_def: THEORY
%----------------------------------------------------------------------------
% Formulas for quantifier elimination.  Executable.
%
% qf?: the formula has no quantifier.  ffalse, and the n-ary disjunction and
% conjunction f_orl / f_andl of a list of formulas (ffalse / ftrue on the
% empty list).  qfsem is rcf_fol's fsem under a name of its own, so that
% statements about QE output cannot be confused with cad_decide's fsem.
%----------------------------------------------------------------------------
BEGIN
  IMPORTING rcf_fol

  phi: VAR Fm
  L: VAR list[Fm]
  pt: VAR list[real]

  qf?(phi): RECURSIVE bool =
    CASES phi OF
      ftrue: TRUE,
      fsg(q, t): TRUE,
      fnot(b): qf?(b),
      fand(a, b): qf?(a) AND qf?(b),
      fex(b): FALSE
    ENDCASES
  MEASURE phi BY <<

  ffalse: Fm = fnot(ftrue)

  f_orl(L): RECURSIVE Fm =
    IF null?(L) THEN ffalse
    ELSIF null?(cdr(L)) THEN car(L)
    ELSE f_or(car(L), f_orl(cdr(L)))
    ENDIF
  MEASURE length(L)

  f_andl(L): RECURSIVE Fm =
    IF null?(L) THEN ftrue
    ELSIF null?(cdr(L)) THEN car(L)
    ELSE fand(car(L), f_andl(cdr(L)))
    ENDIF
  MEASURE length(L)

  qfsem(phi)(pt): bool = fsem(phi)(pt)
END qe_fm_def
