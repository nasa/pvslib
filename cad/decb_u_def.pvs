decb_u_def: THEORY
%----------------------------------------------------------------------------
% The Collins decision with the escalation parameter raised until its
% certificate holds (decb_o: the smaller bottom-step projection).
% Executable; it always stops because the certificate holds from some u on
% (decb_ok's decb_ev, which gives the measure).
%----------------------------------------------------------------------------
BEGIN
  IMPORTING decb_ok

  u, N: VAR nat
  qs: VAR list[bool]
  F: VAR list[list[mpoly]]
  Psi: VAR [SV -> bool]

  %% some u from which on the certificate holds (not computed)
  ubb(qs, F, Psi): nat =
    epsilon(LAMBDA (N: nat): FORALL u: u >= N IMPLIES decb_o(u, qs, F, Psi)`ok)
  umb(qs, F, Psi, u): nat = IF u < ubb(qs, F, Psi) THEN ubb(qs, F, Psi) - u ELSE 0 ENDIF

  decb_u(qs, F, Psi, u): RECURSIVE [# ok: bool, val: bool #] =
    LET d = decb_o(u, qs, F, Psi) IN
    IF d`ok OR null?(qs) OR null?(cdr(qs)) THEN d ELSE decb_u(qs, F, Psi, u + 1) ENDIF
  MEASURE umb(qs, F, Psi, u)
END decb_u_def
