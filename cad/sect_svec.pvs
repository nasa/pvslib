sect_svec: THEORY
%----------------------------------------------------------------------------
% A sector carries one sign vector of the family that defined it.
% This is about the SECTOR DECOMPOSITION and not about delineability:
%
%   on a sector of sects(rts(P)), every member of P keeps its sign,
%   so svec(P, (: x :)) = svec(P, (: y :)) for x, y in the same sector.
%
% cell1's svec_between already gives this from "no isolated root lies between
% x and y", and below_first / above_last already cover the outer sectors, so
% what is missing is the mid case: between two CONSECUTIVE roots there is no
% third.  gsects builds mid sectors from consecutive pairs, but it has no
% inverse-structure lemma, so that needs its own induction (gsects_mid_mem,
% gsects_mid_noroot).
%
% What remains after this is the mathematical core: same psc signs give the
% same realizable sign-vector set.
%----------------------------------------------------------------------------
BEGIN
  IMPORTING sect_inv

  P: VAR list[list[mpoly]]
  rs: VAR list[Alg]
  a, b: VAR Alg
  s: VAR Sect
  x, y, z: VAR real
  r: VAR rat

  %% a mid sector's endpoints are roots of the list it came from
  gsects_mid_mem: LEMMA FORALL rs: member(mid(a, b), gsects(rs))
    IMPLIES member(a, rs) AND member(b, rs)

  %% and between them there is no third root
  gsects_mid_noroot: LEMMA FORALL rs: incr?(rs) AND member(mid(a, b), gsects(rs))
    AND value(a) < z AND z < value(b) IMPLIES NOT vals(rs)(z)

  %% the same two facts for the ABOVE sector: gsects puts one only at the
  %% last root, so nothing lies above it
  gsects_above_mem: LEMMA FORALL rs: member(above(a), gsects(rs))
    IMPLIES member(a, rs)
  %% gsects_above_mem is too weak on its own: what is needed is that an above
  %% sector sits at the MAXIMUM root, not merely at some root
  c: VAR Alg
  gsects_above_max: LEMMA FORALL rs: incr?(rs) AND member(above(a), gsects(rs))
    AND member(c, rs) IMPLIES value(c) <= value(a)
  gsects_above_noroot: LEMMA FORALL rs: incr?(rs) AND member(above(a), gsects(rs))
    AND value(a) < z IMPLIES NOT vals(rs)(z)

  %% gsects produces only at, mid and above -- never below or whole, which
  %% sects supplies separately
  gsects_kind: LEMMA FORALL rs: member(s, gsects(rs))
    IMPLIES NOT below?(s) AND NOT whole?(s)

  %% so no root lies strictly inside any non-root sector
  sect_noroot: LEMMA FORALL rs: incr?(rs) AND member(s, sects(rs)) AND NOT at?(s)
    AND in?(s, z) IMPLIES NOT vals(rs)(z)

  %% every sector is an interval, so it contains anything between two of its
  %% points -- needed to push sect_noroot from x and y to all z between them
  in_between: LEMMA in?(s, x) AND in?(s, y)
    AND ((x <= z AND z <= y) OR (y <= z AND z <= x)) IMPLIES in?(s, z)

  %% and the family's sign vector is constant along a sector.  The second
  %% point is RATIONAL because cell1's svec_between is stated that way, and
  %% that is exactly the shape the decision needs: it compares an arbitrary
  %% point of a sector against the sector's rational sample.  Two
  %% arbitrary points follow by going through the sample twice.
  sect_svec: LEMMA incr?(sortu(allroots(P)))
    AND member(s, sects(sortu(allroots(P)))) AND in?(s, x) AND in?(s, r)
    IMPLIES svec(P, (: x :)) = svec(P, (: r :))
END sect_svec
