alg_isign: THEORY
%----------------------------------------------------------------------------
% A cheap sign at an algebraic number.
%
% alg_sign2 builds a Sturm chain of the query for every call, and a walk at an
% algebraic sample asks for thousands of signs there (66,890 calls on one benchmark,
% 250 of 253 s).  Over the isolating interval [lb, ub] of the number, Horner's
% rule in NASALib's interval arithmetic (hornI; Add_inclusion,
% Mult_inclusion) encloses every value of the query (hornI_incl); when the
% enclosure lies on one side of zero, that side is the sign at the number,
% which is in the interval (value_in).  Otherwise alg_sign2 answers as
% before.  The enclosure is tight when the interval is narrow, so the n-level
% decision refines a sample's interval once (refine_n, which keeps the
% number).  A second enclosure, of the query re-expanded around the middle of
% the interval (pshift), comes before alg_sign2.
%----------------------------------------------------------------------------
BEGIN
  IMPORTING alg_sign2, interval_arith@interval, pl_shift

  pl, ql: VAR Polylist
  c: VAR rat
  x: VAR real
  X: VAR Interval
  a: VAR Alg

  %% Horner's rule for polylist
  polylist_one: LEMMA polylist((: c :))(x) = c
  polylist_horner: LEMMA polylist(cons(c, pl))(x) = c + x * polylist(pl)(x)

  %% Horner in interval arithmetic
  hornI(pl, X): RECURSIVE Interval =
    IF null?(cdr(pl)) THEN [|car(pl)|]
    ELSE Add([|car(pl)|], Mult(X, hornI(cdr(pl), X)))
    ENDIF
  MEASURE length(pl)
  hornI_incl: LEMMA FORALL pl: x ## X IMPLIES polylist(pl)(x) ## hornI(pl, X)

  %% the sign: the enclosure when it decides; then the enclosure of the query
  %% shifted to the middle of the interval (pl_shift_def, 2026-10-01: it
  %% overestimates by about half the width times |q'(mid)| and settles most of
  %% the queries the first one leaves); alg_sign2 otherwise
  alg_isign(a, ql): Sign3 =
    LET E = hornI(ql, [|a`lb, a`ub|]) IN
    IF lb(E) > 0 THEN 1 ELSIF ub(E) < 0 THEN -1
    ELSE LET m = mid(a), C = hornI(pshift(ql, m), [|a`lb - m, a`ub - m|]) IN
      IF lb(C) > 0 THEN 1 ELSIF ub(C) < 0 THEN -1 ELSE alg_sign2(a, ql) ENDIF
    ENDIF

  alg_isign_sign: THEOREM alg_isign(a, ql) = sign3(polylist(ql)(value(a)))
END alg_isign
