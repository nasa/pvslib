qe8: THEORY
%----------------------------------------------------------------------------
% qe8 is correct and always quantifier-free: qe1c_ok's qe1cc_bf for one free
% variable, qe2cc_ok's qe2cc_bf when
% the Collins answer is quantifier-free, qe2cd_ok's qe2cd_bf / qe2cd_isqf
% (derivative-closed free levels) otherwise.  qe8_correct is the lemma (cad-qe) instantiates in a theory
% that imports qe8.
%----------------------------------------------------------------------------
BEGIN
  IMPORTING qe8_def, qe1c_ok, qe2cc_ok, qe2cd_ok

  m: VAR posnat
  os: VAR list[bool]
  F: VAR list[list[mpoly]]
  phi: VAR BF
  pt: VAR list[real]

  qe1cc_isqf: LEMMA cons?(os) IMPLIES qe1cc(os, F, phi)`qf
  qe1cc_qf: LEMMA qe1cc(os, F, phi)`qf IMPLIES qf?(qe1cc(os, F, phi)`out)

  qe8_correct: THEOREM cons?(os) AND length(pt) = m IMPLIES
    qe8(m, os, F, phi)`ok AND (qfsem(qe8(m, os, F, phi)`out)(pt) IFF fsem(os, F, phi, pt))
  qe8_isqf: THEOREM cons?(os) IMPLIES qe8(m, os, F, phi)`qf
  qe8_qf: THEOREM qe8(m, os, F, phi)`qf IMPLIES qf?(qe8(m, os, F, phi)`out)
  qe8_complete: THEOREM cons?(os) AND length(pt) = m IMPLIES
    qf?(qe8(m, os, F, phi)`out) AND (qfsem(qe8(m, os, F, phi)`out)(pt) IFF fsem(os, F, phi, pt))
END qe8
