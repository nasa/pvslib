qe_ldd[T: TYPE]: THEORY
%----------------------------------------------------------------------------
% Duplicate removal on a list.
% Executable.  ldd keeps the last copy of each element; qe_ldd_ok proves it
% has the same members.  The QE output uses it so that each disjunct is
% written once.
%----------------------------------------------------------------------------
BEGIN
  l: VAR list[T]

  ldd(l): RECURSIVE list[T] =
    IF null?(l) THEN l
    ELSIF member(car(l), cdr(l)) THEN ldd(cdr(l))
    ELSE cons(car(l), ldd(cdr(l)))
    ENDIF
  MEASURE length(l)
END qe_ldd
