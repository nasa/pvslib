decb_ok: THEORY
%----------------------------------------------------------------------------
% decb_o is correct and complete.
%
% When nzb? holds for Q = cbotb(TW), each sector of rts(Q) that is not a root
% has every member of Q nonzero at its rational sample, and Q is
% sign-invariant on the sector's cell (col_sem's sinv_sect), so every member
% is nonzero on the whole cell (sect_nz); the members are the checked basis
% of the smaller projection of the lowest family turned into a family
% (as_list), so every member of that projection is nonzero there too
% (mpoly_cert's fsplit_nz) and col_towerb's bot_cad makes the tower a CAD
% over the cell; a root sector's cell is one point (scell_at, bot_cad1).
% From there the proof is decc_ok's (colsect_semb, colfold_semb).  When nzb?
% fails, decb_o is decc_o (decc_ok's decc_correct, decc_ev).
%----------------------------------------------------------------------------
BEGIN
  IMPORTING decb_def, decc_ok, col_towerb

  TW: VAR Tower
  F, Q: VAR list[list[mpoly]]
  qs, qs1: VAR list[bool]
  q1: VAR bool
  Psi: VAR [SV -> bool]
  s: VAR Sect
  x: VAR real
  k, u: VAR nat
  p, q: VAR list[real]
  f: VAR list[mpoly]
  w: VAR mpoly
  U: VAR list[mpoly]
  ss: VAR list[Sect]
  ps: VAR pred[Sect]
  pf: VAR pred[list[mpoly]]

  %% ---- lists ------------------------------------------------------------------------------------
  every_sect: LEMMA FORALL ss: every(ps)(ss) AND member(s, ss) IMPLIES ps(s)
  every_fam: LEMMA FORALL Q: every(pf)(Q) AND member(f, Q) IMPLIES pf(f)
  mem_fam: LEMMA FORALL U: member(w, U) IMPLIES member(as_list(w), map(as_list)(U))

  %% ---- the base cells ---------------------------------------------------------------------------
  scell_at: LEMMA at?(s) AND scell(s)(p) AND scell(s)(q) IMPLIES p = q
  sect_sample: LEMMA gaps_ok(rts(Q)) AND member(s, sects(rts(Q))) IMPLIES scell(s)((: value(sample(s)) :))
  sect_nz: LEMMA gaps_ok(rts(Q)) AND nzb?(Q) AND member(s, sects(rts(Q))) AND NOT at?(s)
    AND member(f, Q) AND scell(s)(p) IMPLIES meval(mpol(f))(p) /= 0
  sect_cadb: LEMMA k >= 1 AND gaps_ok(rts(cbotb(ctw(F, k)))) AND member(s, sects(rts(cbotb(ctw(F, k)))))
    AND nzb?(cbotb(ctw(F, k))) IMPLIES cad_over?(ctw(F, k), scell(s))

  %% ---- one sector, the fold, the decision -------------------------------------------------------
  colsect_semb: LEMMA k >= 1 AND length(qs1) = k AND gaps_ok(rts(cbotb(ctw(F, k))))
    AND member(s, sects(rts(cbotb(ctw(F, k))))) AND okc?(u)(cscof(u, ctw(F, k))(s)) AND in?(s, x)
    AND nzb?(cbotb(ctw(F, k)))
    IMPLIES (scval(u, qs1, Psi)(cscof(u, ctw(F, k))(s)) IFF sem(qs1, F, Psi, (: x :)))

  colfold_semb: LEMMA k >= 1 AND length(qs1) = k AND gaps_ok(rts(cbotb(ctw(F, k))))
    AND every(okc?(u))(map(cscof(u, ctw(F, k)))(sects(rts(cbotb(ctw(F, k))))))
    AND nzb?(cbotb(ctw(F, k)))
    IMPLIES ((IF q1 THEN every(scval(u, qs1, Psi))(map(cscof(u, ctw(F, k)))(sects(rts(cbotb(ctw(F, k))))))
              ELSE some(scval(u, qs1, Psi))(map(cscof(u, ctw(F, k)))(sects(rts(cbotb(ctw(F, k)))))) ENDIF)
             IFF sem(cons(q1, qs1), F, Psi, null[real]))

  decb_correct: THEOREM decb_o(u, qs, F, Psi)`ok IMPLIES
    (decb_o(u, qs, F, Psi)`val IFF sem(qs, F, Psi, null[real]))
  decb_ev: THEOREM cons?(qs) AND cons?(cdr(qs)) IMPLIES ev?(LAMBDA u: decb_o(u, qs, F, Psi)`ok)
END decb_ok
