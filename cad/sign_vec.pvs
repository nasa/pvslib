sign_vec: THEORY
%----------------------------------------------------------------------------
% Sign vectors of a family of polynomials.
%
% A family is a list of coefficient lists (each a polynomial in the top
% variable with mpoly coefficients over the remaining variables); its sign
% vector at a point xs is the list of the signs of its members at xs. pos
% finds the position of a member (executable, for looking up the sign of a
% branch condition in a vector that was computed for the projection family).
%----------------------------------------------------------------------------
BEGIN
  IMPORTING mpoly_def, reals@sign3

  F: VAR list[list[mpoly]]
  l, u: VAR list[mpoly]
  xs: VAR list[real]
  i: VAR nat

  SV: TYPE = list[Sign3]
  SVL: TYPE = list[SV]

  svec(F, xs): list[Sign3] =
    map(LAMBDA (u: list[mpoly]): sign3(meval(mpol(u))(xs)))(F)

  svec_null: LEMMA svec(null[list[mpoly]], xs) = null[Sign3]
  svec_cons: LEMMA svec(cons(l, F), xs) = cons(sign3(meval(mpol(l))(xs)), svec(F, xs))
  svec_length: LEMMA length(svec(F, xs)) = length(F)
  svec_nth: LEMMA i < length(F) IMPLIES nth(svec(F, xs), i) = sign3(meval(mpol(nth(F, i)))(xs))
END sign_vec
