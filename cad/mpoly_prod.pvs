mpoly_prod: THEORY
%----------------------------------------------------------------------------
% The product of two coefficient lists, as a real coefficient array.
%
% Tarski queries are computed from a chain whose second element is the product
% of a polynomial with the derivative of another, and Tarski@sturmtarski
% states that as an equality of coefficient arrays with NASALib's
% polynomial_prod.  lmul is the product of two coefficient lists over mpoly
% and earr_lmul says the array it denotes at a valuation is polynomial_prod of
% the arrays of the factors.
%
% The proof does not compute the convolution.  Two arrays that denote the same
% polynomial at a degree at least as large as both, and vanish above it, are
% equal coefficient by coefficient (polynomial_eq_coeff); the product list
% denotes the product polynomial because meval is a homomorphism (mpoly_arith),
% and NASALib's product array denotes it by polynomial_prod_def.
%----------------------------------------------------------------------------
BEGIN
  IMPORTING prem_arr

  l1, l2: VAR list[mpoly]
  xs, ys: VAR list[real]
  i, n, m, nb: VAR nat
  x: VAR real
  a, b: VAR [nat -> real]

  %% the product of two coefficient lists
  lmul(l1, l2): list[mpoly] = as_list(mmul(mpol(l1), mpol(l2)))
  meval_lmul: LEMMA meval(mpol(lmul(l1, l2)))(xs) = meval(mpol(l1))(xs) * meval(mpol(l2))(xs)

  %% NASALib's product array vanishes above the sum of the degrees, and denotes
  %% the product at any degree at least that
  pprod_above: LEMMA i > n + m IMPLIES polynomial_prod(a, n, b, m)(i) = 0
  pprod_ext: LEMMA nb >= n + m IMPLIES
    polynomial(polynomial_prod(a, n, b, m), nb)(x) = polynomial(a, n)(x) * polynomial(b, m)(x)

  %% two arrays with the same polynomial at a common degree agree below it
  poly_fun_eq: LEMMA (FORALL (z: real): polynomial(a, n)(z) = polynomial(b, n)(z))
    IMPLIES polynomial(a, n) = polynomial(b, n)

  %% the list product denotes the product array
  dg_len: LEMMA dg(l1) + 1 >= length(l1)
  nn(l1, l2): nat = max(dg(l1) + dg(l2), dg(lmul(l1, l2)))
  nn_ge1: LEMMA nn(l1, l2) >= dg(l1) + dg(l2)
  nn_ge2: LEMMA nn(l1, l2) + 1 >= length(lmul(l1, l2))
  lmul_poly: LEMMA polynomial(earr(lmul(l1, l2), ys), nn(l1, l2))(x) =
    polynomial(polynomial_prod(earr(l1, ys), dg(l1), earr(l2, ys), dg(l2)), nn(l1, l2))(x)
  earr_lmul_at: LEMMA earr(lmul(l1, l2), ys)(i) =
    polynomial_prod(earr(l1, ys), dg(l1), earr(l2, ys), dg(l2))(i)
  earr_lmul: THEOREM earr(lmul(l1, l2), ys) =
    polynomial_prod(earr(l1, ys), dg(l1), earr(l2, ys), dg(l2))
END mpoly_prod
