od_exact: THEORY
%----------------------------------------------------------------------------
% Every oracle of a well-formed descriptor is exact.
%
% oddef's okqs_agree reads the executable's recursive certificate okqs as a
% statement about the oracle: where it holds, osg(od) answers like the point
% den(od).  Since the section queries no longer search for their ends,
% every query at a gap the walk above certified is sound (cell_ok's
% allok_complete), so okqs holds at every well-formed descriptor, on any read
% list (okqs_complete).  Hence a well-formed descriptor's oracle IS the
% oracle of its point, on every polynomial (wf_exact): every walk of the
% tree below a certified level runs at an exact oracle, which is what the
% completeness argument for the walks (C5, C6) needs.
%
%   okqs_complete  wf?(od) IMPLIES okqs(od, R), for every R
%   wf_exact       wf?(od) IMPLIES osg(od) = msg(den(od))
%----------------------------------------------------------------------------
BEGIN
  IMPORTING oddef

  od: VAR OD
  R: VAR list[mpoly]
  sg1, sg2: VAR SG

  agree_sym_od_exact: LEMMA agree(sg1, sg2, R) IMPLIES agree(sg2, sg1, R)

  okqs_complete: THEOREM FORALL od: FORALL R: wf?(od) IMPLIES okqs(od, R)

  wf_exact: THEOREM wf?(od) IMPLIES osg(od) = msg(den(od))
END od_exact
