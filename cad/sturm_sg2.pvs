sturm_sg2: THEORY
%----------------------------------------------------------------------------
% The converses of sturm_sg's counting theorems.
%
% sturm_sg reads a count as a statement about roots in one direction: a zero
% count means no root, a positive bounded count means some root, a count of
% one means a unique root.  Building separators at an ARBITRARY point needs
% the other direction -- from roots to counts, and from a count of two to
% two distinct roots:
%
%   cnt_root    a root in (y0, y1] makes the count positive
%   cnt_two     a count of at least two gives two distinct roots
%   cnt_add     counts over adjacent intervals add (by definition)
%   left_pos    a positive left count gives a root at or below y0
%   right_pos   a positive right count gives a root above y1
%   left_step / right_step   how the unbounded counts move with the endpoint
%----------------------------------------------------------------------------
BEGIN
  IMPORTING sturm_sg

  sg: VAR SG
  ys: VAR list[real]
  f: VAR list[mpoly]
  k: VAR nat
  y0, y1, y2: VAR rat
  z: VAR real

  cnt_root: LEMMA slc?(k, msg(ys), f) AND ends?(ys, f, y0, y1)
    AND y0 < z AND z <= y1 AND meval(mpol(f))(cons(z, ys)) = 0
    IMPLIES cnt(k, msg(ys), f, y0, y1) > 0

  cnt_add: LEMMA cnt(k, sg, f, y0, y2) = cnt(k, sg, f, y0, y1) + cnt(k, sg, f, y1, y2)
  left_step: LEMMA left(k, sg, f, y1) = left(k, sg, f, y0) + cnt(k, sg, f, y0, y1)
  right_step: LEMMA right(k, sg, f, y0) = cnt(k, sg, f, y0, y1) + right(k, sg, f, y1)

  cnt_two: THEOREM slc?(k, msg(ys), f) AND ends?(ys, f, y0, y1)
    AND cnt(k, msg(ys), f, y0, y1) >= 2
    IMPLIES EXISTS (z1, z2: real): z1 < z2 AND
      y0 < z1 AND z1 <= y1 AND meval(mpol(f))(cons(z1, ys)) = 0 AND
      y0 < z2 AND z2 <= y1 AND meval(mpol(f))(cons(z2, ys)) = 0

  left_pos: THEOREM slc?(k, msg(ys), f) AND meval(mpol(f))(cons(y0, ys)) /= 0
    AND left(k, msg(ys), f, y0) > 0
    IMPLIES EXISTS z: z <= y0 AND meval(mpol(f))(cons(z, ys)) = 0

  right_pos: THEOREM slc?(k, msg(ys), f) AND meval(mpol(f))(cons(y1, ys)) /= 0
    AND right(k, msg(ys), f, y1) > 0
    IMPLIES EXISTS z: z > y1 AND meval(mpol(f))(cons(z, ys)) = 0
END sturm_sg2
