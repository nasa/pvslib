decc_ok: THEORY
%----------------------------------------------------------------------------
% The Collins decision is correct.
%
%   decc_correct   decc_o(u, qs, F, Psi)`ok IMPLIES
%                  (decc_o(u, qs, F, Psi)`val IFF sem(qs, F, Psi, null))
%
% Every sector of the outer line gets the same tower ctw(F, k) of F and its
% Collins projections, and the outer family is the projection of the
% tower's lowest family (cbot_ctw: it is pbot(F, k)).  That family is
% sign-invariant on each of its sectors (sinv_sect), so the tower is a CAD
% over the sector's cell (ctw_cad), the walk at the sector's sample reads the
% truth there (decc_walk's innern_cad), and the truth is the same at every
% point of the sector (col_sem's sem_cad; colsect_sem).  The sectors cover
% the line, so the fold over them is the outermost quantifier (colfold_sem).
% Completeness: the tower and the sectors do not depend on u, the gaps of the
% sorted roots always pass (gaps_ok_incr), and the certificate of each of
% the finitely many sectors holds from some u on (okw_ev).
%----------------------------------------------------------------------------
BEGIN
  IMPORTING decc_walk, ev_nat[Sect]

  TW: VAR Tower
  F, Q: VAR list[list[mpoly]]
  qs, qs1: VAR list[bool]
  q1: VAR bool
  Psi: VAR [SV -> bool]
  s: VAR Sect
  x: VAR real
  k, u: VAR nat

  %% the outer family of the run
  cbot_ctw: LEMMA k >= 1 IMPLIES cbot(ctw(F, k)) = pbot(F, k)

  %% ---- one sector -------------------------------------------------------------------------
  colmem_ok: LEMMA gaps_ok(rts(Q)) AND every(okc?(u))(map(cscof(u, TW))(sects(rts(Q))))
    AND member(s, sects(rts(Q)))
    IMPLIES okc?(u)(cscof(u, TW)(s)) AND in?(s, value(sample(s)))

  colsect_sem: LEMMA k >= 1 AND length(qs1) = k AND gaps_ok(rts(pbot(F, k)))
    AND member(s, sects(rts(pbot(F, k)))) AND okc?(u)(cscof(u, ctw(F, k))(s)) AND in?(s, x)
    IMPLIES (scval(u, qs1, Psi)(cscof(u, ctw(F, k))(s)) IFF sem(qs1, F, Psi, (: x :)))

  %% ---- the fold over the sectors -------------------------------------------------------------
  colfold_sem: LEMMA k >= 1 AND length(qs1) = k AND gaps_ok(rts(pbot(F, k)))
    AND every(okc?(u))(map(cscof(u, ctw(F, k)))(sects(rts(pbot(F, k)))))
    IMPLIES ((IF q1 THEN every(scval(u, qs1, Psi))(map(cscof(u, ctw(F, k)))(sects(rts(pbot(F, k)))))
              ELSE some(scval(u, qs1, Psi))(map(cscof(u, ctw(F, k)))(sects(rts(pbot(F, k))))) ENDIF)
             IFF sem(cons(q1, qs1), F, Psi, null[real]))

  decc_correct: THEOREM decc_o(u, qs, F, Psi)`ok IMPLIES
    (decc_o(u, qs, F, Psi)`val IFF sem(qs, F, Psi, null[real]))

  %% ---- completeness ---------------------------------------------------------------------------
  decc_ev: THEOREM cons?(qs) AND cons?(cdr(qs)) IMPLIES ev?(LAMBDA u: decc_o(u, qs, F, Psi)`ok)
END decc_ok
