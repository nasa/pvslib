qe_ldd_ok[T: TYPE]: THEORY
%----------------------------------------------------------------------------
% ldd (qe_ldd) keeps exactly the members of the list.
%----------------------------------------------------------------------------
BEGIN
  IMPORTING qe_ldd[T]

  l: VAR list[T]
  x: VAR T

  ldd_mem: LEMMA FORALL l: member(x, ldd(l)) IFF member(x, l)
END qe_ldd_ok
