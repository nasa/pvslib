alg_sign2: THEORY
%----------------------------------------------------------------------------
% The sign of a rational polynomial at an algebraic number, without the sum
% of squares (for speed).
%
% alg_sign decides q(value(a)) = 0 first, with zero_at, which
% counts the roots of p^2 + q^2; that polynomial has twice the degree of the
% larger of the two, and its Sturm chain dominates. A cell walk asks for
% thousands of signs at one algebraic point, so that chain is paid over and
% over. alg_sign2 counts the roots of q alone in the isolating interval
% first: if there are none then q does not vanish at value(a), and q keeps
% one sign on the whole interval (sturm_sign), so the sign is read off q at
% the midpoint by a single rational evaluation, with no sum of squares and
% no Sturm decision. Only when q does have a root in the interval does it
% fall back to alg_sign. alg_sign2_sign is the semantics.
%----------------------------------------------------------------------------
BEGIN
  IMPORTING alg_sign

  a: VAR alg
  ql: VAR Polylist
  x: VAR real

  %% the sign, counting the roots of q alone before anything else
  alg_sign2(a: Alg, ql): Sign3 =
    IF deg(ql) = 0 THEN sign3(nth(ql, 0))
    ELSIF nroots(ql, a`lb, a`ub) = 0 THEN sign3(polylist(ql)(mid(a)))
    ELSE alg_sign(a, ql)
    ENDIF

  mid_in: LEMMA alg?(a) IMPLIES a`lb <= mid(a) AND mid(a) <= a`ub
  %% with no root of q in the isolating interval the sign is the midpoint sign
  free_sign: LEMMA alg?(a) AND deg(ql) > 0 AND nroots(ql, a`lb, a`ub) = 0 AND
    a`lb <= x AND x <= a`ub IMPLIES sign3(polylist(ql)(x)) = sign3(polylist(ql)(mid(a)))

  alg_sign2_sign: THEOREM alg?(a) IMPLIES alg_sign2(a, ql) = sign3(polylist(ql)(value(a)))
END alg_sign2
