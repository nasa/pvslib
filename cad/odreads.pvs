odreads: THEORY
%----------------------------------------------------------------------------
% The executable's read lists contain the trusted walk's (restated
% 2026-09-27 for the truncated effective family).
%
% towern_od reads through the chain table (ird_t).  Its intrinsic reads are
% every coefficient of every member (crd, for the closure) and walk_rd's
% reads on the EFFECTIVE family feff(F, od) -- the members that are not zero
% at the cell, each as the cell sees it -- with the table's chains in place
% of the chains; its entry reads are walk_rd's entry reads on that family.
% With a valid table the table's chains ARE the chains (ird_t_eq), so the
% lists are equal to the walk's (wi_rd_t_eq, we_rd_p_eq), and agreement on
% the executable's lists is agreement on the walk's (wi_agree, we_agree).
%----------------------------------------------------------------------------
BEGIN
  IMPORTING towern_od

  F, G, P: VAR list[list[mpoly]]
  f, g: VAR list[mpoly]
  u: VAR mpoly
  sg, sg1, sg2: VAR SG
  od: VAR OD
  tb: VAR CT
  Y: VAR list[rat]
  k: VAR nat
  R1, R2: VAR list[mpoly]

  %% agreement transports to a sublist
  agree_sub: LEMMA (FORALL u: member(u, R1) IMPLIES member(u, R2)) AND agree(sg1, sg2, R2)
    IMPLIES agree(sg1, sg2, R1)

  %% the table returns the construction reads themselves
  ird_t_eq: LEMMA FORALL tb: valid?(tb) IMPLIES ird_t(k, sg, f, tb) = i_rd(k, sg, f)

  %% the effective family, member by member
  feff_null: LEMMA feff(null[list[mpoly]], od) = null[list[mpoly]]
  feff_cons: LEMMA feff(cons(g, G), od) =
    IF zero_at?(osg(od), strip(g)) THEN feff(G, od) ELSE cons(tz(osg(od), strip(g)), feff(G, od)) ENDIF

  %% ---- intrinsic reads ---------------------------------------------------------------
  mi_rd_t_eq: LEMMA FORALL G: valid?(tb) IMPLIES mi_rd_t(P, od, G, tb) = mi_rd(P, osg(od), G)
  pi_rd_t_eq: LEMMA FORALL G: valid?(tb) IMPLIES pi_rd_t(od, g, G, tb) = pi_rd(osg(od), g, G)
  pairs_rd_t_eq: LEMMA FORALL G: valid?(tb) IMPLIES pairs_rd_t(od, G, tb) = pairs_rd(osg(od), G)
  wi_rd_t_eq: THEOREM valid?(tb) IMPLIES wi_rd_t(F, od, tb) = append(crd(F), wi_rd(feff(F, od), osg(od)))
  wi_agree: THEOREM valid?(tb) AND agree(sg1, sg2, wi_rd_t(F, od, tb))
    IMPLIES agree(sg1, sg2, wi_rd(feff(F, od), osg(od)))
  crd_wi: LEMMA member(u, crd(F)) IMPLIES member(u, wi_rd_t(F, od, tb))

  %% ---- entry reads -------------------------------------------------------------------
  e_rd_t_eq: LEMMA valid?(tb) IMPLIES e_rd_t(k, od, f, Y, tb) = e_rd(k, osg(od), f, Y)
  me_rd_t_eq: LEMMA FORALL G: valid?(tb) IMPLIES me_rd_t(P, od, G, Y, tb) = me_rd(P, osg(od), G, Y)
  pe_rd_t_eq: LEMMA FORALL G: valid?(tb) IMPLIES pe_rd_t(od, g, G, Y, tb) = pe_rd(osg(od), g, G, Y)
  pairse_rd_t_eq: LEMMA FORALL G: valid?(tb) IMPLIES pairse_rd_t(od, G, Y, tb) = pairse_rd(osg(od), G, Y)
  we_rd_p_eq: THEOREM valid?(tb) IMPLIES we_rd_p(P, od, Y, tb) = we_rd(P, osg(od), Y)
  we_agree: THEOREM valid?(tb) AND agree(sg1, sg2, we_rd_t(F, od, Y, tb))
    IMPLIES agree(sg1, sg2, we_rd(feff(F, od), osg(od), Y))
END odreads
