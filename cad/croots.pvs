croots: THEORY
%----------------------------------------------------------------------------
% A complex polynomial is its leading coefficient times linear factors
%
% cfact: a proper polynomial of degree n is a(n) times the product of
% (z - r(i)) over n roots, counted with multiplicity.  It is the fundamental
% theorem of algebra (complex@fundamental_algebra) iterated: each root gives
% a linear factor, the cofactor has the same leading coefficient
% (cpoly_unique's factor_lc), so it is proper again.  This is the form in
% which the size of a polynomial at a point controls the distance to its
% nearest root, which is what root continuity needs.
%----------------------------------------------------------------------------
BEGIN
  IMPORTING cpoly_unique

  a, b: VAR sequence[complex]
  r: VAR [nat -> complex]
  n, i: VAR nat
  z, y: VAR complex

  cprod(r, n)(z): RECURSIVE complex =
    IF n = 0 THEN real_(1) ELSE (z - r(n - 1)) * cprod(r, n - 1)(z) ENDIF
  MEASURE n
  cprod_0: LEMMA cprod(r, 0)(z) = real_(1)
  cprod_succ: LEMMA cprod(r, n + 1)(z) = (z - r(n)) * cprod(r, n)(z)

  %% the product depends on the roots below n only
  cprod_eq: LEMMA FORALL (n: nat): FORALL (r, s: [nat -> complex], z: complex):
    (FORALL (i: nat): i < n IMPLIES r(i) = s(i)) IMPLIES cprod(r, n)(z) = cprod(s, n)(z)

  %% the roots appended by one
  extend(r, n, y)(i): complex = IF i = n THEN y ELSE r(i) ENDIF

  cfact: THEOREM FORALL (n: nat): FORALL (a: sequence[complex]):
    proper_polynomial?(n)(a) IMPLIES
    EXISTS (r: [nat -> complex]): FORALL (z: complex): cpolynomial(a, n)(z) = a(n) * cprod(r, n)(z)
END croots
