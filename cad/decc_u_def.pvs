decc_u_def: THEORY
%----------------------------------------------------------------------------
% The Collins decision with the escalation parameter raised until its
% certificate holds.
% Executable; it always stops because the certificate holds from some u on
% (decc_ok's decc_ev, which gives the measure).
%----------------------------------------------------------------------------
BEGIN
  IMPORTING decc_ok

  u, N: VAR nat
  qs: VAR list[bool]
  F: VAR list[list[mpoly]]
  Psi: VAR [SV -> bool]

  %% some u from which on the certificate holds (not computed)
  ubc(qs, F, Psi): nat =
    epsilon(LAMBDA (N: nat): FORALL u: u >= N IMPLIES decc_o(u, qs, F, Psi)`ok)
  umc(qs, F, Psi, u): nat = IF u < ubc(qs, F, Psi) THEN ubc(qs, F, Psi) - u ELSE 0 ENDIF

  decc_u(qs, F, Psi, u): RECURSIVE [# ok: bool, val: bool #] =
    LET d = decc_o(u, qs, F, Psi) IN
    IF d`ok OR null?(qs) OR null?(cdr(qs)) THEN d ELSE decc_u(qs, F, Psi, u + 1) ENDIF
  MEASURE umc(qs, F, Psi, u)
END decc_u_def
