snorm_arr: THEORY
%----------------------------------------------------------------------------
% Normalizing a coefficient list leaves its array alone.
%
% snorm drops trailing coefficients that vanish at the valuation, so the list
% it selects denotes not only the same polynomial (snorm_eval) but the same
% real coefficient array.  That is what fixes the degree: the selected list
% has a nonzero last coefficient, so its length is exactly one more than the
% top index at which the array is nonzero.  The Tarski chain needs this,
% because Tarski@sturmtarski pins the degree of the second element to
% deg(g) + deg(p) - 1 and the product list may carry trailing zeros.
%----------------------------------------------------------------------------
BEGIN
  IMPORTING mpoly_prod, branch_norm

  l: VAR list[mpoly]
  ys: VAR list[real]
  i, d: VAR nat

  x: VAR real
  lbut_poly: LEMMA cons?(l) AND meval(llast(l))(ys) = 0 IMPLIES
    polynomial(earr(lbut(l), ys), dg(l))(x) = polynomial(earr(l, ys), dg(l))(x)
  earr_lbut_at: LEMMA cons?(l) AND meval(llast(l))(ys) = 0 IMPLIES
    earr(lbut(l), ys)(i) = earr(l, ys)(i)
  earr_lbut: LEMMA cons?(l) AND meval(llast(l))(ys) = 0 IMPLIES earr(lbut(l), ys) = earr(l, ys)
  snorm_earr: THEOREM earr(select(snorm(l), ys), ys) = earr(l, ys)
  snorm_dg_eq: LEMMA cons?(select(snorm(l), ys)) AND earr(l, ys)(d) /= 0 AND
    (FORALL (j: nat): j > d IMPLIES earr(l, ys)(j) = 0)
    IMPLIES dg(select(snorm(l), ys)) = d
END snorm_arr
