col_tower: THEORY
%----------------------------------------------------------------------------
% THE COLLINS TOWER IS A CAD.
%
% For a family F in k + 1 variables, ctw(F, k) = [P_1, ..., P_k] is the tower
% of projections: P_k = F and P_(j-1) = pdown(P_j), the N-reducta projection
% of P_j (cad_projn_def's projn), split into a checked basis (mpoly_cert_def's
% fsplit) and turned back into a family (as_list); pbot(F, k) = P_0 is the
% family of the outermost variable alone.  Unlike a read closure, the tower
% does not depend on where it is used.
%
% ptower_cad: over any connected base set C on which the projection of the
% lowest family is sign-invariant (sinv?), a chained tower (each family is
% the projection of the next, chain?) decomposes the cylinder over C as a CAD
% (cad_tower's cad_over?).  Each level is delineable over each cell below it
% (fam_cinv: one sign for each member of the basis gives one sign for each
% member of the projection, mpoly_cert's fsplit_cinv; then cad_projn's
% projn_ok and col_stack's collins_stack), the stack cells are connected
% (cad_stkc's conn_stk) and the family is sign-invariant on them (stk_sinv),
% which is the hypothesis for the next level.  ctw_cad applies it to ctw(F, k).
%----------------------------------------------------------------------------
BEGIN
  IMPORTING col_tower_def, cad_projn, cad_tower, mpoly_cert

  F, G: VAR list[list[mpoly]]
  TW: VAR Tower
  C: VAR [list[real] -> bool]
  U: VAR list[mpoly]
  u: VAR mpoly
  p, q, p0: VAR list[real]
  k, i, a: VAR nat

  %% each family is the projection of the next
  chain?(TW): RECURSIVE bool =
    IF null?(TW) OR null?(cdr(TW)) THEN TRUE ELSE car(TW) = pdown(car(cdr(TW))) AND chain?(cdr(TW)) ENDIF
  MEASURE length(TW)

  %% a family with one sign vector on a set
  sinv?(G, C): bool = FORALL p, q: C(p) AND C(q) IMPLIES svec(G, p) = svec(G, q)

  %% ---- the tower's shape -------------------------------------------------------------------
  ctw_len: LEMMA FORALL k: FORALL F: length(ctw(F, k)) = k
  chain_app: LEMMA FORALL TW: chain?(TW) AND (cons?(TW) IMPLIES tlast(TW) = pdown(G)) IMPLIES
    chain?(append(TW, (: G :)))
  tlast_app: LEMMA FORALL TW: tlast(append(TW, (: G :))) = G
  car_app: LEMMA cons?(TW) IMPLIES car(append(TW, (: G :))) = car(TW)
  ctw_tlast: LEMMA FORALL k: FORALL F: k >= 1 IMPLIES tlast(ctw(F, k)) = F
  ctw_chain: LEMMA FORALL k: FORALL F: chain?(ctw(F, k))
  ctw_car: LEMMA FORALL k: FORALL F: k >= 1 IMPLIES pdown(car(ctw(F, k))) = pbot(F, k)

  %% ---- sign-invariance passes up the tower ----------------------------------------------------
  famu_cinv: LEMMA sinv?(fam(U), C) IMPLIES FORALL u: member(u, U) IMPLIES cinv?(u, C)
  fam_cinv: LEMMA sinv?(pdown(G), C) IMPLIES FORALL u: member(u, projn(G)) IMPLIES cinv?(u, C)
  ptower_cad: THEOREM FORALL TW: FORALL C: chain?(TW) AND conn?(C) AND (cons?(TW) IMPLIES sinv?(pdown(car(TW)), C))
    IMPLIES cad_over?(TW, C)
  ctw_cad: THEOREM conn?(C) AND (k >= 1 IMPLIES sinv?(pbot(F, k), C)) IMPLIES cad_over?(ctw(F, k), C)
END col_tower
