col_out: THEORY
%----------------------------------------------------------------------------
% The Collins run's CAD as data.  Executable.
%
% cad_out's records for the Collins run: at every sector of the roots of
% the outer family (the projection of the tower's lowest family, as in
% decc_o) the walk over the tower ctw(F, k) lists one record per path of
% kids (cad_out's srecs): the sector, the stack indices, the sample
% descriptor, and F's sign vector read by the descriptor's oracle.
% col_out_ok proves that these are the cells of col_run's CAD.
%----------------------------------------------------------------------------
BEGIN
  IMPORTING decc_def, cad_out

  u: VAR nat
  qs: VAR list[bool]
  F: VAR list[list[mpoly]]

  %% k = number of quantifiers minus one
  cad_outc(u, qs, F): list[ORec] =
    LET k = length(qs) - 1 IN
    IF k < 1 THEN null[ORec]
    ELSE LET TW = ctw(F, k) IN
         olflat(map(LAMBDA (s: Sect): srecs(u, F, s, TW))(sects(rts(cbot(TW)))))
    ENDIF
END col_out
