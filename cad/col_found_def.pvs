col_found_def: THEORY
%----------------------------------------------------------------------------
% The Collins CAD with the search for u built in, in every dimension.
% Executable.
%
% With one variable the CAD is the sectors of the roots of F, and lrecs
% returns one record per sector: its sample (odS) and F's sign vector there,
% read by the sample's sign oracle.  With two or more, cad_outcu raises the
% search-effort parameter from u until decc_o's certificate holds, as decc_u
% does for the decision, and returns that value with cad_outc's records at
% it.  The certificate does not depend on the sentence (psi_c); the search
% stops by decc_u's measure umc.  col_found starts at u = 0.  col_found_ok
% proves that its records are always a CAD adapted to F, one record at
% least for every nonempty cell, and that they decide every sentence over F.
%----------------------------------------------------------------------------
BEGIN
  IMPORTING col_out, decc_u_def

  u: VAR nat
  qs: VAR list[bool]
  F: VAR list[list[mpoly]]
  s: VAR Sect

  psi_c: [SV -> bool] = LAMBDA (v: SV): TRUE

  CFc: TYPE = [# fu: nat, frecs: list[ORec] #]

  %% the line: one record per sector of the roots of F
  lrec(F)(s): ORec = (# rsec := s, radr := null[nat], rsod := odS(s), rsv := osv_of(F, odS(s)) #)
  lrecs(F): list[ORec] = map(lrec(F))(sects(rts(F)))

  cad_outcu(qs, F, u): RECURSIVE CFc =
    IF null?(qs) THEN (# fu := u, frecs := null[ORec] #)
    ELSIF null?(cdr(qs)) THEN (# fu := u, frecs := lrecs(F) #)
    ELSIF decc_o(u, qs, F, psi_c)`ok THEN (# fu := u, frecs := cad_outc(u, qs, F) #)
    ELSE cad_outcu(qs, F, u + 1)
    ENDIF
  MEASURE umc(qs, F, psi_c, u)

  col_found(qs, F): CFc = cad_outcu(qs, F, 0)
END col_found_def
