    (|real| NONEMPTY-TYPE-FROM-DECL NIL |reals| NIL)
    (|convergent?| CONST-DECL "[set[T] -> [[T -> real] -> bool]]"
     |convergence_set| NIL)
    (- CONST-DECL "[[[T -> real], [T -> real]] -> [T -> real]]" |real_fun_ops|
       |reals|))
   SHOSTAK)))

