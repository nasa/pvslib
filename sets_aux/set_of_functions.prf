    (|card| CONST-DECL "[S: finite_set -> {n: nat | n = Card(S)}]"
     |finite_sets| NIL)
    (|nat_exp| APPLICATION-JUDGEMENT "nat" |exponentiation| NIL)
    (|card_bij| FORMULA-DECL NIL |finite_sets| NIL)
    (OR CONST-DECL "[[bool, bool] -> bool]" |booleans| NIL)
    (/= CONST-DECL "[[T, T] -> boolean]" |notequal| NIL)
    (^ CONST-DECL "[[r: real, {i: int | r /= 0 OR i >= 0}] -> real]"
     |exponentiation| NIL)
    (|funset| CONST-DECL
     "[d: [finite_set[T1], finite_set[T2]] -> finite_set[[(d`1) -> (d`2)]]]"
     |set_of_functions| NIL)
    NIL (|injective?| CONST-DECL "[[D -> R] -> bool]" |functions| NIL)
    (|surjective?| CONST-DECL "[[D -> R] -> bool]" |functions| NIL)
    (NOT CONST-DECL "[bool -> bool]" |booleans| NIL)
    (|fullset| CONST-DECL "set" |sets| NIL) NIL NIL NIL NIL
    (|real_lt_is_strict_total_order| NAME-JUDGEMENT
     "(strict_total_order?[real])" |real_props| NIL)
    (|bijective?| CONST-DECL "[[D -> R] -> bool]" |functions| NIL)
    (< CONST-DECL "[[real, real] -> bool]" |reals| NIL)
    (|below| TYPE-EQ-DECL NIL |nat_types| NIL)
    (|finite_funset_bijection2| FORMULA-DECL NIL |set_of_functions| NIL)
    (T2 FORMAL-TYPE-DECL NIL |set_of_functions| NIL))
   SHOSTAK)))

