    (/= CONST-DECL "[[T, T] -> boolean]" |notequal| NIL)
    (|nzreal| NONEMPTY-TYPE-EQ-DECL NIL |reals| NIL)
    (P CONST-DECL "[[nzreal, real, real] -> real]" |vieta| NIL)
