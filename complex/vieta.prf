    (NOT CONST-DECL "[bool -> bool]" |booleans| NIL)
    (|nzcomplex| NONEMPTY-TYPE-EQ-DECL NIL |complex_types| NIL)
    (* CONST-DECL "[[complex, complex] -> complex]" |complex_types| NIL)
    (- CONST-DECL "[[complex, complex] -> complex]" |complex_types| NIL)
    (/ CONST-DECL "[[complex, nzcomplex] -> complex]" |complex_types| NIL)
    (OR CONST-DECL "[[bool, bool] -> bool]" |booleans| NIL)
    (>= CONST-DECL "[[real, real] -> bool]" |reals| NIL)
    (|minus_nzint_is_nzint| APPLICATION-JUDGEMENT "nzint" |integers| NIL)
    (|nzreal_times_nzreal_is_nzreal| APPLICATION-JUDGEMENT "nzreal"
     |real_types| NIL)
    (|real_div_nzreal_is_real| APPLICATION-JUDGEMENT "real" |reals| NIL)
    (|minus_real_is_real| APPLICATION-JUDGEMENT "real" |reals| NIL)
    (TRUE CONST-DECL "bool" |booleans| NIL)
    (|id| CONST-DECL "(bijective?[T, T])" |identity| NIL)
    (|bijective?| CONST-DECL "[[D -> R] -> bool]" |functions| NIL)
    (|bool| NONEMPTY-TYPE-EQ-DECL NIL |booleans| NIL)
    (|boolean| NONEMPTY-TYPE-DECL NIL |booleans| NIL)
    (IFF CONST-DECL "[[bool, bool] -> bool]" |booleans| NIL)
    (^ CONST-DECL "[[r: real, {i: int | r /= 0 OR i >= 0}] -> real]"
     |exponentiation| NIL)
    (|c_quadratic| CONST-DECL "[[nzreal, real, real] -> [complex -> complex]]"
     |complex_quadratic| NIL)
    (- CONST-DECL "[numfield -> numfield]" |number_fields| NIL)
    (^ DEF-DECL "[[complex, nat] -> complex]" |complex_types| NIL)
    (|nat| NONEMPTY-TYPE-EQ-DECL NIL |naturalnumbers| NIL)
    (|int| NONEMPTY-TYPE-EQ-DECL NIL |integers| NIL)
    (|integer_pred| CONST-DECL "[rational -> boolean]" |integers| NIL)
    (|rational| NONEMPTY-TYPE-FROM-DECL NIL |rationals| NIL)
    (|rational_pred| CONST-DECL "[real -> boolean]" |rationals| NIL)
    (IF CONST-DECL
        "[[boolean, T, T] -> T]"
        |if_def|
        NIL)
    (|c_cubic| CONST-DECL
     "[[nzreal, real, real, real] -> [complex -> complex]]" |vieta| NIL)
    (|x_from_t| FORMULA-DECL NIL |vieta| NIL)
    (|depressed| CONST-DECL "[[real, real] -> [complex -> complex]]" |vieta|
     NIL)
    (|complex_ext| FORMULA-DECL NIL |complex_types| NIL)
    (|real_minus_real_is_real| APPLICATION-JUDGEMENT "real" |reals| NIL)
    (|real_times_real_is_real| APPLICATION-JUDGEMENT "real" |reals| NIL)
    (|real_plus_real_is_real| APPLICATION-JUDGEMENT "real" |reals| NIL)
    (|expt_nzcomplex| REC-APPLICATION-JUDGEMENT "nzcomplex" |complex_types|
     NIL)
    (|vieta_iff_quadratic| FORMULA-DECL NIL |vieta| NIL)
    (|depressed_iff_vieta| FORMULA-DECL NIL |vieta| NIL)
    (|w_exists| FORMULA-DECL NIL |vieta| NIL) NIL
    (|cubic_iff_depressed| FORMULA-DECL NIL |vieta| NIL))
   SHOSTAK)))

