    (|int| NONEMPTY-TYPE-EQ-DECL NIL |integers| NIL)
    (>= CONST-DECL "[[real, real] -> bool]" |reals| NIL)
    (|nat| NONEMPTY-TYPE-EQ-DECL NIL |naturalnumbers| NIL)
    (< CONST-DECL "[[real, real] -> bool]" |reals| NIL)
    (|below| TYPE-EQ-DECL NIL |naturalnumbers| NIL)
    (|edges_of_polygon| CONST-DECL
     "[polygon: polygon_2d -> [below(polygon`num_vertices) -> segment_2d]]"
     |polygons_2d| |polygons|)
    (|point_on_polygon_perimeter?| CONST-DECL
     "[polygon_2d -> [point_2d -> bool]]" |polygons_2d| |polygons|)
    (|no_edges_in_outward_wedges?| CONST-DECL
     "[[simple_polygon_2d, simple_polygon_2d] -> bool]" |vertex_wedges| NIL)
    (|in_wedge_or_on_edge| FORMULA-DECL NIL |vertex_wedges| NIL)
    (|point_in_vertex_wedge?| CONST-DECL
     "[[bool, G: ccw_simple_polygon, below(G`num_vertices)] -> [point_2d -> bool]]"
     |vertex_wedges| NIL)
    (|prev_index| CONST-DECL
     "[d: [p: polygon_2d, below(p`num_vertices)] -> below(d`1`num_vertices)]"
     |polygons_2d| |polygons|)
    (|all_wedge_points_inside| FORMULA-DECL NIL |vertex_wedges| NIL)
    (|extend_points_between_edges| FORMULA-DECL NIL |vertex_wedges| NIL)
    (|p1_on_segment| FORMULA-DECL NIL |segments_2d| |line_segments|)
    (TRUE CONST-DECL "bool" |booleans| NIL)
    (|p2_on_segment| FORMULA-DECL NIL |segments_2d| |line_segments|)
    (|next_index| CONST-DECL
     "[d: [p: polygon_2d, below(p`num_vertices)] -> below(d`1`num_vertices)]"
     |polygons_2d| |polygons|)
    (|prev_next_is_original| FORMULA-DECL NIL |polygons_2d| |polygons|)
    (|segment_endpoint?| CONST-DECL "[segment_2d -> [point_2d -> bool]]"
     |segments_2d| |line_segments|)
    (|reverse_segment| CONST-DECL "[segment_2d -> segment_2d]" |segments_2d|
     |line_segments|)
    (|point_on_reverse_segment| FORMULA-DECL NIL |segments_2d| |line_segments|)
    (|perimeter_not_outside| FORMULA-DECL NIL |polygon_membership| |polygons|)
    (|real_le_is_total_order| NAME-JUDGEMENT "(total_order?[real])"
     |real_props| NIL)
    (|only_vertex_intersections?| CONST-DECL
     "[[simple_polygon_2d, H: simple_polygon_2d, (edge_of_polygon?(H))] -> bool]"
     |injection_props| NIL))
   SHOSTAK)))

