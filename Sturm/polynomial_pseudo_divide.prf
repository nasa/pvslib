                                                                                                                                                                  (NAME
                                                                                                                                                                   "AB"
                                                                                                                                                                   "array2list[int](1 + ii + m)
                                                                                                         (LAMBDA (j: nat):
                                                                                                            IF j > 1 + ii + m THEN 0
                                                                                                            ELSIF j < 1 + ii
                                                                                                              THEN h(m)
                                                                                                                   *
                                                                                                                   nth
                                                                                                                   (IF 1 + ii = n - m
                                                                                                                    THEN array2list[int](1 + n)(g)
